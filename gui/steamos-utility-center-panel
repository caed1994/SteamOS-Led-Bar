CARD_INSET = 24 * material.SPACE

# The maximum width of a paragraph in a card. The card has the width
# CONTENT_MAX at its widest, and it has padding on both sides. A paragraph
# that wraps at CONTENT_MAX puts its last words past the edge of the card.
CARD_WRAP = CONTENT_MAX - CARD_INSET

# The size of the window at the start, and its minimum size. A user cannot
# drag it below the minimum.
#
# For the monitors people have: 1920x1080 and 2560x1440. Not for the 1280x800
# display of the machine, where Game Mode runs and this window does not.
#
# The width holds the sidebar, the inner list, a content column and the
# margins. Narrower, and the two lists take space from the settings they
