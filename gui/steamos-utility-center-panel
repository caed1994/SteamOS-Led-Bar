# does not spread them.
CONTROL_COLUMN = 1
COLOUR_COLUMN = 2
SHAPE_COLUMN = 3
# A control with no colour and no shape uses all three columns. It then
# does not make the switch column wider, which moves the colours away from
# their switches. It also does not have to fit into that column.
CONTROL_SPAN = 3
# What separates a switch from the colour that belongs to it. On the colour
# column rather than on the switch, so the tabs that have no such column are
# untouched by it.
LOOK_GAP = 24
# Narrower than a settings menu: these two stand in a row of three controls
# rather than alone, and their entries are short words.
COLOUR_WIDTH = 15
SHAPE_WIDTH = 16
# The branch field, which stands in a row of buttons rather than a column of
# settings. Wide enough for a long branch name without pushing the two update
# buttons off a narrow window.
BRANCH_WIDTH = 22

# The columns of a drive on the System page. Every drive is a row in one grid,
# so the buttons of one drive stand under the buttons of the next. A frame for
# each drive would put each button where its own text ends. The last column
# holds the extra width, which keeps the buttons beside the drive they act on
# and not at the edge of the window.
DRIVE_WHERE = 0
DRIVE_TYPE = 1
DRIVE_STATE = 2
DRIVE_OWN = 3
DRIVE_REMOVE = 4
DRIVE_SPACER = 5

# The square of colour a menu entry carries when what it holds is a colour.
SWATCH_SIZE = 16
SWATCH_GAP = 7              # drawn beside it, where the name goes
_COLOUR = re.compile(r"^#[0-9a-fA-F]{6}$")
DETAILS_GAP = 10            # under the checklist, and part of what it costs

# The space to leave for the titlebar and for the panel of the desktop. The
# maximum height of the window uses this value.
SCREEN_ALLOWANCE = 120

# The maximum width of a message in a dialog before it wraps. It is wide
# enough for a path, and narrow enough to put a sentence on more than one
# line.
DIALOG_WRAP = 460


# Everything else a control measures is worked out from the desktop's own font
# - see material.control_sizes, and the note there on why a fixed size is
# wrong. Sized for fingers and a trackpad rather than a mouse on a desk: this
# runs on a machine people also use handheld.

# The 4dp grid Material spaces everything on, in the amounts this window needs.
# The gap between groups is what replaces the boxes that used to be drawn round
# them, so it is deliberately larger than any gap inside one.
SIDE_MARGIN = 4 * material.SPACE

# How wide the switch column on the CEC page is, so a feature's sentence lines
# up under its own label rather than under the switch.
CEC_INDENT = 9 * material.SPACE

# The same for a status block: its sentence sits under the part's name rather
# than under the light beside it.
PART_INDENT = 6 * material.SPACE
GROUP_GAP = 6 * material.SPACE
ROW_GAP = 2 * material.SPACE
INDENT_STEP = 5 * material.SPACE

# The space that one settings row keeps above and below its control. The
# second value is the extra space of a row that starts a block. That row is
# the switch above an indented pair. Each control has the same height, so that
# extra space is the one sign of the end of one block and the start of the
# next block.
#
# The value is six on each side, so there are twelve pixels between two
# controls. That is the spacing of Material for a list of controls. With four
# pixels, two filled shapes of forty pixels looked like one shape. A switch
# above a drop-down had that fault.
ROW_PAD = 6
BLOCK_GAP = 4 * material.SPACE

# The type scale, as offsets from the font size of the desktop. Material gives
# fifteen sizes. A window of this size needs four of them, and the weights are
# more important than the sizes.
TYPE_HEADLINE = 6
TYPE_SECTION = 0
TYPE_SUPPORT = -1

# The window is dark whatever the desktop is, and only the *accent* follows.
#
# Not a preference. This panel controls a machine on a television in a dark
# room, and a light window around a preview of lit LEDs makes the preview
# weak.
#
# The accent still comes from Plasma and gives the window the identity of the
# machine. See kdetheme. One name in one place, and not a condition in each
# style.
DARK = True


def _decimals(step):
    """How many decimals a step needs: 1 -> 0, 0.5 -> 1, 0.05 -> 2."""
    return len(("%g" % step).partition(".")[2])


def _photo(picture, keep=True):
    """A list of pixel rows as a PhotoImage.

    `keep` parks it in _IMAGES for the window's life, which is what a style
    element needs. A swatch says no and is held by the widget wearing it
    instead: those are drawn again whenever the widget's shade moves, and a
    list that only ever grew would collect one image per hover.
    """
    photo = tk.PhotoImage(width=len(picture[0]), height=len(picture))
    photo.put(roundrect.as_put_string(picture))
    if keep:
        _IMAGES.append(photo)
    return photo


def _slice(radius, fill, background, border=None, width=1):
    """A rounded rectangle sized to be stretched by nine-slice scaling.

    Only the corners of these are ever seen: ttk keeps a square of `radius` at
    each one and stretches what is between them, so one picture serves a button
    of any width.
    """
    return _photo(roundrect.rows(radius * 2 + 4, radius * 2 + 4, radius, fill,
                                 background, border=border,
                                 border_width=width if border else 0))


def dress(style, roles, sizes):
    """Replace the parts ttk draws square and flat with Material ones.

    Best effort throughout: an older Tk that will not take image elements keeps
    the plain look rather than leaving an unpainted window, and each group
    stands on its own so one refusal does not take the rest with it.
    """
    surface = roles["surface"]
    # The colour below the corners of a card. See apply_theme.
    page = roles["_page"]
    # A map from a style name to the colour in the corners of the picture of
    # that style. A nine-slice image keeps its corners at each size, so a
    # widget with such an image must stand on a parent of exactly this
    # colour. On another colour the corners show a box. This map records the
    # colour, and no later step calculates it. The error is not visible in
    # the source and is very visible on the screen, and it occurred four
    # times. See the live test that reads this map.
    grounds = roles["_grounds"] = {}

    def wash(container, content, amount):
        """Returns a state layer: the content colour over its container."""
        return material.blend(roles[container], roles[content], amount)

    def attempt(what, build):
        try:
            build()
        except tk.TclError as exc:                          # pragma: no cover
            print("could not draw %s: %s" % (what, exc), file=sys.stderr)

    def rail():
        """Draws the list at the left, where the user selects a page.

        A filled shape with round ends behind a name marks the open page. It
        has the tone of a raised container and the shape of a button.

        Each picture here stands on the *card* below the list, and not on the
        page. A nine-slice image carries its own corners. A corner over the
        wrong colour gives a pale notch at each end of each entry. The list
        had that fault after the card came below it.
        """
        radius = RAIL_HEIGHT // 2
        ground = surface
        grounds["Rail.TRadiobutton"] = ground

        style.element_create(
            "Material.Rail", "image", _slice(radius, ground, ground),
            ("selected", "active",
             _slice(radius, material.blend(roles["secondary_container"],
                                           roles["on_surface"],
                                           material.STATE_HOVER), ground)),
            ("selected", _slice(radius, roles["secondary_container"], ground)),
            ("active", _slice(radius, material.blend(
                ground, roles["on_surface"], material.STATE_HOVER), ground)),
            border=radius, sticky="nsew", padding=(18, 10))
        style.layout("Rail.TRadiobutton", [
            ("Material.Rail", {"sticky": "nsew", "children": [
                ("Radiobutton.label", {"side": "left", "sticky": "w"})]})])
        # An empty layout removes the tab row of the notebook. The pages stay
        # and the events stay. Only the unused row goes away.
        style.layout("TNotebook.Tab", [])

    def panels():
        """Draws the one raised surface of the window, one tone above the page.

                apply_theme sets its colour with the other colours. Panel._card puts
                four small pictures at its corners. It does not use a nine-slice
                image, and each other element here uses one. Tk scales a nine-slice
                image to the size of the widget at each redraw, and a card is the
                largest element in the window. One card of a thousand pixels cost most
                of one
        wheel notch by itself, which is the stutter people reported. These
        never change size, so nothing is scaled and the same page moved in
        3.6 ms rather than 149.

        Recorded as a ground all the same: those four pictures carry the
        page's colour in them exactly as a nine-slice would, so a card still
        has to stand on the page and the walking test still has to see it.
        """
        grounds["Card.TFrame"] = page

    def buttons():
        def variant(name, fill, over, outline=None, sides=20):
            grounds[name.replace(".Button", ".TButton")] = roles[over]

            def picture(colour, edge=outline):
                return _slice(BUTTON_HEIGHT // 2, colour, roles[over],
                              border=edge)

            style.element_create(
                name, "image", picture(fill),
                # Disabled first: it has to win over hover, or a button you
                # cannot press lights up under the pointer as if you could.
                ("disabled", picture(material.disabled_container(roles),
                                     None)),
                ("pressed", picture(material.blend(fill, roles["on_surface"],
                                                   material.STATE_PRESSED))),
                ("active", picture(material.blend(fill, roles["on_surface"],
                                                  material.STATE_HOVER))),
                # The padding lives on the element, not on the style: an
                # image element's own padding wins, so configuring it later
                # changes nothing at all.
                border=BUTTON_HEIGHT // 2, sticky="nsew", padding=(sides, 8))

        # Material's four weights of button, which is how a row of them says
        # which one you probably want: filled for the action the page is for,
        # tonal for the ones beside it, outlined and text for the rest.
        variant("Filled.Button", roles["primary"], "surface")
        variant("Tonal.Button", roles["secondary_container"], "surface")
        variant("Outlined.Button", surface, "surface", outline=roles["outline"])
        # A text button stands among text and lines up with it; the padding a
        # filled button needs would hang it off to the right of everything.
        variant("Text.Button", surface, "surface", sides=2)
        # And again for a button standing on the page rather than on a card -
        # every weight the page uses, not only the ones whose fill *is* their
        # ground. A nine-slice keeps its own corners whatever the fill is, so
        # a filled button standing on the page had a square of the card's
        # colour behind its pill, which is exactly what it looked like.
        variant("Page.Filled.Button", roles["primary"], "_page")
        variant("Page.Tonal.Button", roles["secondary_container"], "_page")
        variant("Page.Outlined.Button", page, "_page", outline=roles["outline"])
        variant("Page.Text.Button", page, "_page", sides=2)
        for name in ("Filled", "Tonal", "Outlined", "Text",
                     "Page.Filled", "Page.Tonal", "Page.Outlined", "Page.Text"):
            style.layout("%s.TButton" % name, [
                ("%s.Button" % name, {"sticky": "nsew", "children": [
                    ("Button.label", {"side": "top", "sticky": ""})]})])
        grounds["TButton"] = surface        # wears Tonal's picture
        style.layout("TButton", [
            ("Tonal.Button", {"sticky": "nsew", "children": [
                ("Button.label", {"side": "top", "sticky": ""})]})])

    def switches():
        width, height = sizes["switch_width"], sizes["switch_height"]

        def picture(track, edge, thumb, radius, on, tick=None):
            rows = roundrect.rows(width, height, height / 2.0, track, surface,
                                  border=edge, border_width=2 if edge else 0)
            middle = height / 2.0
            across = (width - middle) if on else middle
            roundrect.draw_disc(rows, across, middle - 0.5, radius, thumb)
            if tick:
                roundrect.draw_check(
                    rows, tick, thickness=1.8,
                    box=(across - radius, middle - 0.5 - radius,
                         radius * 2, radius * 2))
            return _photo(rows)

        def off(track, edge, thumb):
            return picture(track, edge, thumb, sizes["thumb_off"], False)

        def on(track, thumb, tick):
            return picture(track, None, thumb, sizes["thumb_on"], True, tick)

        style.element_create(
            "Material.Switch", "image",
            off(roles["surface_container_highest"], roles["outline"],
                roles["outline"]),
            # A greyed-out switch still has to say whether it is on: the
            # setting it governs is off, which is not the same as this one
            # being off.
            ("disabled", "selected",
             on(material.disabled(roles, roles["primary"]),
                material.disabled(roles, roles["on_primary"]),
                material.disabled(roles, roles["primary"]))),
            ("disabled",
             off(material.disabled_container(roles),
                 material.disabled(roles, roles["outline"]),
                 material.disabled(roles, roles["outline"]))),
            ("selected", "active",
             on(material.blend(roles["primary"], roles["on_primary"],
                               material.STATE_HOVER),
                roles["on_primary"], roles["primary"])),
            ("selected", on(roles["primary"], roles["on_primary"],
                            roles["primary"])),
            ("active", off(wash("surface_container_highest", "on_surface",
                                material.STATE_HOVER),
                           roles["outline"], roles["on_surface_variant"])),
            # No padding: the widget is then exactly as tall as the picture,
            # which is what puts a switch and a drop-down on the same height
            # and gives every row in the column the same air around it.
            sticky="", padding=0)
        style.layout("TCheckbutton", [
            ("Checkbutton.padding", {"sticky": "nsew", "children": [
                ("Material.Switch", {"side": "left", "sticky": ""}),
                ("Checkbutton.label", {"side": "left", "sticky": "w"})]})])

    def radios():
        size = sizes["radio"]

        def picture(ring, dot=None, ground=None):
            # Wider than it is tall: the label beside it is a separate element
            # and ttk puts them flush, so the gap has to be part of the
            # picture or the text sits against the ring.
            ground = ground or surface
            rows = [[ground] * (size + RADIO_GAP) for _ in range(size)]
            middle = (size - 1) / 2.0
            roundrect.draw_ring(rows, middle, middle, size / 2.0 - 1.0, 2.0,
                                ring)
            if dot:
                roundrect.draw_disc(rows, middle, middle, size / 4.0, dot)
            return _photo(rows)

        def family(element, layout, ground, hovered):
            """One radio, drawn against one ground.

            There are two, because a radio button paints its own background:
            the indicator picture carries the colour below it, and the label
            carries a -background. A radio built for a card and packed onto a
            page leaves a block of the card colour behind each name.
            """
            style.element_create(
                element, "image",
                picture(roles["on_surface_variant"], ground=ground),
                ("disabled", "selected",
                 picture(material.disabled(roles, roles["primary"]),
                         material.disabled(roles, roles["primary"]), ground)),
                ("disabled", picture(material.disabled(roles,
                                                       roles["on_surface"]),
                                     None, ground)),
                ("selected", picture(roles["primary"], roles["primary"],
                                     ground)),
                ("active", picture(roles["on_surface"], None, hovered)),
                sticky="", padding=2)
            style.layout(layout, [
                ("Radiobutton.padding", {"sticky": "nsew", "children": [
                    (element, {"side": "left", "sticky": ""}),
                    ("Radiobutton.label", {"side": "left", "sticky": "w"})]})])

        family("Material.Radio", "TRadiobutton", surface,
               wash("surface", "on_surface", material.STATE_HOVER))
        family("Material.Radio.Page", "Page.TRadiobutton", page,
               wash("_page", "on_surface", material.STATE_HOVER))

    def sliders():
        # A pill-shaped groove and a round knob.
        thickness, diameter = sizes["track"], sizes["knob"]
        radius = thickness / 2.0

        # Drawn inside an image as tall as the knob: ttk sizes the widget from
        # the trough, so a groove-sized one would crop the larger knob.
        groove = roundrect.pill(thickness * 3, thickness,
                                roles["surface_container_highest"], surface,
                                border_width=0)
        padding = (diameter - thickness) // 2
        rows = [[surface] * (thickness * 3) for _ in range(diameter)]
        rows[padding:padding + thickness] = groove

        def knob(colour):
            return _photo(roundrect.pill(diameter, diameter, colour, surface,
                                         border_width=0))

        # The two names end in "trough" and "slider", because ttk::scale finds
        # them by that suffix. The suffix tells the widget which element to
        # move with the value. With another name the scale still draws, and
        # the knob stays at the left for each value. Each slider on the tab
        # then gives an incorrect value.
        style.element_create("Material.trough", "image", _photo(rows),
                             border=(int(radius), 0, int(radius), 0),
                             sticky="ew", padding=0)
        style.element_create(
            "Material.slider", "image", knob(roles["primary"]),
            ("disabled", knob(material.disabled(roles, roles["primary"]))),
            ("active", knob(material.blend(roles["primary"],
                                           roles["on_surface"],
                                           material.STATE_HOVER))),
            sticky="")
        style.layout("Horizontal.TScale", [
            ("Material.trough", {"sticky": "ew", "children": [
                ("Material.slider", {"side": "left", "sticky": ""})]})])

    def arrows():
        # One mark for each drop-down. This file draws it, and clam does not.
        # The clam mark is a filled triangle with half the height of the
        # field, and it is as old as the 3D edges of clam.
        def picture(colour):
            rows = [[surface] * ARROW_SIZE for _ in range(ARROW_SIZE)]
            roundrect.draw_chevron(rows, colour, thickness=1.9)
            return _photo(rows)

        muted = roles["on_surface_variant"]
        style.element_create(
            "Material.Arrow", "image", picture(muted),
            ("disabled", picture(material.disabled(roles, muted))),
            sticky="")

    def fields():
        # Material's outlined field: a thin edge that thickens and takes the
        # accent when the field has the focus.
        def picture(edge, width=1, fill=None):
            return _slice(FIELD_RADIUS, fill or surface, surface, border=edge,
                          width=width)

        style.element_create(
            "Material.Field", "image", picture(roles["outline"]),
            ("disabled", picture(material.disabled(roles, roles["outline"]),
                                 fill=material.disabled_container(roles))),
            ("focus", picture(roles["primary"], width=2)),
            ("hover", picture(roles["on_surface"])),
            border=FIELD_RADIUS, sticky="nsew")
        # The same field around a typed-in one.
        style.layout("Material.TEntry", [
            ("Material.Field", {"sticky": "nsew", "children": [
                ("Entry.padding", {"sticky": "nsew", "children": [
                    ("Entry.textarea", {"sticky": "nsew"})]})]})])
        # The same field around the button of a drop-down. The button opens a
        # list that this file draws, and not a tk.Menu. See Popup. So the
        # button needs a field with a label and an arrow in it.
        style.layout("Field.TButton", [
            ("Material.Field", {"sticky": "nsew", "children": [
                ("Material.Arrow", {"side": "right", "sticky": ""}),
                ("Button.padding", {"expand": 1, "sticky": "nsew",
                                    "children": [
                                        ("Button.label",
                                         {"sticky": "w"})]})]})])

    def scrollbars():
        """A pill in the page's margin, with nothing else to it.

        The scrollbar of clam keeps a bevelled arrow button, a sunken trough
        and grip lines on the thumb. This code keeps none of that: the trough
        takes the colour of the page, the layout holds no arrow, and the thumb
        is the same round bar as the other elements here.

        Both pictures are drawn against the page, which is what the bar always
        stands on.
        """
        radius = SCROLL_THUMB / 2.0
        side = (SCROLL_WIDTH - SCROLL_THUMB) // 2

        def bar(colour):
            # Tall enough for a corner at each end plus a few rows to stretch,
            # and padded out to the full width so the pill sits centred in a
            # margin rather than against the window's edge.
            pill = roundrect.rows(SCROLL_THUMB, SCROLL_THUMB + 4, radius,
                                  colour, page, border_width=0)
            return _photo([[page] * side + row + [page] * side
                           for row in pill])

        # Nothing to see: it is here because ttk::scrollbar needs a trough to
        # measure the thumb against, and because it is what fixes the width.
        style.element_create(
            "Material.Scroll.trough", "image",
            _photo([[page] * SCROLL_WIDTH]), sticky="ns", border=0, padding=0)
        style.element_create(
            "Material.Scroll.thumb", "image", bar(roles["outline_variant"]),
            # This is hover and not active. The scrollbar bindings of ttk set no
            # state on the part below the pointer, and no code in
            # scrollbar.tcl does that. So Tk never draws an "active"
            # picture here. The widget gets the plain hover state that each
            # ttk widget gets on <Enter>. That state brightens the complete
            # bar and not the thumb alone, which is correct here. A thin bar
            # is easier to find when it answers the pointer.
            ("hover", bar(roles["outline"])),
            border=(0, int(radius) + 1, 0, int(radius) + 1),
            sticky="nsew", padding=0)
        # The element names have to end in "trough" and "thumb": both the
        # widget, which finds the part it has to move by that suffix, and the
        # Tcl bindings, which match *thumb and *trough to tell a drag from a
        # page-jump. Named anything else the bar draws and does nothing.
        style.layout("Vertical.TScrollbar", [
            ("Material.Scroll.trough", {"sticky": "ns", "children": [
                ("Material.Scroll.thumb", {"sticky": "nsew"})]})])
        grounds["Vertical.TScrollbar"] = page

    attempt("the rail", rail)
    attempt("the panels", panels)
    attempt("the buttons", buttons)
    attempt("the switches", switches)
    attempt("the radio buttons", radios)
    attempt("the sliders", sliders)
    attempt("the arrows", arrows)
    attempt("the fields", fields)
    attempt("the scrollbars", scrollbars)


# One ttk theme for each style pass. The name is a count and not the name of
# the look. A session can apply the same look twice, for example dark, light
# and then dark. The second pass then needs a namespace that the first pass
# does not hold.
_THEMES_MADE = itertools.count()
_THEME_NAME = [None]


def _theme_name(fresh=False):
    if fresh or _THEME_NAME[0] is None:
        _THEME_NAME[0] = "material%d" % next(_THEMES_MADE)
    return _THEME_NAME[0]


def wants_dark(mode, desktop):
    """Whether to build a dark scheme, given the setting and the desktop.

    The one place the three answers become two. Dark and light say so; the
    third asks the desktop, which is what this window did before its look was
    rebuilt around a dark one.
    """
    if mode == appsettings.THEME_LIGHT:
        return False
    if mode == appsettings.THEME_SYSTEM:
        return kdetheme.is_dark(desktop)
    return True


def apply_theme(root, mode=appsettings.THEME_DARK):
    """Dress the window in Material 3, seeded from the desktop's accent.

    ttk ships no theme resembling a modern desktop and cannot ask one either,
    so the scheme is worked out and painted on. clam is the base: the only
    built-in theme that honours colour options rather than draw fixed bitmaps.
    Returns the roles, for the parts ttk cannot reach.

    Each call works in a ttk theme of its own, because an element name belongs
    to one theme and cannot be defined twice. A second pass over one theme
    raises "Duplicate element" for each picture in dress(), which reports
    nothing, so the window would keep its old colours in silence.
    """
    desktop = kdetheme.read()
    roles = material.scheme(desktop["selection"],
                            dark=wants_dark(mode, desktop),
                            error=desktop["negative"],
                            positive=desktop["positive"])
    surface = roles["surface"]
    on_surface = roles["on_surface"]
    variant = roles["on_surface_variant"]
    # The surface below the cards. Each widget in this window keeps
    # `surface` as its background. That keeps the pictures of ttk correct,
    # because each picture holds its background in its own corners. The
    # *page* behind the widgets is the tone that is different. The opposite
    # arrangement needs a second copy of each style and a second set of
    # pictures.
    page = roles["_page"] = roles["surface_container"]

    style = ttk.Style()
    try:
        style.theme_create(_theme_name(fresh=True), parent="clam")
        style.theme_use(_theme_name())
    except tk.TclError:                                     # pragma: no cover
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

    family, size = desktop["font"] or ("TkDefaultFont", 10)
    root.option_add("*Font", (family, size))
    style.configure(".", font=(family, size))
    # The measured font gives the height of each control. A switch, a slider
    # and a drop-down then have the same height on each desktop. A column of
    # settings needs that first. Without it, no value for the space between
    # the rows makes the column regular.
    sizes = material.control_sizes(
        tkfont.Font(root, font=(family, size)).metrics("linespace"))

    root.configure(background=page)
    # One background for the complete window. Material separates groups with
    # space and a heading, and not with a box around each group. A page of
    # thirty settings then does not look like thirty compartments. No widget
    # needs the name of the container below it.
    style.configure(".", background=surface, foreground=on_surface,
                    fieldbackground=surface, bordercolor=roles["outline"],
                    focuscolor=roles["primary"],
                    troughcolor=roles["surface_container_highest"],
                    relief="flat", borderwidth=0)
    style.configure("TFrame", background=surface)
    # The few elements that stand on the page and not on a card: the header,
    # the status bar, and the row of buttons below the pages. These are
    # variants with a name, and not a second theme. Each variant sets a
    # background only. Each other property comes from the parent style.
    #
    # Written out one by one rather than looped, like the buttons below: a
    # style name that only ever appears in a variable is a name nothing can
    # check, and a misspelled one is the quietest bug ttk has.
    style.configure("Page.TFrame", background=page)
    style.configure("Page.Muted.TLabel", background=page)
    style.configure("Page.Heading.TLabel", background=page)
    style.configure("Page.Good.TLabel", background=page)
    # A group heading that stands on the page and not on a card. The two
    # columns of effects on the preview page have such headings.
    style.configure("Page.Section.TLabel", background=page)
    style.configure("Page.Bad.TLabel", background=page)
    style.configure("Card.TFrame", background=surface)
    # The same tone, and no corners. This is for a frame that stands *on* a
    # card and is not a card. A card carries its own round corners, and the
    # page is the colour below them. A card inside a card therefore puts
    # four notches of the colour of the page on the card below it. This
    # style sets the colour only, and that keeps the frame flat. See
    # Panel._card for the corners.
    style.configure("OnCard.TFrame", background=surface)
    style.configure("TLabel", background=surface, foreground=on_surface)
    style.configure("Heading.TLabel", font=(family, size + TYPE_HEADLINE))
    # A group's name, in the accent: it is the one place colour is used to
    # organise rather than to decorate, and it lets the boxes go away.
    style.configure("Section.TLabel", foreground=roles["primary"],
                    font=(family, size + TYPE_SECTION, "bold"))
    style.configure("Muted.TLabel", foreground=variant,
                    font=(family, size + TYPE_SUPPORT))
    style.configure("Good.TLabel", foreground=roles["positive"])
    style.configure("Bad.TLabel", foreground=roles["error"])
    style.configure("TSeparator", background=roles["outline_variant"])

    # Material's four weights of button. Written out one by one rather than
    # looped: a style name that only ever appears in a variable is a name
    # nothing can check, and a misspelled one is the quietest bug ttk has -
    # the widget keeps the default look and nothing is reported.
    def button(fill, text, sides=20):
        return dict(background=roles[fill], foreground=roles[text],
                    padding=(sides, 8), anchor="center")

    def label_fades(text):
        # Setting a map replaces clam's own, so without this the label of a
        # disabled button keeps its full colour.
        return dict(foreground=[("disabled",
                                 material.disabled(roles, roles[text]))])

    style.configure("TButton", **button("secondary_container",
                                        "on_secondary_container"))
    style.map("TButton", **label_fades("on_secondary_container"))
    style.configure("Filled.TButton", **button("primary", "on_primary"))
    style.map("Filled.TButton", **label_fades("on_primary"))
    style.configure("Tonal.TButton", **button("secondary_container",
                                              "on_secondary_container"))
    style.map("Tonal.TButton", **label_fades("on_secondary_container"))
    style.configure("Outlined.TButton", **button("surface", "primary"))
    style.configure("Page.Filled.TButton", **button("primary", "on_primary"))
    style.map("Page.Filled.TButton", **label_fades("on_primary"))
    style.configure("Page.Tonal.TButton", **button("secondary_container",
                                                   "on_secondary_container"))
    style.map("Page.Tonal.TButton", **label_fades("on_secondary_container"))
    style.configure("Page.Outlined.TButton", **button("_page", "primary"))
    style.map("Page.Outlined.TButton", **label_fades("primary"))
    style.map("Outlined.TButton", **label_fades("primary"))
    style.configure("Text.TButton", **button("surface", "primary", sides=2))
    style.map("Text.TButton", **label_fades("primary"))
    # The same, on the ground of the page rather than on a card. The foot of
    # the window is page-coloured, and a card-coloured button there draws its
    # own rectangle against it.
    style.configure("Page.Text.TButton", **button("_page", "primary", sides=2))
    style.map("Page.Text.TButton", **label_fades("primary"))

    # On the page. A notebook is the stack that holds the pages. Its own
    # background is visible above and beside the content of the page. Before
    # this style, that background gave a dark band above each card.
    style.configure("TNotebook", background=page, borderwidth=0,
                    bordercolor=page, lightcolor=page,
                    darkcolor=page, tabmargins=(0, 4, 0, 0))
    # On the card below the list, and not on the page. See rail() in dress().
    style.configure("Rail.TRadiobutton", background=surface,
                    foreground=variant, focuscolor=surface, anchor="w")
    style.map("Rail.TRadiobutton",
              background=[("active", surface)],
              foreground=[("selected", roles["on_secondary_container"])])

    # No padding: the layout's padding element would otherwise add four
    # pixels that a drop-down beside it does not have, and the two would stand
    # at different heights in a column meant to be regular.
    style.configure("TCheckbutton", background=surface, foreground=on_surface,
                    focuscolor=surface, padding=0)
    style.map("TCheckbutton", background=[("active", surface)])
    style.configure("TRadiobutton", background=surface, foreground=on_surface,
                    focuscolor=surface, padding=(0, 3))
    style.map("TRadiobutton", background=[("active", surface)])
    # The same radio button on the colour of the page. See the two families
    # in dress(). Without this style, a list of radio buttons on a page
    # draws a block of the colour of the card behind each name.
    style.configure("Page.TRadiobutton", background=page,
                    foreground=on_surface, focuscolor=page, padding=(0, 3))
    style.map("Page.TRadiobutton", background=[("active", page)])

    # No style here applies to a ttk.Combobox, on purpose. The window holds
    # no combobox. Each drop-down is a Field.TButton that opens a Popup of
    # this file. A combobox opens a Tk listbox instead. That listbox cannot
    # hold a colour sample, and it cannot take the look of the other
    # controls. Tk also posts it under a grab, and it then stayed above the
    # windows of other applications.

    # There are no selection colours here. clam fixes the selection colours
    # of an entry, and no configuration changes them. A measurement showed
    # this: style.lookup returns the grey of clam for each value, on the
    # base style and on a derived style. The option database does not reach
    # it either. So no code in this window selects text for the user. A
    # selection from the user keeps the colour that Tk gives it.
    style.configure("Material.TEntry", fieldbackground=surface,
                    foreground=on_surface, insertcolor=on_surface,
                    padding=(10, sizes["field_padding"]))

    style.configure("Field.TButton", background=surface,
                    foreground=on_surface, arrowcolor=variant,
                    padding=(10, sizes["field_padding"]),
                    arrowsize=ARROW_SIZE, anchor="w", compound="left")
    # The background is important on a field with a colour sample, and only
    # there. Tk draws an image on a disabled widget through a stipple of
    # fifty per cent. That stipple is the pattern over a grey colour. This
    # option gives the colour in the holes of the pattern, and
    # Material.Field does not. At the value surface, one half of the pixels
    # below the colour sample kept the normal shade, and the field around
    # them had the grey shade. In a dark theme that gives the box that a
    # user reported.
    style.map("Field.TButton",
              foreground=[("disabled", material.disabled(roles, on_surface))],
              arrowcolor=[("disabled", material.disabled(roles, variant))],
              background=[("disabled", material.disabled_container(roles)),
                          ("active", surface), ("pressed", surface)])

    style.configure("Horizontal.TScale", background=surface,
                    troughcolor=roles["surface_container_highest"])
    # The fallback look, for a Tk that will not take the image elements
    # dress() tries to give the scrollbar: clam's own parts, in this window's
    # colours rather than in clam's greys.
    style.configure("TScrollbar", background=roles["surface_container_highest"],
                    troughcolor=page, bordercolor=page,
                    arrowcolor=variant, relief="flat")

    dress(style, roles, sizes)

    roles["_font"] = (family, size)
    roles["_sizes"] = sizes
    return roles


class Runner:
    """Runs a command without freezing the window.

Only the thread that owns tkinter can call it. So the worker puts its
    lines into a queue, and the window reads that queue on a timer.
    """

    def __init__(self, widget, sink, on_state=None):
        # sink(text, tag=None). The tag is optional, so a simple writer works.
        # on_state(busy, code) gives the text of the window during a command,
        # and the result at the end. It is optional, so a Runner also works
        # without it.
        self.widget = widget
        self.sink = sink
        self.on_state = on_state or (lambda _busy, _code: None)
        self.queue = queue.Queue()
        self.busy = False
        self.transcript = []
        self._job = None
        # The timer outlives the window otherwise: closing it leaves one drain
        # already booked, which then fires at a callback that no longer exists
        # and Tk reports as an invalid command name.
        widget.bind("<Destroy>", self._stop, add="+")
        self._drain()

    def _stop(self, event=None):
        if event is not None and event.widget is not self.widget:
            return                          # a child of ours, not the window
        if self._job is not None:
            self.widget.after_cancel(self._job)
            self._job = None

    def start(self, command, done=None):
        if self.busy:
            self.sink("Still busy with the last command.\n")
            return False
        self.busy = True
        self.transcript = []
        self.on_state(True, None)
        self.sink("$ %s\n" % " ".join(command), "command")
        threading.Thread(target=self._work, args=(command, done),
                         daemon=True).start()
        return True

    def _work(self, command, done):
        try:
            process = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
        except OSError as exc:
            self.queue.put(("line", "cannot run: %s\n" % exc))   # noqa
            self.queue.put(("done", (1, done)))
            return
        for line in process.stdout:
            self.transcript.append(line)
            self.queue.put(("line", line))
        code = process.wait()
        self.queue.put(("done", (code, done)))

    def _drain(self):
        try:
            while True:
                kind, payload = self.queue.get_nowait()
                if kind == "line":
                    self.sink(payload)
                else:
                    code, done = payload
                    self.busy = False
                    self.sink("[exit %d]\n" % code, "command")
                    self.on_state(False, code)
                    # pkexec's own complaint explains nothing to anyone who
                    # has not met it before; say what it means instead.
                    if ledpanel.looks_like_no_auth_agent(
                            "".join(self.transcript), code):
                        self.sink("\n%s\n" % ledpanel.NO_AGENT_ADVICE)
                    self.sink("\n")
                    if done is not None:
                        done(code)
        except queue.Empty:
            pass
        self._job = self.widget.after(120, self._drain)


class Popup:
    """Draws the list of a drop-down. This class draws it, and Tk does not.

    A tk.Menu cannot take the look of the other controls: it marks the current
    entry with an indicator and not with a filled row, and its border is not
    settable.

    It also stays too long. Tk posts it under a grab of its own and gives the
    menu no control of the close step, so it stayed above the window that took
    the focus next.

    So this is a plain Toplevel of this file. It draws the rows and closes
    when the focus leaves it. The note below the constructor gives the reason
    for the missing grab.
    """

    PAD_X = 14
    PAD_Y = 8

    def __init__(self, button, key, roles, choices, variable, swatch, on_close):
        self.roles = roles
        self.variable = variable
        self.on_close = on_close
        self.rows = []

        self.owner = button
        self.key = key
        self.window = window = tk.Toplevel(button)
        window.withdraw()
        window.overrideredirect(True)
        # One pixel of edge, which is the Toplevel below. A window cannot get a
        # border of its own without a frame around each element.
        window.configure(background=roles["outline_variant"])
        inner = tk.Frame(window, background=roles["surface_container"],
                         borderwidth=0, highlightthickness=0)
        inner.pack(padx=1, pady=1, fill="both", expand=True)

        # A colour sample has no alpha channel. This code draws it against a
        # known background, and the sample holds that background in its
        # corners and in the space beside it. A row has three backgrounds:
        # plain, hover and selected. So a row needs three samples. With one
        # sample for the plain shade, the filled row shows a block of the
        # incorrect colour. The rows had that fault.
        self.swatch = swatch
        for label, value in choices:
            row = tk.Label(inner, text=label, compound="left", anchor="w",
                           font=roles["_font"], padx=self.PAD_X,
                           pady=self.PAD_Y, borderwidth=0,
                           highlightthickness=0)
            row.pack(fill="x")
            row.bind("<Enter>", lambda _e, name=label: self._hover(name))
            row.bind("<Leave>", lambda _e: self._hover(None))
            row.bind("<Button-1>", lambda _e, name=label: self._take(name))
            self.rows.append((row, label, value))
        self._paint(None)

        window.bind("<Escape>", lambda _e: self.close())
        # Two ways out that do not need a click. The list takes the focus when
        # it opens, so losing it means it went somewhere else; focus_get()
        # coming back as None means it went out of this application
        # altogether, which is the case where the list was left floating over
        # somebody else's window.
        window.bind("<FocusOut>", lambda _e: self._left())
        self._watching = button.winfo_toplevel()
        self._watching.bind("<FocusOut>", lambda _e: self._left(), add="+")
        self._watching.bind("<Unmap>", lambda _e: self.close(), add="+")
        window.bind("<Up>", lambda _e: self._step(-1))
        window.bind("<Down>", lambda _e: self._step(1))
        window.bind("<Return>", lambda _e: self.close())
        # Under a local grab every click in this application arrives here; one
        # that did not land on a row is a click away, which closes.
        window.bind("<Button-1>", lambda _e: self.close())
        self._place(button)
        window.deiconify()

    # There is no grab, and that is the design and not an error. A
    # measurement under a window manager, with another application above the
    # panel, showed this: with a grab of each type the list stayed on the
    # screen, and without a grab it closed.
    #
    # A grab takes the focus event that reports the change to another
    # application. An override-redirect window gets that event only, and a
    # list with no decoration must be such a window. So this class uses no
    # grab. The panel receives the clicks that the grab received before. See
    # Panel._panel_click.

    def _left(self):
        """Closes the list, if the focus left this application.

        Never asked immediately. A focus event arrives at the start of the
        change, and a question then can land after the old window released the
        focus and before the new one took it. One pass of the idle loop is
        enough.
        """
        self.window.after_idle(self._elsewhere)

    def _elsewhere(self, _event=None):
        try:
            if self.window.focus_get() is None:
                self.close()
        except (tk.TclError, KeyError):                      # pragma: no cover
            self.close()                        # focus is somewhere we cannot see

    def _place(self, button):
        """Puts the list below the field, with its top edge on the field.

        A list that opens *over* the field, with the selected row on it, has a
        different position for each entry and covers the control a person just
        pressed. Below the field, the field stays visible and the position is
        always the same.

        It opens upwards when there is not sufficient space below.
        """
        window = self.window
        window.update_idletasks()
        height = window.winfo_reqheight()
        width = max(button.winfo_width(), window.winfo_reqwidth())

        left = button.winfo_rootx()
        below = button.winfo_rooty() + button.winfo_height()
        if below + height <= window.winfo_screenheight():
            top = below
        else:
            # Above, on the top edge of the field. A list that is longer than
            # the screen does not fit there either. The clamp then puts it as
            # far down as possible.
            top = max(0, min(button.winfo_rooty() - height,
                             window.winfo_screenheight() - height))
        left = max(0, min(left, window.winfo_screenwidth() - width))
        window.geometry("%dx%d+%d+%d" % (width, height, left, top))

    def _paint(self, hovered):
        """Colours each row. The selected row is filled, and the row below the
        pointer is bright.

        This function paints the colour sample again, against the shade of the
        row. See the note at the code that builds the rows.
        """
        for row, label, value in self.rows:
            if label == self.variable.get():
                fill, ink = "secondary_container", "on_secondary_container"
            elif label == hovered:
                fill, ink = "surface_container_high", "on_surface"
            else:
                fill, ink = "surface_container", "on_surface"
            row.configure(background=self.roles[fill],
                          foreground=self.roles[ink],
                          image=self.swatch(value, fill) or "")

    def _hover(self, label):
        self._paint(label)

    def _step(self, by):
        labels = [label for _row, label, _value in self.rows]
        if not labels:
            return
        try:
            at = labels.index(self.variable.get())
        except ValueError:
            at = 0
        self.variable.set(labels[max(0, min(at + by, len(labels) - 1))])
        self._paint(None)

    def _take(self, label):
        self.variable.set(label)
        self.close()

    def close(self):
        for sequence in ("<FocusOut>", "<Unmap>"):
            try:
                self._watching.unbind(sequence)
            except tk.TclError:                             # pragma: no cover
                pass
        try:
            self.window.destroy()
        except tk.TclError:                                 # pragma: no cover
            pass                                            # already gone
        self.on_close()


class Dialog:
    """Shows a message in the style of this window.

    Tk draws its own message boxes, and beside a Material window they look
    very old. A Toplevel needs approximately the same code and takes the
    theme, because ttk styles apply to the whole interpreter.

    Modal, as a question must be: transient to its parent, with a grab, and
    the caller waits and reads the answer as a return value.
    """

    def __init__(self, parent, title, message, confirm=None, deny="Cancel"):
        self.answer = confirm is None
        self.window = window = tk.Toplevel(parent)
        window.withdraw()                       # placed before it is shown
        window.title(title)
        window.transient(parent)
        window.resizable(False, False)
        window.protocol("WM_DELETE_WINDOW", self._deny)
        # A ttk frame fills the window, but a thin part is visible during the
        # layout step. The default grey of Tk is not a colour of this window.
        window.configure(background=ttk.Style().lookup("TFrame", "background"))

        body = ttk.Frame(window, padding=GROUP_GAP)
        body.pack(fill="both", expand=True)
        ttk.Label(body, text=title, style="Heading.TLabel").pack(
            anchor="w", pady=(0, ROW_GAP))
        if message:
            ttk.Label(body, text=message, justify="left",
                      wraplength=DIALOG_WRAP).pack(anchor="w")
        self.build(body)

        buttons = ttk.Frame(body)
        buttons.pack(fill="x", pady=(GROUP_GAP, 0))
        ttk.Button(buttons, text=confirm or "OK", style="Filled.TButton",
                   command=self._confirm).pack(side="right")
        if confirm is not None:
            ttk.Button(buttons, text=deny, style="Text.TButton",
                       command=self._deny).pack(side="right",
                                                padx=(0, ROW_GAP))

        window.bind("<Return>", lambda _event: self._confirm())
        window.bind("<Escape>", lambda _event: self._deny())
        self._centre(parent)
        window.deiconify()
        window.grab_set()
        window.focus_set()
        parent.wait_window(window)

    def build(self, body):
        """What goes between the message and the buttons, if anything."""

    def _centre(self, parent):
        self.window.update_idletasks()
        width = self.window.winfo_reqwidth()
        height = self.window.winfo_reqheight()
        left = parent.winfo_rootx() + (parent.winfo_width() - width) // 2
        top = parent.winfo_rooty() + (parent.winfo_height() - height) // 3
        self.window.geometry("+%d+%d" % (max(0, left), max(0, top)))

    def _confirm(self):
        self.answer = True
        self.window.destroy()

    def _deny(self):
        self.answer = False
        self.window.destroy()


class CountdownDialog(Dialog):
    """Asks the user to keep these settings, or to let LACT reverse them.

    LACT reverses a change after some seconds without a confirmation. That is
    a function: a clock the card cannot hold makes the screen black, and a
    machine that reverses it stays usable. So this dialog asks, and it answers
    "no" itself when nobody answers.
    """

    def __init__(self, parent, seconds):
        self.left = max(1, int(seconds))
        self.job = None
        Dialog.__init__(
            self, parent, "Keep these settings?",
            "The graphics card has been set. If the screen has gone wrong or "
            "nothing is responding, wait - LACT puts the old settings back on "
            "its own.",
            confirm="Keep", deny="Put them back")

    def build(self, body):
        self.left_said = ttk.Label(body, style="Section.TLabel")
        self.left_said.pack(anchor="w", pady=(ROW_GAP, 0))
        self._tick()

    def _tick(self):
        self.left_said.configure(
            text="Putting them back in %d second%s"
                 % (self.left, "" if self.left == 1 else "s"))
        if self.left <= 0:
            # Not confirmed, so the daemon has already done it. Closing with
            # "no" keeps the window's idea of the card and the card itself
            # saying the same thing.
            self._deny()
            return
        self.left -= 1
        self.job = self.window.after(1000, self._tick)

    def _confirm(self):
        self._stop()
        Dialog._confirm(self)

    def _deny(self):
        self._stop()
        Dialog._deny(self)

    def _stop(self):
        if self.job is not None:
            self.window.after_cancel(self.job)
            self.job = None


class ColourDialog(Dialog):
    """Asks for a colour to flash, from a grid or from typed text.

    The chooser of Tk has the worst look of each window that this panel can
    show. It is also the most important one, because this project is about
    colour. The grid offers the colours of the notifications, and those
    colours are correct on this strip. The user types each other colour,
    because the trigger accepts each colour.
    """

    ACROSS = 5

    def __init__(self, parent, dress, title="Flash a colour"):
        self.chosen = None
        # This takes a function that styles a button, and not an image. An
        # outlined button mixes its own fill below the pointer. A colour
        # sample that holds the plain shade then shows a box on the hover
        # shade. A grey field has the same fault and the same correction.
        self.dress = dress
        super().__init__(parent, title, None, confirm="Flash")

    def build(self, body):
        grid = ttk.Frame(body)
        grid.pack(anchor="w")
        for index, (label, value) in enumerate(ledpanel.palette()):
            button = ttk.Button(grid, text=label, compound="left",
                                style="Outlined.TButton",
                                command=lambda hue=value: self._take(hue))
            button.grid(row=index // self.ACROSS, column=index % self.ACROSS,
                        sticky="ew", padx=(0, ROW_GAP), pady=(0, ROW_GAP))
            self.dress(button, value)

        typed = ttk.Frame(body)
        typed.pack(fill="x", pady=(ROW_GAP, 0))
        ttk.Label(typed, text="Or a colour of your own").pack(anchor="w")
        self.entry = ttk.Entry(typed, width=12, style="Material.TEntry")
        self.entry.insert(0, ledpanel.SHAPE_TEST_COLOUR)
        self.entry.pack(anchor="w", pady=(ROW_GAP, 0))

    def _take(self, value):
        """A swatch is the whole answer: pick it and the dialog is done."""
        self.chosen = value
        self._confirm()

    def _confirm(self):
        if self.chosen is None:
            typed = self.entry.get().strip()
            if not _COLOUR.match(typed):
                self.entry.focus_set()
                return                      # not a colour; say nothing, wait
            self.chosen = typed
        super()._confirm()


class ProfileDialog(Dialog):
    """Save or load one of your own profiles, without a file browser.

    Tk's file chooser is Tk's own and not the desktop's, which is exactly what
    it looks like next to this window. A browser is the wrong shape for the
    job as well: profiles live in one directory beside the clone, they are
    named rather than filed, and what anybody wants here is the list of the
    ones they have.
    """

    def __init__(self, parent, directory, roles, saving):
        self.directory = directory
        self.roles = roles
        self.saving = saving
        self.names = ledpanel.profiles(directory)
        self.chosen = None
        super().__init__(
            parent, "Save profile" if saving else "Load profile",
            "Saved beside the clone, in %s." % directory if saving
            else "Loaded into this window; nothing is written until you press "
                 "Apply.",
            confirm="Save" if saving else "Load")

    def build(self, body):
        self.listing = tk.Listbox(
            body, height=min(8, max(3, len(self.names))), activestyle="none",
            borderwidth=0, highlightthickness=0, exportselection=False,
            # This is a tk widget and not a themed widget. It has no style with
            # a colour, so the caller must give it one. Each ttk label in this
            # window already holds the colour below it. See dress().
            background=self.roles["surface_container_low"],
            foreground=self.roles["on_surface"],
            selectbackground=self.roles["secondary_container"],
            selectforeground=self.roles["on_secondary_container"])
        for name in self.names:
            self.listing.insert("end", name)
        self.listing.pack(fill="x", pady=(GROUP_GAP, 0))
        self.listing.bind("<<ListboxSelect>>", self._picked)
        self.listing.bind("<Double-Button-1>", lambda _event: self._confirm())
        if not self.names:
            self.listing.insert("end", " nothing saved yet")
            self.listing.configure(foreground=self.roles["on_surface_variant"],
                                   state="disabled")

        if not self.saving:
            return
        typed = ttk.Frame(body)
        typed.pack(fill="x", pady=(GROUP_GAP, 0))
        ttk.Label(typed, text="Call it").pack(anchor="w")
        self.entry = ttk.Entry(typed, style="Material.TEntry")
        self.entry.pack(fill="x", pady=(ROW_GAP, 0))
        self.entry.focus_set()
        ttk.Label(typed, text="A profile of the same name is replaced.",
                  style="Muted.TLabel").pack(anchor="w", pady=(ROW_GAP, 0))

    def _picked(self, _event=None):
        """Clicking one fills the name in, so overwriting is a click away."""
        picked = self.listing.curselection()
        if picked and self.saving:
            self.entry.delete(0, "end")
            self.entry.insert(0, self.names[picked[0]])

    def _confirm(self):
        if self.saving:
            self.chosen = ledpanel.profile_path(self.directory,
                                                self.entry.get())
            if self.chosen is None:
                self.entry.focus_set()
                return                          # unnamed; say nothing, wait
        else:
            picked = self.listing.curselection()
            if not picked or not self.names:
                return                          # nothing chosen yet
            self.chosen = ledpanel.profile_path(self.directory,
                                                self.names[picked[0]])
        super()._confirm()


class SidebarEntry:
    """One section in the list down the left edge.

    A canvas rather than the ttk.Radiobutton of the inner rail. A ttk widget
    has one -font option, and this entry needs two: a title, and below it a
    smaller and weaker line that gives the subject of the section.

    Each text item on a canvas takes its own font and fill, so the whole entry
    is four items on one surface. A canvas has no ttk states, so this class
    binds hover and selection itself.
    """

    def __init__(self, parent, roles, fonts, entry, on_pick,
                 width=SIDEBAR_WIDTH):
        self.roles = roles
        self.key, title, subtitle, icon = entry
        self.on_pick = on_pick
        self.selected = False
        self.hovering = False
        self.width = width

        self.canvas = tk.Canvas(
            parent, width=width, height=SIDEBAR_ENTRY_HEIGHT,
            highlightthickness=0, borderwidth=0, background=roles["_page"])
        # The pill behind it, in each of the three shades it takes. Drawn once
        # apiece and swapped, rather than redrawn on every pointer crossing:
        # building one is a rounded rectangle the size of the entry, and the
        # sidebar would otherwise do that work every time the pointer travels
        # down the list.
        self._grounds = {
            state: _photo(roundrect.rows(
                width, SIDEBAR_ENTRY_HEIGHT, SIDEBAR_RADIUS,
                colour, roles["_page"]))
            for state, colour in (
                ("rest", roles["_page"]),
                ("hover", material.blend(roles["_page"],
                                         roles["on_surface"],
                                         material.STATE_HOVER)),
                ("selected", roles["secondary_container"]))}
        self.ground = self.canvas.create_image(0, 0, anchor="nw",
                                               image=self._grounds["rest"])
        self._draw_icon(icon)
        self.title = self.canvas.create_text(
            SIDEBAR_TEXT_X, SIDEBAR_ENTRY_HEIGHT // 2 - 9, anchor="w",
            text=title, font=fonts["title"], fill=roles["on_surface"])
        self.subtitle = self.canvas.create_text(
            SIDEBAR_TEXT_X, SIDEBAR_ENTRY_HEIGHT // 2 + 10, anchor="w",
            text=subtitle, font=fonts["subtitle"],
            fill=roles["on_surface_variant"])

        self.canvas.bind("<Button-1>", lambda _event: self.on_pick(self.key))
        self.canvas.bind("<Enter>", lambda _event: self._hover(True))
        self.canvas.bind("<Leave>", lambda _event: self._hover(False))

    def _draw_icon(self, name):
        """Draws a small symbol from simple shapes.

        There are four shapes and one letter, and none of them is a font
        glyph. The symbols for these subjects are a lightning bolt and a
        television, and they are in emoji fonts. A machine can have no such
        font. An absent glyph gives an empty box beside each entry.
        """
        left, middle = SIDEBAR_ICON_X, SIDEBAR_ENTRY_HEIGHT // 2
        colour = self.roles["on_surface_variant"]
        # (item, the option that holds its colour). This code records the
        # option at the draw step and does not read it later. A canvas line
        # has no -outline option. itemcget raises an error for an absent
        # option and does not return an empty value. A test for the option
        # is therefore a Tcl error and not a safe call.
        self.icon = []

        def solid(item):
            self.icon.append((item, "fill"))

        def drawn(item):
            self.icon.append((item, "outline"))

        if name == "strip":                     # the bar itself: four LEDs
            for step in range(4):
                spot = left + step * 6
                solid(self.canvas.create_oval(spot, middle - 2, spot + 4,
                                              middle + 2, outline="",
                                              fill=colour))
        elif name == "bolt":                    # power
            solid(self.canvas.create_polygon(
                left + 11, middle - 9, left + 3, middle + 1, left + 8,
                middle + 1, left + 6, middle + 9, left + 15, middle - 2,
                left + 10, middle - 2, outline="", fill=colour))
        elif name == "screen":                  # a television
            drawn(self.canvas.create_rectangle(left, middle - 7, left + 18,
                                               middle + 4, outline=colour,
                                               width=1.6))
            solid(self.canvas.create_line(left + 5, middle + 8, left + 13,
                                          middle + 8, fill=colour, width=1.6))
            solid(self.canvas.create_line(left + 9, middle + 4, left + 9,
                                          middle + 8, fill=colour, width=1.6))
        elif name == "keys":                    # a keyboard
            drawn(self.canvas.create_rectangle(left, middle - 6, left + 18,
                                               middle + 6, outline=colour,
                                               width=1.6))
            for step in range(3):
                spot = left + 4 + step * 5
                solid(self.canvas.create_line(spot, middle - 2, spot + 2,
                                              middle - 2, fill=colour,
                                              width=1.6))
            solid(self.canvas.create_line(left + 5, middle + 3, left + 13,
                                          middle + 3, fill=colour, width=1.6))
        elif name == "sliders":                 # this window's own settings
            for step, across in enumerate((5, 11)):
                spot = middle - 5 + step * 10
                solid(self.canvas.create_line(left, spot, left + 18, spot,
                                              fill=colour, width=1.6))
                drawn(self.canvas.create_oval(left + across - 3, spot - 3,
                                              left + across + 3, spot + 3,
                                              outline=colour, width=1.6,
                                              fill=self.roles["_page"]))
        elif name == "wrench":                  # putting it right
            solid(self.canvas.create_line(left + 2, middle + 8, left + 11,
                                          middle - 1, fill=colour, width=3))
            drawn(self.canvas.create_oval(left + 8, middle - 9, left + 17,
                                          middle, outline=colour, width=2))
        else:                                   # about
            drawn(self.canvas.create_oval(left, middle - 9, left + 18,
                                          middle + 9, outline=colour,
                                          width=1.6))
            solid(self.canvas.create_line(left + 9, middle - 5, left + 9,
                                          middle - 4, fill=colour, width=2))
            solid(self.canvas.create_line(left + 9, middle - 1, left + 9,
                                          middle + 5, fill=colour, width=1.6))

    def pack(self, **options):
        self.canvas.pack(**options)
        return self

    def _hover(self, over):
        self.hovering = over
        self._repaint()

    def set_selected(self, selected):
        self.selected = selected
        self._repaint()

    def _repaint(self):
        """The pill, and the two texts that have to stay legible on it."""
        state = ("selected" if self.selected
                 else "hover" if self.hovering else "rest")
        self.canvas.itemconfigure(self.ground, image=self._grounds[state])
        # On the filled shape the text takes the colour of that container.
        # That colour is not the colour of the page. A selected entry with
        # the foreground of the page is not readable.
        lit = self.selected
        title = self.roles["on_secondary_container" if lit else "on_surface"]
        rest = self.roles["on_secondary_container" if lit
                          else "on_surface_variant"]
        self.canvas.itemconfigure(self.title, fill=title)
        self.canvas.itemconfigure(self.subtitle, fill=rest)
        for item, option in self.icon:
            self.canvas.itemconfigure(item, **{option: rest})


class FanCurve:
    """Shows the fan curve as a graph that the user can drag.

    Temperature across, fan speed up. A point drags in both directions and
    cannot pass its neighbours, so the curve is a function of the temperature:
    LACT stores it as a map with the degrees as the key.

    A canvas, because ttk has no graph. The alternative is a column of
    numbers, which answers "what is the speed at 60 degrees" and never "what
    is the shape of this curve".
    """

    LOW, HIGH = 20, 100                 # the degrees the graph spans
    # Room for the labels round the plot. Measured rather than guessed: 26 cut
    # the leading digit off "100%", which reads as a graph that starts at 0.
    PAD = 40
    GRAB = 9                            # how near a point you have to press
    HEIGHT = 200

    def __init__(self, parent, roles, curve, on_change=None):
        self.roles = roles
        self.on_change = on_change or (lambda: None)
        self.curve = dict(curve)
        self.held = None
        self.canvas = tk.Canvas(parent, height=self.HEIGHT,
                                highlightthickness=0, borderwidth=0,
                                background=roles["surface_container_lowest"])
        self.canvas.bind("<Configure>", lambda _event: self.draw())
        self.canvas.bind("<Button-1>", self._press)
        self.canvas.bind("<B1-Motion>", self._drag)
        self.canvas.bind("<ButtonRelease-1>", self._release)

    # -- where a point sits on screen, and the way back ---------------------

    def _plot(self):
        width = max(self.canvas.winfo_width(), 2 * self.PAD + 40)
        return (self.PAD, self.PAD // 2,
                width - self.PAD // 2, self.HEIGHT - self.PAD)

    def _at(self, degrees, fraction):
        left, top, right, bottom = self._plot()
        across = (degrees - self.LOW) / float(self.HIGH - self.LOW)
        return (left + across * (right - left),
                bottom - fraction * (bottom - top))

    def _from(self, x, y):
        left, top, right, bottom = self._plot()
        degrees = self.LOW + (x - left) / float(right - left) * (
            self.HIGH - self.LOW)
        fraction = (bottom - y) / float(bottom - top)
        return (int(round(max(self.LOW, min(self.HIGH, degrees)))),
                max(0.0, min(1.0, fraction)))

    # -- drawing ------------------------------------------------------------

    def draw(self):
        canvas = self.canvas
        canvas.delete("all")
        left, top, right, bottom = self._plot()
        grid = self.roles["outline_variant"]
        # Gridlines and their labels, so the shape can be read rather than
        # only felt: a curve with no scale is a picture of a curve.
        for fraction in (0.0, 0.25, 0.5, 0.75, 1.0):
            y = bottom - fraction * (bottom - top)
            canvas.create_line(left, y, right, y, fill=grid, width=1)
            canvas.create_text(left - 6, y, text="%d%%" % (fraction * 100),
                               anchor="e", fill=self.roles["on_surface_variant"],
                               font=("TkDefaultFont", 7))
        for degrees in range(self.LOW, self.HIGH + 1, 20):
            x, _ = self._at(degrees, 0)
            canvas.create_line(x, top, x, bottom, fill=grid, width=1)
            canvas.create_text(x, bottom + 10, text="%d°" % degrees,
                               fill=self.roles["on_surface_variant"],
                               font=("TkDefaultFont", 7))

        points = sorted(self.curve.items())
        if not points:
            return
        line = []
        for degrees, fraction in points:
            line.extend(self._at(degrees, fraction))
        if len(line) >= 4:
            canvas.create_line(*line, fill=self.roles["primary"], width=2,
                               smooth=False)
        for index, (degrees, fraction) in enumerate(points):
            x, y = self._at(degrees, fraction)
            held = self.held == index
            canvas.create_oval(x - 5, y - 5, x + 5, y + 5, width=0,
                               fill=self.roles["on_primary"] if held
                               else self.roles["primary"])
            if held:
                canvas.create_text(
                    x, y - 14, text="%d° %d%%" % (degrees, fraction * 100),
                    fill=self.roles["on_surface"],
                    font=("TkDefaultFont", 8))

    # -- taking hold of it --------------------------------------------------

    def _nearest(self, x, y):
        for index, (degrees, fraction) in enumerate(sorted(self.curve.items())):
            at_x, at_y = self._at(degrees, fraction)
            if abs(at_x - x) <= self.GRAB and abs(at_y - y) <= self.GRAB:
                return index
        return None

    def _press(self, event):
        self.held = self._nearest(event.x, event.y)
        self.draw()

    def _drag(self, event):
        if self.held is None:
            return
        points = sorted(self.curve.items())
        degrees, fraction = self._from(event.x, event.y)
        # The point stays between its neighbours and never passes them. LACT
        # uses the temperature as the key of the curve. A point that passes
        # its neighbour does not change position with it. The two points then
        # have the same key, and one of the two goes away.
        low = points[self.held - 1][0] + 1 if self.held > 0 else self.LOW
        high = (points[self.held + 1][0] - 1
                if self.held + 1 < len(points) else self.HIGH)
        degrees = max(low, min(high, degrees))
        self.curve = dict(points[:self.held] + [(degrees, fraction)]
                          + points[self.held + 1:])
        self.draw()

    def _release(self, _event):
        if self.held is not None:
            self.held = None
            self.draw()
            self.on_change()

    # -- adding and taking away ---------------------------------------------

    def add(self):
        """A point in the widest gap, which is where one is wanted."""
        points = sorted(self.curve)
        if len(points) < 2:
            self.curve[(self.LOW + self.HIGH) // 2] = 0.5
        else:
            widest = max(zip(points, points[1:]),
                         key=lambda pair: pair[1] - pair[0])
            if widest[1] - widest[0] < 2:
                return                  # no room between any two of them
            middle = (widest[0] + widest[1]) // 2
            self.curve[middle] = (self.curve[widest[0]]
                                  + self.curve[widest[1]]) / 2
        self.draw()
        self.on_change()

    def remove(self):
        """Removes the last point, but keeps a curve of two points.

        Two points are the minimum for a curve, and LACT needs a curve and not
        a point. So this function stops at two points. It does not let the
        graph become a shape that the daemon cannot accept.
        """
        if len(self.curve) <= 2:
            return
        self.curve.pop(max(self.curve))
        self.draw()
        self.on_change()


class Panel:
    def __init__(self, root):
        self.root = root
        root.title("SteamOS Utility Center")
        # The width holds the sidebar, the inner list and a settings row at
        # the full width. The user does not have to make the window larger
        # first. The old value of 820 needed that after the second list came
        # to the left edge. The height is a minimum only. _refit gives the
        # window the height that the open page needs.
        root.minsize(MIN_WIDTH, MIN_HEIGHT)
        root.geometry("%dx%d" % (START_WIDTH, START_HEIGHT))
        self._set_window_icon()

        # Read before anything is drawn, because it decides how it is drawn.
        # Its own file and its own reader: this one is about the window.
        self.app = appsettings.read()
        self.roles = apply_theme(root, self.app[appsettings.THEME])
        self.config = self._load_config()
        # The machine's own settings, kept beside the service's rather than
        # merged into them: they come from different files, they are written
        # back by different means, and only one of the two restarts anything.
        self.system = syssettings.read()
        # And the CPU's, which live in /etc like the service's own and are
        # written the same way: through a short helper under pkexec.
        self.power = self._load_power()
        self.vars = {}
        # key -> the (label, value) pairs and the widget, so a value that
        # turns up later can be added to both.
        self._menus = {}
        self._widgets = {}
        # The drives of the System page, from the record under /var. Read once
        # and kept, because each change writes the whole list back.
        self._drives = mounts.read()
        self._partitions = []
        # key -> the variable its drop-down writes
        self._menu_parts = {}
        # The one drop-down standing open, if any
        self._popup = None
        # What the last update check found; see _say_update
        self._update_state = ledpanel.UPDATE_UNKNOWN
        self.update_button = None
        # key -> (labels, controls), so a setting can be greyed out whole
        self._rows = {}
        # key -> (grid, row, minsize, widgets), for a row that is taken away
        # rather than greyed. Apart from _rows because everything else reads
        # that as a pair, and because only some rows ever need this.
        self._row_places = {}
        # page -> the canvas that scrolls it, for the wheel to find
        self._scrollers = {}
        # What is booked with after(), so it can be dropped when the window is
        self._preview_job = None
        self._refit_job = None
        # The update step that a moved control schedules. See
        # _settings_changed.
        self._catching_up = None
        # The texts that must use the current width of the window
        self._wrapped = []
        # The width that one of them loses against the page, by widget name.
        # An indented label below a switch has that much less space than a
        # label at the edge of the card. _rewrap gives the same width to each
        # label. Without this map, the indented labels used a width that they
        # do not have. A label that is wider than its space is not wrapped.
        # The card cuts it.
        self._wrap_insets = {}
        self._wrap_width = 0
        # The same value, for each notebook. See _page_width.
        self._wrap_widths = {}
        # The four pictures of the corners of each card. See _card.
        self._corners = None
        # The rows of buttons, and the current number of columns of each row.
        # See _relay_buttons.
        self._button_rows = []
        self._button_across = {}
        # module name -> (the offer to install it, the page it is installed
        # for). One of the two is packed, and the machine decides which. See
        # _show_module.
        self._module_halves = {}
        # Which modules this machine has, read one time and not on each
        # question. _has_settings asks at every change of the open page, and
        # a stat call there would be a stat call in a loop.
        self._modules_here = frozenset()
        self._read_modules()

        # The header gives the open *section* and not the name of the
        # program. The title bar gives the name. A second copy of the name in
        # the window uses the one line that can give the position of the user.
        # Two levels, outer first: the sidebar picks a section, and what a
        # section holds is its own business. Only the LED strip has an inner
        # list of pages; the rest are one page each.
        outer = ttk.Frame(root, style="Page.TFrame")
        self.sidebar = ttk.Frame(outer, style="Page.TFrame")
        self.sidebar.pack(side="left", fill="y",
                          padx=(SIDE_MARGIN, GROUP_GAP), pady=GROUP_GAP)
        main = ttk.Frame(outer, style="Page.TFrame")
        main.pack(side="left", fill="both", expand=True)

        # The header is a child of `main` rather than of the window packed
        # into it with in_. That form works until stacking order matters, and
        # here it did not: the header is drawn behind the section under it and
        # the window simply came up with no title on it at all.
        header = self.header = ttk.Frame(main, style="Page.TFrame")
        header.pack(fill="x", pady=(GROUP_GAP, GROUP_GAP // 2))
        self.section_title = ttk.Label(header, text="",
                                       style="Page.Heading.TLabel")
        self.section_title.pack(anchor="w")
        self.headline = ttk.Label(header, text="",
                                  style="Page.Muted.TLabel",
                                  justify="left", wraplength=CONTENT_MAX)
        self.headline.pack(anchor="w", pady=(2, 0))
        # This wraps, as each other sentence does. A label does not wrap. On
        # one line this text is the longest element in the window. A toplevel
        # asks for the width of its widest child, so the repair summary alone
        # gave the window its width at the start.
        self._wrapped.append(self.headline)

        self.sections = ttk.Notebook(main)

        # The foot takes its space before the pages, because pack gives out
        # space in the order of the calls and a short window then left nothing
        # for a row that does not scroll.
        #
        # The Apply row is below the sections and not in one of them: one
        # button applies each setting in the window. See apply_settings.
        self.runner = Runner(root, self._write, self._set_busy)
        self._build_apply(root)
        self.sections.pack(fill="both", expand=True)
        outer.pack(fill="both", expand=True,
                   padx=SIDE_MARGIN // 2, pady=(0, 0))

        # With the rail the pages have no tab row of their own: the list down
        # the left side is what picks them, and the notebook is only the stack
        # of pages underneath.
        # The LED bar is a module, so this section is two pages in one frame
        # and the machine decides which one is packed. The other three sections
        # reach the same shape through _module_page. This one is written out,
        # because its content is not a builder that returns a widget: it is a
        # rail and a notebook that the code below fills in place.
        strip_outer = ttk.Frame(self.sections, style="Page.TFrame")
        strip_present = ttk.Frame(strip_outer, style="Page.TFrame")
        self._build_module_line(strip_present, "led")
        strip = ttk.Frame(strip_present, style="Page.TFrame")
        strip.pack(fill="both", expand=True)
        # The inner list sits on a raised card, which is the one place in the
        # window that needs a box round it: it is a list of pages standing
        # beside the page it chose, and with both on the same ground the two
        # read as one column of things you can click.
        rail_card = self._card(strip)
        rail_card.pack(side="left", fill="y", padx=(0, GROUP_GAP),
                       pady=(0, GROUP_GAP))
        self.rail = ttk.Frame(rail_card, style="OnCard.TFrame")
        self.rail.pack(fill="y", expand=True, padx=ROW_GAP, pady=ROW_GAP)
        notebook = self.notebook = ttk.Notebook(strip)
        notebook.pack(side="left", fill="both", expand=True)

        # The tabs with an Apply row, by widget and not by position. A new
        # order of the tabs must not change this set.
        self._settings_tabs = set()
        for entry in SETTINGS_TABS:
            title, table = entry[0], entry[1]
            note = entry[2] if len(entry) > 2 else None
            tab = self._page(notebook,
                             lambda where, t=table, n=note:
                             self._build_settings(where, t, n))
            notebook.add(tab, text=title)
            self._settings_tabs.add(str(tab))
        self.preview_tab = self._page(notebook, self._build_preview)
        notebook.add(self.preview_tab, text="Preview")
        notebook.add(self._page(notebook, self._build_tests), text="Test")
        self._build_rail()
        self._module_halves["led"] = (
            self._build_module_offer(strip_outer, "led"), strip_present)
        self._show_module("led")

        # And the sections themselves, in the order the sidebar lists them.
        self._section_pages = {}
        # Built in the order the sidebar lists them, and from the same table,
        # so a section added to SECTIONS and to neither of the two below is
        # caught here rather than showing an empty page.
        self._section_pages["strip"] = None      # placed by _add_section
        self._add_section("strip", strip_outer)
        for key, _title, _subtitle, _icon in SECTIONS:
            if key == "strip":
                continue
            if key in SECTION_SETTINGS:
                table, note = SECTION_SETTINGS[key]
                build = {"app": self._build_app,
                         "power": self._build_power,
                         "keyboard": self._build_system}.get(
                             key, self._build_settings)
                if key == "power":
                    # Every setting on this page is written by the power
                    # module's applier, so the whole page is behind the offer
                    # to install it. The System page is not: its keyboard half
                    # is the core and works with no module. See _build_system.
                    page = self._page(
                        self.sections,
                        lambda where, b=build, t=table, n=note:
                        self._module_page(where, "power",
                                          lambda holder: b(holder, t, n)))
                else:
                    page = self._page(self.sections,
                                      lambda where, b=build, t=table, n=note:
                                      b(where, t, n))
            elif key == "cec":
                page = self._page(self.sections, self._build_cec)
            elif key in SOON:
                page = self._page(self.sections,
                                  lambda where, k=key: self._build_soon(where,
                                                                        k))
            elif key == "status":
                page = self.status_tab = self._page(self.sections,
                                                    self._build_status)
            else:                                            # pragma: no cover
                raise AssertionError("no page for the %s section" % key)
            self._add_section(key, page)
        self._add_section("about", self._page(self.sections,
                                              self._build_about))
        self._build_sidebar()
        self._catch_up()                # now: the window is about to be shown

        # Closing goes through here so what is booked is dropped first. The
        # <Destroy> binding is the backstop; by the time it runs, some of the
        # widgets holding those bookings have already gone.
        root.protocol("WM_DELETE_WINDOW", self._close)
        # Minimising or hiding the window leaves a posted menu on screen too.
        root.bind("<Unmap>", self._dismiss_menus, add="+")
        root.bind("<Button-1>", self._panel_click, add="+")

        for wheel in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            root.bind_all(wheel, self._wheel)

        notebook.bind("<<NotebookTabChanged>>", self._tab_changed)
        self._tab_changed()
        notebook.bind("<Configure>", self._rewrap)
        self.sections.bind("<Configure>", self._rewrap)

        if ledpanel.in_game_mode():
            self._write(
                "Running in Game Mode. Flashing the bar and the Steam checks "
                "work here;\nchanging settings, the self-test and repairing "
                "need administrator rights,\nwhich only Desktop Mode can ask "
                "for.\n\n")

        self._register_buttons()
        self.refresh_status()
        self._cec_first = None
        if cec.installed():
            self._cec_first = self.root.after(CEC_FIRST_LOOK,
                                              self._reread_cec)
        # The card, for the same reason and at the same distance. It was read
        # when somebody opened the CPU and GPU page and at no other time, so
        # the status page said "LACT is not running" to a person whose card
        # was under LACT's control.
        self._gpu_first = None
        if lact.available():
            self._gpu_first = self.root.after(CEC_FIRST_LOOK,
                                              self._first_look_gpu)
        # Open at the height the content needs, so the first thing anyone does
        # is not what resizes the window.
        self._fit_window()

    def _page(self, notebook, build):
        """Builds one page of the notebook. It scrolls in a short window.

        A page is as long as its settings, and a window is at most as tall as
        the screen. Without this, the foot of the longest page is out of reach
        on a small screen.

        The scrollbar comes when the content is longer than the space and goes
        away when it fits, so a tall screen looks the same as before.
        """
        holder = ttk.Frame(notebook, style="Page.TFrame")
        canvas = tk.Canvas(holder, highlightthickness=0, borderwidth=0,
                           background=self.roles["_page"])
        bar = ttk.Scrollbar(holder, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=bar.set)
        canvas.pack(side="left", fill="both", expand=True)

        inner = ttk.Frame(canvas, style="Page.TFrame")
        window = canvas.create_window(0, 0, window=inner, anchor="nw")
        build(inner).pack(fill="both", expand=True)

        def fit(_event=None):
            wanted = inner.winfo_reqheight()
            across = inner.winfo_reqwidth()
            # Capped, so a wide monitor gets air down the right rather than a
            # slider two thousand pixels long. A settings column is read like
            # a column: past a certain width the label and the control it
            # belongs to are far enough apart to have to be traced by eye.
            width = min(canvas.winfo_width(), CONTENT_MAX)
            room = canvas.winfo_height()
            # At least the available space. A page with an element that
            # expands, such as the preview stage, then fills the window.
            height = max(wanted, room)
            canvas.itemconfigure(window, width=width, height=height)
            canvas.configure(scrollregion=(0, 0, width, height))
            # A request for the size of the content keeps the start size of the
            # window at the size of the page. The limit in _refit decides the
            # height. The width is as important. A canvas does not pass on the
            # size of its content, and it asks for its own default. Without this
            # code, the window opened at the default width of a canvas and put
            # each page into it. Set the size only after a change: each call
            # starts this handler again, and the two then repeat.
            if (canvas.winfo_reqheight() != wanted
                    or canvas.winfo_reqwidth() != across):
                canvas.configure(height=wanted, width=across)
            if (wanted > room) != bool(bar.winfo_ismapped()):
                if wanted > room:
                    # The value before= is the canvas, so the bar gets its width
                    # first. pack gives out the space in the order of the calls,
                    # and the canvas asks for the width of its content. After the
                    # canvas, no space was available. Tk placed the bar and gave
                    # it a size, and it never showed the bar. The page then
                    # scrolled with the wheel and showed no bar.
                    bar.pack(side="right", fill="y", before=canvas)
                else:
                    bar.pack_forget()
                    canvas.yview_moveto(0)

        inner.bind("<Configure>", fit)
        canvas.bind("<Configure>", fit)
        self._scrollers[str(holder)] = canvas
        return holder

    def _wheel(self, event):
        """Turn the wheel into a scroll of whichever page is open.

        Bound to everything rather than to the canvas: an event goes to the
        widget under the pointer and then up its bindtags, not up its parents,
        so a wheel over a label in the middle of the page would never reach the
        canvas underneath it.
        """
        self._dismiss_menus()                   # a list is not scrolled past
        canvas = self._scrollers.get(self._open_page())
        if canvas is None or not canvas.winfo_ismapped():
            return
        down = getattr(event, "num", 0) == 5 or getattr(event, "delta", 0) < 0
        canvas.yview_scroll(1 if down else -1, "units")

    def _add_section(self, key, page):
        """Adds one page of the outer notebook, and keeps it under its name.

        This uses a name and not a position. The sidebar, the header and the
        Apply row must each name "the open section". An index into a notebook
        is the incorrect key for that. A new section before the end moves the
        index of each section after it.
        """
        self.sections.add(page, text=key)
        self._section_pages[key] = str(page)

    def _build_sidebar(self):
        """The list down the left edge.

        About is not in it. This list is the list of the pages that hold
        settings, and About holds none. It is a button at the left end of the
        foot of the window now. See _build_apply.
        """
        family, size = self.roles["_font"]
        fonts = {"title": (family, size, "bold"),
                 "subtitle": (family, size + TYPE_SUPPORT)}
        width = self._sidebar_width(fonts)
        self._sidebar_entries = {}
        for entry in SECTIONS:
            made = SidebarEntry(self.sidebar, self.roles, fonts, entry,
                                self._open_section, width)
            made.pack(side="top", anchor="w", pady=(0, 2))
            self._sidebar_entries[entry[0]] = made
        self._open_section(SECTIONS[0][0])

    def _sidebar_width(self, fonts):
        """Returns the width that the rail needs for its names.

        A measurement and not a fixed value, for the same reason as the
        control heights: the font of the desktop gives the width of a name.
        Canvas text does not wrap and shows no mark for a cut, so a wider font
        removed the end of each subtitle.

        Never narrower than it was, and capped, so an enormous font gives a
        wider rail rather than a window that is all rail.
        """
        measures = dict((which, tkfont.Font(root=self.root, font=font))
                        for which, font in fonts.items())
        want = 0
        # SECTIONS and not SECTIONS + (ABOUT,): About is a button at the foot
        # of the window and not an entry of this list, so its name must not
        # decide how wide this list is.
        for _key, title, subtitle, _icon in SECTIONS:
            want = max(want, measures["title"].measure(title),
                       measures["subtitle"].measure(subtitle))
        return min(SIDEBAR_WIDTH_MAX,
                   max(SIDEBAR_WIDTH, SIDEBAR_TEXT_X + want + SIDEBAR_TEXT_PAD))

    def _open_section(self, key):
        """Show a section, and make the window say which one is open."""
        self.sections.select(self._section_pages[key])
        for name, entry in self._sidebar_entries.items():
            entry.set_selected(name == key)
        self.section = key
        self.section_title.configure(text=dict(
            (entry[0], entry[1]) for entry in SECTIONS + (ABOUT,))[key])
        # The line under the title answers for the open page, so it moves
        # with the page. See _say_headline.
        self._say_headline()
        if key == "cec":
            self._catch_up_cec()
        elif key == "power":
            self._catch_up_gpu()
        # After this page has a geometry, and not before. See
        # _relay_wrapping.
        self.root.after_idle(self._relay_wrapping)
        self._tab_changed()

    def _build_soon(self, where, key):
        """A section that is planned but not built.

        The page gives the function and the obstacle, and not only the plan.
        A page that gives a function and no other information looks the same
        as a page that failed to load.
        """
        title, doing, blocked = SOON[key]
        holder = ttk.Frame(where, style="Page.TFrame")
        holder.pack(fill="both", expand=True, padx=SIDE_MARGIN,
                    pady=SIDE_MARGIN)
        card = self._card(holder)
        card.pack(fill="x")
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="Coming soon", style="Section.TLabel").pack(
                      anchor="w")
        ttk.Label(inner, text=title, style="Heading.TLabel").pack(
                      anchor="w", pady=(ROW_GAP, GROUP_GAP // 2))
        for text in (doing, blocked):
            said = ttk.Label(inner, text=text, style="Muted.TLabel",
                             justify="left", wraplength=CARD_WRAP)
            said.pack(anchor="w", pady=(0, ROW_GAP))
            self._wrapped.append(said)
        return holder

    def _build_about(self, where):
        """Who made it, what it is, and where to go for the rest."""
        holder = ttk.Frame(where, style="Page.TFrame")
        holder.pack(fill="both", expand=True, padx=SIDE_MARGIN,
                    pady=SIDE_MARGIN)
        card = self._card(holder)
        card.pack(fill="x")
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="SteamOS Utility Center", style="Heading.TLabel").pack(anchor="w")
        ttk.Label(inner, text="Version %s" % VERSION,
                  style="Muted.TLabel").pack(
                      anchor="w", pady=(2, GROUP_GAP // 2))
        # The label over its text rather than beside it. Beside it, the text
        # column is the card's width less whatever the widest label takes -
        # a number this had to be told, was told wrong, and the last words of
        # two of the four lines were drawn past the edge of the card.
        # Stacked, both are the same width and there is nothing to get wrong.
        for label, text in ABOUT_LINES:
            ttk.Label(inner, text=label, style="Section.TLabel").pack(anchor="w", pady=(GROUP_GAP // 2,
                                                                2))
            said = ttk.Label(inner, text=text, style="Muted.TLabel", justify="left",
                             wraplength=CARD_WRAP)
            said.pack(anchor="w")
            self._wrapped.append(said)
        return holder

    def _build_rail(self):
        """Fill the rail, once the notebook knows what pages it has.

        Material gives a rail and not a row of tabs for six destinations, and
        a rail returns the vertical space of the tab row.

        The notebook keeps its pages and its events. Only its tab row goes out
        of the layout, so each function that watches for a page change still
        works and the rail drives it.
        """
        self._rail_choice = tk.StringVar(value=self.notebook.tabs()[0])
        for name in self.notebook.tabs():
            ttk.Radiobutton(
                self.rail, text=self.notebook.tab(name, "text"), value=name,
                variable=self._rail_choice, style="Rail.TRadiobutton",
                command=lambda page=name: self.notebook.select(page)).pack(
                    fill="x", pady=(0, 2))

    # -- helpers ----------------------------------------------------------

    def _set_busy(self, busy, code=None):
        """What the window does while a command runs, and when it ends.

        Each button that starts a command becomes disabled. The Runner also
        refuses a second command, but it reports the refusal in one line that
        nobody reads. After a command with a bad result, the reason goes
        beside the status light.
        """
        self._busy = busy
        for button in self._busy_buttons:
            button.state(["disabled"] if busy else ["!disabled"])
        if not busy:
            # These have their own reasons to stay disabled, and those reasons
            # continue after the command. _busy_buttons holds each button in
            # the window, and it also holds the drop-down fields. A call that
            # enables all of them returns settings that a switch above them
            # must hold closed. A user reported this: Apply with a rainbow
            # scene enabled its colour until the next start of the window.
            self._refresh_enabled()
            self._refresh_unsaved()
            self._refresh_update()
            # Cleared on success as firmly as it is set on failure: a warning
            # left standing beside a command that has just worked is worse
            # than no warning at all.
            self._say_problem(bool(code))

    def _say(self, title, message):
        """Tell the user something; there is nothing to answer."""
        Dialog(self.root, title, message)

    def _ask(self, title, message, confirm, deny="Cancel"):
        """Ask a yes-or-no question, and return whether it was confirmed."""
        return Dialog(self.root, title, message, confirm=confirm,
                      deny=deny).answer

    def _theme_chosen(self):
        """The look was picked. Save it and wear it, without an Apply.

        A user who must press a button to see a look selects that look without
        a view of it. It is also the one setting in this window with no cost
        for a wrong value. The user selects the other value again.
        """
        wanted = self._value_for("THEME", self.vars["THEME"][0].get())
        if wanted == self.app.get(appsettings.THEME):
            return                              # the trace fires on rebuild too
        settings = dict(self.app, **{appsettings.THEME: wanted})
        try:
            appsettings.write(settings)
        except (appsettings.SettingError, OSError) as exc:
            self._say("Appearance", "Could not save it:\n%s" % exc)
            return
        self.app = settings
        self.rebuild()

    def rebuild(self):
        """Build the window again, in whatever the settings now say.

        This function builds the window again and does not paint it again.
        That is a considered choice. One half of this window is not ttk: the
        shapes of the sidebar, its icons, the status dot, the canvas of each
        page and each colour sample are pictures with their colours in them.
        A paint step needs a second path to each of those pictures. One
        picture over the wrong colour already gave two faults in this project.
        The build path is the path with tests.

        The window keeps the values that it cannot read from disk: the open
        page and the edits with no Apply. Each other value comes from the
        files again, and it came from there at the first start.
        """
        unsaved = {}
        for key, (variable, _kind) in self.vars.items():
            try:
                unsaved[key] = variable.get()
            except (ValueError, tk.TclError):                # pragma: no cover
                pass
        section = getattr(self, "section", None)
        page = self.notebook.tab(self.notebook.select(), "text")
        # The record of a failed command since the start of the window. This
        # is the one part of the status bar with a reason that exists only in
        # the window. The lights read the machine again a moment later, and
        # the version is a constant.
        problem = bool(self.problem.winfo_ismapped())

        self._teardown()
        self.__init__(self.root)                # the one construction path

        if section is not None:
            self._open_section(section)
        for tab in self.notebook.tabs():
            if self.notebook.tab(tab, "text") == page:
                self.notebook.select(tab)
        for key, value in unsaved.items():
            if key in self.vars:
                try:
                    self.vars[key][0].set(value)
                except (ValueError, tk.TclError):            # pragma: no cover
                    pass
        self._say_problem(problem)
        self._catch_up()

    def _teardown(self):
        """Everything the old window booked or bound, before it is replaced.

        A destroyed *child* sends no <Destroy> event to the window. So this
        function calls the two cleanup steps of that binding directly: the
        timers, and the drain of the Runner. bind_all also applies to the
        interpreter and not to a widget. Without this function, each rebuild
        adds one more wheel handler for a window that no longer exists.
        """
        self._stop_timers()
        self.runner._stop()
        for wheel in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.root.unbind_all(wheel)
        for child in self.root.winfo_children():
            child.destroy()

    def _close(self):
        self._stop_timers()
        self.root.destroy()

    def _register_buttons(self):
        """Every button that would start a command, to grey while one runs.

        It walks the widget tree and does not read a list. A button missing
        from a list is a second pkexec prompt over the first, and nobody
        connects that to a list in this file. A button that only folds a block
        starts no command and stays active.

        The caller runs this again at each redraw of the status page, which
        builds its buttons again each time. It sets the busy state again at
        the end, so a registration during a command does not enable every
        button.
        """
        folds = set(getattr(self, "_fold_buttons", ()))
        self._busy_buttons = []

        def walk(widget):
            for child in widget.winfo_children():
                if isinstance(child, ttk.Button) and str(child) not in folds:
                    self._busy_buttons.append(child)
                walk(child)

        walk(self.root)
        if getattr(self, "_busy", False):
            for button in self._busy_buttons:
                button.state(["disabled"])

    def _set_window_icon(self):
        """The same icon the menu entry uses, in the titlebar and task bar.

        Each part of this is optional. The file can be absent, and Tk reads
        PNG from version 8.6 only. A default icon is not a reason to stop.
        """
        icon = ledpanel.panel_icon(SOURCE_DIR)
        if not os.path.isabs(icon):
            return                              # a theme name, not a file
        try:
            picture = tk.PhotoImage(file=icon)
        except tk.TclError:
            return
        _IMAGES.append(picture)                 # Tk keeps no reference itself
        self.root.iconphoto(True, picture)

    def _load_config(self):
        try:
            return config_module.load()
        except (config_module.ConfigError, OSError) as exc:
            self._say("Configuration",
                      "Could not read %s:\n%s\n\nShowing defaults instead."
                      % (config_module.DEFAULT_CONFIG_PATH, exc))
            return dict(config_module.DEFAULTS)

    def _write(self, text, tag=None):
        """Put a line where a log belongs, which is not in this window.

        There is no log pane. Command output goes to stderr, where the
        terminal, the journal and anything wrapping this program already look,
        and where it is selectable and does not disappear with the window.

        It keeps nothing. A list that no code reads grows for the whole
        session, and the status bar shows one fixed sentence now. See
        PROBLEM_TEXT.

        It cannot raise. A terminal closed while the window stays open leaves
        a broken pipe, and an exception here would come out of the middle of
        an install.

        `tag` belongs to the contract of the Runner, which marks its own first
        and last line with one. This signature keeps the Runner usable by each
        other caller that gives a simple writer.
        """
        try:
            print(text, end="", file=sys.stderr)
        except (OSError, ValueError):
            pass                                # no reader is left

    def _say_problem(self, failed):
        """Show or clear the warning beside the status lights.

        One line, in the error colour, beside the lights for the bar and the
        television, where each element that reports a condition stands.

        It says the same thing every time. The failing command's own last line
        had to be cut to the room beside the indicators, and a complaint cut
        at the end loses the useful half. This points at where the whole of it
        is.
        """
        if not failed:
            self.problem.pack_forget()
            return
        self.problem.pack(side="left", padx=(GROUP_GAP, 0))

    # -- the pieces a page is built from ----------------------------------

    def _ground(self, parent):
        """The style a plain frame needs to stand on this parent seamlessly.

        A frame is either a surface of its own, which is a card, or a part of
        its parent, and the second kind needs the name of its parent surface.

        A function and not a fixed style, because the builders below work on a
        card *and* on a page. With the wrong style a builder draws a band of
        the wrong colour at the width of its content.
        """
        try:
            named = str(parent.cget("style"))
        except tk.TclError:                                  # pragma: no cover
            return ""
        # The children of a card need the colour of the card, and a plain
        # ttk.Frame has that colour. So this function passes on the two other
        # surfaces only.
        return named if named in ("Page.TFrame", "OnCard.TFrame") else ""

    def _card(self, parent, **kw):
        """Builds a raised surface with round corners. It groups the settings.

        The corners are four small pictures that place() puts on the frame,
        and not one picture behind the whole frame as each other round element
        here uses. ttk fills a frame with an image by a scale step and scales
        again at each redraw, so the cost is the area of the card.

        The four cards of the CEC page cost approximately 150 ms of one wheel
        step together. With four corner pictures the same page moves in
        3.6 ms.

        Made before the caller fills the card, so the content stacks above
        them. Where the padding is narrower than the radius, the content
        covers the inner part of a corner square, which is card-coloured
        anyway.
        """
        card = ttk.Frame(parent, style="Card.TFrame", **kw)
        for photo, where in self._card_corners():
            tk.Label(card, image=photo, borderwidth=0, highlightthickness=0,
                     background=self.roles["surface"]).place(**where)
        return card

    def _card_corners(self):
        """The four corner pictures, made once and held for the window's life.

        The Panel holds them, and _IMAGES does not, because they carry the two
        colours of the current theme. A change of the theme builds the window
        again, and the pictures go away with the old window.
        """
        if self._corners is not None:
            return self._corners
        radius = CARD_RADIUS
        picture = roundrect.rows(radius * 2, radius * 2, radius,
                                 self.roles["surface"], self.roles["_page"])
        made = []
        for top in (True, False):
            for left in (True, False):
                rows = picture[:radius] if top else picture[radius:]
                photo = tk.PhotoImage(width=radius, height=radius)
                photo.put(roundrect.as_put_string(
                    [row[:radius] if left else row[radius:] for row in rows]))
                made.append((photo, {
                    "relx": 0.0 if left else 1.0,
                    "rely": 0.0 if top else 1.0,
                    "anchor": ("nw" if left else "ne") if top
                              else ("sw" if left else "se")}))
        self._corners = made
        return made

    def _section(self, parent, title=None, first=False, before=None,
                 card=False):
        """A named group of controls.

        Material tells groups apart by a heading and the space around them
        rather than by a line, which is what keeps a page of thirty settings
        from reading as thirty compartments.

        `card` raises it onto a surface of its own, which is what every other
        page in this window does with its groups. Without it a group is a
        piece of whatever it is packed into, and takes that ground.

        The heading goes *inside* the frame this returns rather than beside it,
        so a group is one widget: something packed before it lands above the
        heading and not between the heading and what it names.
        """
        where = parent
        if card:
            box = self._card(parent)
            box.pack(fill="x", padx=SIDE_MARGIN,
                     pady=(ROW_GAP if first else GROUP_GAP, 0),
                     **({"before": before} if before is not None else {}))
            holder = ttk.Frame(box, style="OnCard.TFrame")
            holder.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
            if title:
                ttk.Label(holder, text=title, style="Section.TLabel").pack(
                    anchor="w", pady=(0, ROW_GAP))
            return holder
        holder = ttk.Frame(where, style=self._ground(where))
        holder.pack(fill="x", padx=SIDE_MARGIN,
                    pady=(ROW_GAP if first else GROUP_GAP, 0),
                    **({"before": before} if before is not None else {}))
        if title:
            ttk.Label(holder, text=title, style="Section.TLabel").pack(
                anchor="w", pady=(0, ROW_GAP))
        return holder

    def _build_settings(self, parent, groups, note=None):
        """One tab: a heading per group, a row per setting.

        One grid for the whole tab, with each heading a row across it. A grid
        for each group takes its label column from its own longest label, so
        the controls of one group start at a different position from the next.

        `note` is a line below the rows, for a page where the rows cannot give
        the time of the change.

        A group can carry such a line itself, as a third element beside its
        title and its rows. That one stands inside the card, under the rows it
        is about. A page note stands under every card of the page.
        """
        outer = ttk.Frame(parent, style="Page.TFrame")
        grids = []

        row = 0
        headed = False
        for index, group in enumerate(groups):
            title, entries = group[0], group[1]
            inside = group[2] if len(group) > 2 else ""
            # A card per group. One grid for the whole page would keep the
            # label column aligned by itself, which is why it used to be one -
            # but a page of thirty settings on one flat field is what made the
            # light theme read as a wall, and the cards are what the eye rests
            # against. The alignment is put back below instead, by hand.
            card = self._card(outer)
            card.pack(fill="x", padx=SIDE_MARGIN,
                      pady=(ROW_GAP if index == 0 else GROUP_GAP, 0))
            # Named as what it is: the frame on a card. The ground is the same
            # colour under either name, and _note reads this name to give a
            # line inside a card the width of the card and not of the page.
            grid = ttk.Frame(card, style="OnCard.TFrame")
            grid.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
            grids.append(grid)
            # The slack goes to the last of the control columns, not the
            # first. On the first it would push the colour menus away from the
            # switches they belong to; here a slider still has somewhere to
            # stretch into, because a slider spans all three.
            grid.columnconfigure(SHAPE_COLUMN, weight=1)
            row = 0
            if title:
                ttk.Label(grid, text=title, style="Section.TLabel").grid(
                    row=row, column=0, columnspan=2, sticky="w",
                    pady=(0, ROW_GAP))
                row += 1
            # One time, above the first group with such rows. The columns
            # have the same position on the complete page. See _align below.
            # A second set of headings below repeats the first set.
            if not headed and any(entry[2] == FLASH for entry in entries):
                headed = True
                for column, heading in ((COLOUR_COLUMN, "Colour"),
                                        (SHAPE_COLUMN, "Shape")):
                    ttk.Label(grid, text=heading, style="Muted.TLabel").grid(
                        row=row, column=column, sticky="w", pady=(0, ROW_PAD),
                        padx=(LOOK_GAP if column == COLOUR_COLUMN else 0,
                              ROW_GAP))
                row += 1
            # A block is a switch with indented rows below it. The extra space
            # goes above the switch of a block, above the first row below it,
            # and above the row after the last of them. A switch then has the
            # same space on both sides. The indented rows below it, with a
            # small space, are the rows that belong to it.
            indents = [self._indent(entry[0]) for entry in entries]
            for position, entry in enumerate(entries):
                here = indents[position]
                before = indents[position - 1]
                after = (indents[position + 1]
                         if position + 1 < len(indents) else 0)
                fenced = (here == 0 and (after > 0 or before > 0)
                          or here > 0 and before == 0
                          # Two indented rows that never occur on the page at the
                          # same time are two blocks, also when this table holds
                          # them beside each other. The visible row of the two is
                          # the first row below the choice that shows it, and it
                          # needs the same space below it as the other row.
                          or (position
                              and self._exclusive(entry[0],
                                                  entries[position - 1][0])))
                self._build_row(grid, row, *entry,
                                lead=BLOCK_GAP if position and fenced else 0)
                row += 1
            if inside:
                # Across the grid, so it wraps at the width of the card and
                # not at the width of one column.
                self._note(grid, inside).grid(
                    row=row, column=0, columnspan=SHAPE_COLUMN + 1,
                    sticky="w", pady=(ROW_GAP, 0))
                row += 1
        self._align(grids)
        if note:
            # On the page under the cards, not inside one: it is about the
            # page as a whole rather than about the last group on it.
            said = self._note(outer, note, page=True)
            said.pack(anchor="w", padx=SIDE_MARGIN, pady=(GROUP_GAP, 0))
        return outer

    @staticmethod
    def _align(grids):
        """One label column width across every card on the page.

        One grid did this without extra code. A grid takes the width of its
        first column from its own longest label. Each card therefore starts
        its controls at a different position. That gives some irregular
        columns on a page that must be a list.
        """
        widest = 0
        for grid in grids:
            for child in grid.grid_slaves(column=0):
                if int(child.grid_info().get("columnspan", 1)) == 1:
                    widest = max(widest, child.winfo_reqwidth())
        for grid in grids:
            grid.columnconfigure(0, minsize=widest + GROUP_GAP)

    @staticmethod
    def _switches(need):
        """Returns the keys of one rule as a tuple: one key, or more."""
        return need[0] if isinstance(need[0], tuple) else (need[0],)

    @classmethod
    def _wanted(cls, needs, switch):
        """Which answers from `switch` this row accepts, as a set."""
        for need in needs:
            if isinstance(need, tuple) and switch in cls._switches(need):
                value = need[1]
                return set(value if isinstance(value, tuple) else (value,))
        return set()

    def _exclusive(self, key, other):
        """Whether these two rows can never be on the page at the same time.

        Not the same question as "do they use different rules". The colour of
        the desktop scene and its brightness use two lists with three scenes
        in common, so those rows appear together and are one block. The
        temperature marks and the load colours share no answer, so they are
        two.
        """
        needs, theirs = DEPENDS_ON.get(key, ()), DEPENDS_ON.get(other, ())
        for switch in {switch for need in needs if isinstance(need, tuple)
                       for switch in self._switches(need)}:
            mine, yours = self._wanted(needs, switch), self._wanted(theirs,
                                                                   switch)
            if yours and not (mine & yours):
                return True
        return False

    def _indent(self, key):
        """How far in a setting sits, by what it hangs off.

        A row that needs the main switch of the tab only stays at the margin.
        A row that also needs a row above it is indented below that row, so
        the notification blocks look like blocks and not like twelve equal
        lines. A row that depends on a *choice* is indented for the same
        reason.
        """
        needs = DEPENDS_ON.get(key, ())
        return (max(0, len(needs) - 1)
                + (1 if any(isinstance(need, tuple) for need in needs) else 0))

    def _build_row(self, grid, row, key, label, kind, low, high, step,
                   lead=0):
        """One setting: its name, its control, and a way to grey both out.

        `lead` is extra room above, for a row that begins a block. The row's
        own padding is the same everywhere, which is what makes the column
        regular now that the controls in it all stand the same height.
        """
        if kind == "power" and key == "CPU_EPP" and not power.epp_values():
            # Not greyed and not hidden: never built. A driver in passive mode
            # has no preference file at all, and a menu with nothing in it is
            # a row about a setting this machine does not have. Left out of
            # self.vars too, so nothing collects it and nothing compares it -
            # see _collect_power, which keeps the stored value instead.
            return
        minsize = self.roles["_sizes"]["control"] + 2 * ROW_PAD + lead
        grid.rowconfigure(row, minsize=minsize)
        name = ttk.Label(grid, text=label)
        name.grid(row=row, column=0, sticky="w", pady=(ROW_PAD + lead, ROW_PAD),
                  padx=(self._indent(key) * INDENT_STEP, GROUP_GAP))
        value = self._saved(key)
        labels, controls = [name], []
        # The widgets in this grid, which are not the widgets above. A
        # slider is two widgets in a frame, and the grid holds the frame.
        # To remove a row, remove these widgets. See _set_enabled.
        occupies = [name]

        if kind in ("bool", FLASH, FIXED):
            variable = tk.BooleanVar(value=bool(value))
            control = ttk.Checkbutton(grid, variable=variable)
            control.grid(row=row, column=CONTROL_COLUMN, sticky="w",
                         pady=(ROW_PAD + lead, ROW_PAD))
            controls.append(control)
            occupies.append(control)
            self._follow(variable)
            if kind == FLASH:
                self._build_look(grid, row, low, lead=lead)
            elif kind == FIXED:
                # What the two menus would have said, where they would have
                # been. A blank there reads as a setting that failed to draw.
                said = ttk.Label(grid, text=low, style="Muted.TLabel")
                said.grid(row=row, column=COLOUR_COLUMN, columnspan=2,
                          sticky="w", padx=(LOOK_GAP, 0),
                          pady=(ROW_PAD + lead, ROW_PAD))
                occupies.append(said)
        elif kind in ("choice", "sensor", "named", "power", "theme"):
            # Entries that are labels for another value. See the menu
            # functions in ledpanel. A "choice" is the case where the label and
            # the value are the same word. "sensor" and "power" are the two
            # that are read off the machine when the row is built rather than
            # written into the settings table: what a machine offers is not
            # something this file can know, and a list here would be a list
            # that is wrong on somebody's hardware.
            variable = tk.StringVar()
            choices = (ledpanel.sensor_choices(*ledpanel.read_sensors(),
                                               current=str(value))
                       if kind == "sensor"
                       else appsettings.theme_choices() if kind == "theme"
                       else ledpanel.power_choices(
                           power.governors() if key == "CPU_GOVERNOR"
                           else power.epp_values(),
                           current=str(value), labels=power.LABELS,
                           unset=key == "CPU_GOVERNOR")
                       if kind == "power"
                       else [(entry, entry) for entry in low]
                       if kind == "choice" else list(low))
            self._menu(grid, row, key, variable, choices, str(value),
                       width=(SENSOR_WIDTH
                              if kind in ("sensor", "power", "theme")
                              else MENU_WIDTH),
                       lead=ROW_PAD + lead)
            controls.append(self._widgets[key])
            occupies.append(self._widgets[key])
            self._follow(variable)
            if kind == "theme":
                # This does not use the unsaved count of _follow, because this
                # setting has no Apply button. The call uses after_idle, so the
                # menu closes before this code replaces the window below it.
                variable.trace_add(
                    "write",
                    lambda *_a: self.root.after_idle(self._theme_chosen))
        else:
            variable = tk.DoubleVar(value=float(value))
            scale, readout, holder = self._scale(grid, row, variable, low,
                                                 high, step,
                                                 lead=ROW_PAD + lead)
            controls.append(scale)
            self._follow(variable)
            labels.append(readout)
            occupies.append(holder)

        self.vars[key] = (variable, "bool" if kind in (FLASH, FIXED) else kind)
        self._rows[key] = (labels, controls)
        # Only what a row that can be taken away needs, and kept apart from
        # _rows because everything else reads that as a pair.
        self._row_places[key] = (grid, row, minsize, occupies)

    def _build_look(self, grid, row, prefix, lead=0):
        """The colour and the shape of one notification, beside its switch.

        This function registers them as settings of their own, under their
        own keys. DEPENDS_ON can then disable them with the switch beside
        them, and Apply can collect them. Neither of the two needs to know
        that the three are on one line. The keys come from the prefix, and
        the service uses the same prefix. See CONFIGURABLE_KINDS.
        """
        for column, key, choices, width in (
                (COLOUR_COLUMN, prefix + "_COLOR",
                 ledpanel.NOTIFICATION_COLOURS, COLOUR_WIDTH),
                (SHAPE_COLUMN, prefix + "_STYLE", KIND_STYLE_CHOICES,
                 SHAPE_WIDTH)):
            variable = tk.StringVar()
            value = str(self.config.get(key, config_module.DEFAULTS[key]))
            field = self._field(grid, key, variable, list(choices), value,
                                width=width)
            field.grid(row=row, column=column, sticky="w",
                       padx=(LOOK_GAP if column == COLOUR_COLUMN else 0,
                             ROW_GAP),
                       pady=(ROW_PAD + lead, ROW_PAD))
            self._follow(variable)
            self.vars[key] = (variable, "named")
            self._rows[key] = ([], [field])

    def _follow(self, variable):
        """Watch a control, so the window can keep up with it.

        Any setting can be one that another row depends on, and a watch costs
        nothing, so this watches every control. Nobody must then keep a list
        in step with DEPENDS_ON, and the count of unsaved settings follows
        each control as well.
        """
        variable.trace_add("write", self._settings_changed)

    def _settings_changed(self, *_args):
        """A control moved. Book the catching-up rather than doing it here.

        A drag sends one motion event for each pixel, and one pass over every
        dependent row and unsaved setting costs nine milliseconds.

        Tk runs idle work before it redraws, so a booked pass still catches up
        before anything is seen, once per redraw and not once per pixel.
        """
        if self._catching_up is None:
            self._catching_up = self.root.after_idle(self._catch_up)

    def _catch_up(self, *_args):
        """Everything the window owes a control that moved."""
        self._catching_up = None
        self._refresh_enabled()
        self._refresh_unsaved()

    def _saved(self, key):
        """What is on disk for this setting, from whichever file holds it.

        This is the one function that knows that the rows come from more than
        one file. Each other part uses this function and needs no knowledge of
        the files: the unsaved count, the controls of a page, and Reload.
        """
        if key in SYSTEM_KEYS:
            return self.system.get(key, syssettings.DEFAULTS[key])
        if key in POWER_KEYS:
            return self.power.get(key, power.DEFAULTS[key])
        if key in APP_KEYS:
            return self.app.get(key, appsettings.DEFAULTS[key])
        return self.config.get(key, config_module.DEFAULTS[key])

    def _differences(self):
        """Which settings in the window are not what the file holds.

        This function reads the values without a strict check, as the preview
        does. It runs at each step of a drag, and an incomplete value there is
        not a reason for a message.
        """
        changed = []
        for key, (variable, kind) in self.vars.items():
            saved = self._saved(key)
            try:
                raw = variable.get()
            except (ValueError, tk.TclError):        # pragma: no cover
                continue
            if kind == "bool":
                same = bool(raw) == bool(saved)
            elif kind in ("sensor", "named", "power", "theme"):
                # What is shown against what the file's value would show, so a
                # colour written in capitals in the file is not a change.
                same = raw == self._label_for(key, str(saved))
            elif kind in ("int", "float"):
                try:
                    same = abs(float(raw) - float(saved)) < 1e-9
                except (TypeError, ValueError):      # pragma: no cover
                    same = False
            else:
                same = str(raw) == str(saved)
            if not same:
                changed.append(key)
        return changed

    def _refresh_unsaved(self):
        """Say what is in the window and not in the file, and gate Apply on it.

        A button that is always pressable says nothing about whether pressing
        it would do anything. This one goes dead when the window and the file
        agree, which is also the answer to "did I already apply that?".
        """
        count = len(self._differences())
        self.unsaved.configure(
            text="" if not count
            else "1 unsaved change" if count == 1
            else "%d unsaved changes" % count)
        apply_button = self._apply_buttons[0][1]
        apply_button.state(["!disabled"] if count else ["disabled"])

    def _refresh_enabled(self):
        """Grey out every setting whose switch is off."""
        for key, needs in DEPENDS_ON.items():
            if key not in self._rows:
                continue
            self._set_enabled(key, all(self._satisfied(need) for need in needs))

    def _satisfied(self, need):
        """Whether one DEPENDS_ON entry is met.

        Three forms: the setting is on, it has this value, or it has one of
        these values. The third is necessary because three entries of one menu
        can mean the same for the row below, and three separate rules would
        all have to be true.

        A rule over more than one setting is met when one of them gives the
        value: the temperature marks apply when either the slot of Game Mode
        or the scene of the desktop shows the gauge.
        """
        wanted = None
        if isinstance(need, tuple):
            need, wanted = need
        if wanted is None:
            if need not in self.vars:
                return True             # not on any tab, nothing to hang off
            return bool(self.vars[need][0].get())
        switches = [switch for switch in self._switches((need, wanted))
                    if switch in self.vars]
        if not switches:
            return True
        return any(self._answers(switch, wanted) for switch in switches)

    def _answers(self, switch, wanted):
        """Whether one menu is set to the value, or to one of the values."""
        variable, kind = self.vars[switch]
        # A menu holds the label it shows, not the value it stands for.
        shown = variable.get()
        if kind in ("sensor", "named", "power", "theme"):
            shown = self._value_for(switch, shown)
        if isinstance(wanted, tuple):
            return shown in wanted
        return shown == wanted

    def _hides(self, key):
        """Whether this row is taken away rather than greyed while it is off.

        The dependency gives the answer, and no list holds it. A rule with a
        value is a *choice*, and a row that depends on a choice belongs to the
        effect in the slot. The note above DEPENDS_ON gives the reason for the
        two different answers.
        """
        return any(isinstance(need, tuple) for need in DEPENDS_ON.get(key, ()))

    def _set_enabled(self, key, on):
        labels, controls = self._rows[key]
        if self._hides(key):
            grid, row, minsize, occupies = self._row_places[key]
            if bool(occupies[0].grid_info()) == bool(on):
                return
            # grid_remove rather than grid_forget: it remembers the placement,
            # so the row comes back where it belongs instead of at the bottom
            # of the page.
            for widget in occupies:
                widget.grid() if on else widget.grid_remove()
            # The minimum height of the row goes away with it. Each row gets
            # one, so a column of switches, menus and sliders keeps one
            # spacing. But a minimum height under an empty row keeps the space
            # of that row, and the removal must close that space.
            grid.rowconfigure(row, minsize=minsize if on else 0)
            return
        # Nothing to do when the row already looks like that, which is almost
        # every time: eleven hundred of these in fifty steps of a drag, and
        # not one a change.
        #
        # Read back off the widget and not remembered here. _set_busy wakes
        # every button without coming through this, so an answer kept on the
        # side is stale exactly when it matters.
        if controls and ("disabled" not in controls[0].state()) == bool(on):
            return
        for label in labels:
            # Labels take a disabled state but clam draws them the same, so
            # the muted style does the greying that people actually see.
            label.configure(style="TLabel" if on else "Muted.TLabel")
        for control in controls:
            control.state(["!disabled"] if on else ["disabled"])
        # A greyed field is painted in a shade of its own, so a swatch baked
        # against the ordinary one now stands on it as a box. Drawn again
        # rather than left, and after the state is set, because that is what
        # it is read from.
        if key in self._widgets:
            self._show_swatch(key)

    def _note(self, parent, text, page=False, **kwargs):
        """A line of explanation that wraps at the window's width, not at 580.

        A fixed wraplength breaks mid-sentence on a wide window and leaves the
        right half of it empty, which is what made this page look ragged.

        `page` is for the ones that stand under the cards rather than inside
        one, which need the ground behind them to match.
        """
        label = ttk.Label(parent, text=text, justify="left",
                          style="Page.Muted.TLabel" if page
                          else "Muted.TLabel", wraplength=560, **kwargs)
        self._wrapped.append(label)
        # A note in a card has the padding of the card less space than a note
        # on the page. _rewrap gives the same width to each label. Without
        # this code, the notes in cards were wider than the card, and the card
        # cut them at its edge. This code reads the value from the parent and
        # does not take it from each caller. A caller writes a note at its
        # position, and no caller must calculate the space around it.
        try:
            if str(parent.cget("style")) == "OnCard.TFrame":
                self._wrap_insets[str(label)] = 2 * GROUP_GAP
        except tk.TclError:                                  # pragma: no cover
            pass
        return label

    def _rewrap(self, event):
        """Follows the width of the page, after a change of that width.

        On the notebook and not on the window, for two reasons. The page is
        narrower than the window by the width of the rail, and text wrapped at
        the width of the window is cut at the edge of the page.

        And a read of the notebook width during the Configure of the *window*
        gives the width before the change, so the wrap stayed one size change
        behind.

        A toplevel is in the bindtags of each widget below it, so the same
        binding on the window ran for each child with the width of that child.
        One such call carried 14 px from a scrollbar, wrapped every text into
        a narrow column, and started the handler again. The guard below
        records which widget sent the event.

        Setting wraplength can also bring a Configure straight back, which is
        what comparing the width first ends.
        """
        # Both notebooks. A section with one page of its own also holds
        # explanations. Without that section here its text went onto one line,
        # and the window opened at two and a half thousand pixels.
        if event.widget not in (self.notebook, self.sections):
            return
        # Less the scrollbar, whether this page has one or not.
        #
        # A page that scrolls gives fourteen pixels of its side to the bar,
        # and the width of the notebook does not hold that value. A label
        # wider than its space is not wrapped: the page cuts it.
        #
        # Reserved on each page and not only on a page with a bar. The height
        # of the window decides whether a page has one, and the wrap must not
        # change with the height of the window.
        width = max(320, min(event.width, CONTENT_MAX)
                    - CARD_INSET - SCROLLBAR_ROOM)
        if width == self._wrap_widths.get(str(event.widget)):
            return
        self._wrap_widths[str(event.widget)] = width
        self._wrap_width = width
        self._set_wrapping()

    def _relay_wrapping(self):
        """Sets the wraplengths again, after the layout of the page.

        The insets are measured against the widget above each line, and at the
        first report of the notebook width no widget has a position yet. The
        caller schedules this after a section opens, when the geometry is
        correct.
        """
        if not self._wrap_widths:
            return
        # The geometry first. An idle callback can come before the callback
        # that lays out the page. A measurement then gives the start value of
        # each widget, which is nothing. The code then uses the fallback,
        # which is the constant that this function must replace.
        self.root.update_idletasks()
        self._set_wrapping()
        self._relay_buttons()

    def _relay_buttons(self):
        """Lay each row of buttons out in as many columns as actually fit.

        The columns are equal and they stretch, so a name wider than its share
        is cut. The font of the desktop gives the width of a name and the
        window gives the space, and neither was known at the build step.
        """
        for row, buttons in self._button_rows:
            if not row.winfo_ismapped() or not buttons:
                continue
            widest = max(button.winfo_reqwidth() for button in buttons)
            room = row.winfo_width()
            if room <= 1 or widest <= 1:
                continue
            across = max(1, min(self.BUTTONS_ACROSS,
                                (room + ROW_GAP) // (widest + ROW_GAP)))
            if across == self._button_across.get(str(row)):
                continue
            self._button_across[str(row)] = across
            for column in range(self.BUTTONS_ACROSS):
                row.columnconfigure(column, weight=0, uniform="")
            for column in range(across):
                row.columnconfigure(column, weight=1, uniform="buttons")
            for index, button in enumerate(buttons):
                button.grid(row=index // across, column=index % across,
                            sticky="ew", padx=(0, ROW_GAP), pady=(0, ROW_GAP))

    def _set_wrapping(self):
        """Lay every wrapped line out to the room its own page has."""
        for label in self._wrapped:
            room = self._page_width(label)
            if room:
                label.configure(wraplength=max(
                    160, room - self._inset_of(label)))

    def _page_width(self, label):
        """How wide the page this label stands on is.

        Two notebooks with different widths: the tabs of the strip have the
        width of the rail less than a section with one page, 631 against 812.
        One value for both wraps one of them 180 px early or 180 px past the
        edge of its card, and a label wider than its space is not wrapped. The
        card cuts it.

        Asked per label rather than remembered per page, because a label knows
        where it is and nothing has to be told when it moves.
        """
        up = label
        while up is not None:
            # The inner notebook first: it is *inside* the outer one, so a
            # label on a tab of the strip is under both and wants the nearer.
            if up is self.notebook or up is self.sections:
                return self._wrap_widths.get(str(up), self._wrap_width)
            up = getattr(up, "master", None)
        return self._wrap_width

    def _inset_of(self, label):
        """How much less room this label has than the page it stands on.

        For a fixed indent this returns a number. For a variable indent it
        returns the widget above the line.

        The font of the desktop gives the width of a switch and the width of a
        column of setting names. A constant from one font therefore makes a
        label wider than its card on another font. A label that is wider than
        its space is not wrapped. The card cuts it at its edge. That fault sent
        the ends of these explanations past the side of the window.
        """
        found = self._wrap_insets.get(str(label), 0)
        if isinstance(found, int):
            return found
        try:
            lead = found.winfo_x()
        except tk.TclError:                                 # pragma: no cover
            return CEC_INDENT
        # Before the first layout every widget sits at nothing and is one
        # pixel wide; wrapping to that would be a column of single words that
        # a later pass would have to undo.
        if lead <= 1:
            return CEC_INDENT
        # The same value as a note in a card. See _note. This also adds the
        # indent of this line.
        return lead + 2 * GROUP_GAP

    def _build_apply(self, parent):
        """Apply and Reload, once, below the tabs that have settings.

        One row below all the tabs says by its position that Apply writes
        each of them. It must stand below the correct tabs only: on Status &
        repair it read as "apply the firmware".

        The buttons go away on a tab with no settings, and the row keeps its
        height. Taking the row out of the layout moved everything below it on
        every tab change.
        """
        self.apply_row = ttk.Frame(parent, style="Page.TFrame")
        self.apply_row.pack(side="bottom", fill="x",
                            padx=SIDE_MARGIN + SIDE_MARGIN // 2,
                            pady=(GROUP_GAP, GROUP_GAP))
        # About, at the left end. It was the last entry of the sidebar, under
        # the sections. The list on the left is the list of the pages that
        # hold settings, and About holds none: it is the name of the program,
        # its version and who wrote the parts of it. So it stands here, at the
        # end of the window that is about the window itself.
        self.about_button = ttk.Button(
            self.apply_row, text="About", style="Page.Text.TButton",
            command=lambda: self._open_section(ABOUT[0]))
        self.about_button.pack(side="left")
        # The record of a failed command, beside it. It says the same thing
        # every time and it is packed only for a failure. See _say_problem.
        # An empty label still takes its padding, and that space is then the
        # one element of this row with no meaning.
        self.problem = ttk.Label(self.apply_row, text="\u26a0 " + PROBLEM_TEXT,
                                 style="Page.Bad.TLabel")
        # Four buttons at the right end, and none at the left one.
        #
        # The first two act on the settings in this window and the last two
        # on a file of them. At the two edges of the row, that put the width
        # of the window between two buttons a person uses one after the other.
        # The gap between the pairs says the same at a tenth of the distance.
        #
        # Profiles are here and not on a page of their own: this is already
        # the row for "what to do with these settings".
        #
        # The list is in the order a person reads them, and _show_apply packs
        # it backwards, because pack puts each widget to the left of the last.
        # Other code that names the first of them names Apply.
        self._apply_buttons = [
            # The text is no longer "Apply and restart service". The settings
            # of the System page restart no service. They belong to the
            # machine, and they take effect at the next login. A button with
            # the word restart describes one part of its work only.
            (0, ttk.Button(self.apply_row,
                           text="Apply changes",
                           style="Page.Filled.TButton",
                           command=self.apply_settings)),
            (ROW_GAP, ttk.Button(self.apply_row, text="Reload from file",
                                 style="Page.Tonal.TButton",
                                 command=self.reload_settings)),
            # The space that used to be the width of the window. It separates
            # the pair that writes these settings from the pair that writes a
            # file of them.
            (GROUP_GAP * 2, ttk.Button(self.apply_row, text="Save profile...",
                                       style="Page.Outlined.TButton",
                                       command=self.save_profile)),
            (ROW_GAP, ttk.Button(self.apply_row, text="Load profile...",
                                 style="Page.Outlined.TButton",
                                 command=self.load_profile)),
        ]
        # The settings in the window that are not yet in the file. A settings
        # window without that report makes the user remember the changes, and
        # no user does that. So Apply is disabled when there is no change, and
        # this label gives the number of changes.
        self.unsaved = ttk.Label(self.apply_row,
                                 style="Page.Muted.TLabel")
        self._show_apply(True)
        self._refresh_unsaved()

    def _show_apply(self, show):
        self._apply_shown = show
        if show:
            self.apply_row.pack_propagate(True)
            # Backwards, because pack puts each widget to the left of the last
            # one. The list reads in the order of the screen. See _build_apply.
            for lead, button in reversed(self._apply_buttons):
                button.pack(side="right", padx=(lead, 0))
            # Beside Apply, and not at the other end of the row: it is the
            # count of what Apply would write.
            self.unsaved.pack(side="right", padx=(0, GROUP_GAP))
            return
        # Hold the height the buttons had, then take them out: with the row
        # free to shrink, the rest of the window slides up to meet it.
        height = self.apply_row.winfo_height()
        if height > 1:
            self.apply_row.configure(height=height)
            self.apply_row.pack_propagate(False)
        for _lead, button in self._apply_buttons:
            button.pack_forget()
        self.unsaved.pack_forget()

    def _tab_changed(self, _event=None):
        """Only show Apply where there is something to apply.

        Two levels: a section that is one table of settings always has
        something, the LED strip only on four of its seven pages, and the
        unbuilt sections and About never.
        """
        # The rail follows the notebook, and not the opposite. The rail
        # therefore also shows a page that the code selects, or that a
        # keyboard shortcut selects.
        self._rail_choice.set(self.notebook.select())
        show = self._has_settings()
        if show != self._apply_shown:
            self._show_apply(show)
        # The preview only runs while it can be seen.
        if self._preview_visible() and self._preview_job is None:
            self._preview_started = time.monotonic()
            self._preview_tick()

    def _refit_page(self):
        """Tell the open page's scroller that its content changed height.

        The inner frame of a page is a canvas window item, so it has the size
        the scroller gave it. A new widget does not make it larger, and the
        scroller recalculates only after a change of its size. Nothing closes
        that loop: a fan curve asked for 200 pixels, got 120, and lost its
        lower half.

        Not _fit_window, which resizes the *window*. On a window already at
        the height the screen allows, that changes nothing.
        """
        canvas = self._scrollers.get(str(self._open_page()))
        if canvas is None:
            return
        self.root.update_idletasks()
        for child in canvas.winfo_children():
            child.event_generate("<Configure>")

    def _open_page(self):
        """The scrolling page actually on screen, of either notebook.

        Two levels give two answers, and the wheel needs the page on the
        screen. With the inner notebook only, the wheel scrolled the page of
        the LED strip while the window showed a different section.
        """
        if getattr(self, "section", None) == "strip":
            return self.notebook.select()
        return self._section_pages.get(getattr(self, "section", None))

    def _has_settings(self):
        """Whether what is on screen right now is settings to be applied."""
        if getattr(self, "section", None) is None:
            return False
        if self.section in SECTION_SETTINGS:
            # A page whose module is not installed shows the offer to install
            # it and no settings at all. An Apply row under that offer would
            # be a button for a page with nothing on it.
            #
            # The System page is not in this list. Its keyboard half is the
            # core, and it has settings whatever the module does.
            if self.section == "power" and not self._module_here("power"):
                return False
            # But not for a page where each setting takes effect at once. The
            # App Settings page is such a page. An Apply row below a page
            # whose one setting is already applied reports an open change, and
            # there is none.
            table, _note = SECTION_SETTINGS[self.section]
            # group[1] and not an unpack: a group can carry a third element,
            # which is a line inside its card. See _build_settings.
            return any(row[0] not in APP_KEYS
                       for group in table for row in group[1])
        if self.section != "strip":
            return False
        # The tabs of this section are still there when the LED module is not,
        # because the notebook is built and simply never packed. select() thus
        # answers with a tab that nobody can see.
        if not self._module_here("led"):
            return False
        return self.notebook.select() in self._settings_tabs

    def _field(self, parent, key, variable, choices, current, width=None):
        """A drop-down of (label, value) pairs, showing labels.

        A field of this file and not a combobox, for two reasons. A combobox
        opens a Tk listbox, which holds text only, so a list of colours cannot
        show the colours. And Tk posts that listbox under a grab it does not
        release, so it stays above the next window. See Popup.

        It returns the field and does not place it: the settings grid and the
        rows on Status & repair use different layouts.

        `key` names the field among the drop-downs. A setting uses its own
        name, and each other field a word in lower case, which cannot collide
        because a configuration name is in upper case.
        """
        self._menus[key] = list(choices)
        button = ttk.Button(parent, textvariable=variable,
                            style="Field.TButton", compound="left",
                            command=lambda: self._open_menu(key))
        if width is not None:
            button.configure(width=width)
        self._widgets[key] = button
        self._menu_parts[key] = variable
        # The button carries the swatch of whatever is chosen, so the colour is
        # readable without opening anything.
        variable.trace_add("write", lambda *_a: self._show_swatch(key))
        variable.set(self._label_for(key, current))
        self._show_swatch(key)
        return button

    def _menu(self, grid, row, key, variable, choices, current, width,
              lead=0):
        """One of those in a settings row, beside the name of the setting."""
        self._field(grid, key, variable, choices, current, width).grid(
            row=row, column=CONTROL_COLUMN, columnspan=CONTROL_SPAN,
            sticky="w", pady=(lead, ROW_PAD))

    def _open_menu(self, key):
        """Drop this one down, having taken down whatever else was open.

        A second press on the field closes the list and does not open it
        again. The press already closed it. See _panel_click. This function
        runs on the release after that press.
        """
        showing = self._popup.key if self._popup is not None else None
        self._dismiss_menus()
        if showing == key:
            return
        self._popup = Popup(self._widgets[key], key, self.roles,
                            self._menus[key], self._menu_parts[key],
                            self._swatch, self._menu_closed)

    def _swatch(self, value, ground, keep=True):
        """A square of colour for a menu entry, or None if this is not one.

        Told by the value and not by a list: anything the file holds as
        #rrggbb is one, so a colour setting added later gets its swatch.

        `ground` is a role name or a colour, because the colour behind a
        sample does not always have a role name. See _ground_under.
        """
        if not _COLOUR.match(str(value)):
            return None
        shade = self.roles.get(ground, ground)
        square = roundrect.rows(
            SWATCH_SIZE, SWATCH_SIZE, material.SHAPE_EXTRA_SMALL, value,
            shade, border=self.roles["outline"], border_width=1)
        # Wider than it is tall: a menu entry has no padding to give, so the
        # gap between the colour and its name is part of the picture.
        blank = [shade] * SWATCH_GAP
        return _photo([row + blank for row in square], keep=keep)

    # -- swatches on widgets that change shade under them ------------------
    #
    # A colour sample has no alpha channel, so it holds its background in its
    # round corners and beside it: forty-four of its one hundred and ninety
    # six pixels are a mix of the two. With the wrong background it shows a
    # box behind the colour, which is invisible in the light theme and a dark
    # rectangle in the dark one.
    #
    # The correct shade is not one value. A field takes a grey fill when it is
    # disabled, and a button mixes its own fill below the pointer, so this
    # asks again at each state change. The two tables below hold the same
    # states as the pictures in apply_theme.
    FIELD_STATES = ()
    BUTTON_STATES = (("pressed", material.STATE_PRESSED),
                     ("active", material.STATE_HOVER))

    def _ground_under(self, widget, base="surface", states=FIELD_STATES):
        """The colour actually behind a swatch on this widget, right now."""
        showing = widget.state()
        if "disabled" in showing:
            return material.disabled_container(self.roles)
        shade = self.roles[base]
        for name, weight in states:
            if name in showing:
                return material.blend(shade, self.roles["on_surface"], weight)
        return shade

    def _dress(self, widget, value, base="surface", states=FIELD_STATES):
        """Draws the colour sample for the current state of this widget.

        The widget holds the picture, and the window does not. This code draws
        the picture again at each change of the shade. A list of each picture
        grows for the complete time of a movement of the pointer.
        """
        image = self._swatch(value, self._ground_under(widget, base, states),
                             keep=False)
        widget.configure(image=image or "")
        widget._swatch_image = image                        # keeps it alive

    def _follow_shade(self, widget, value, base="surface",
                      states=BUTTON_STATES):
        """Dress a widget now, and again whenever the pointer changes it.

        For the buttons that blend their own fill. A field does not need this
        - its fill only moves when it is disabled, and _set_enabled says so.
        """
        self._dress(widget, value, base, states)
        for when in ("<Enter>", "<Leave>", "<ButtonPress-1>",
                     "<ButtonRelease-1>"):
            # This uses after_idle, because the binding of ttk sets the state
            # and this binding can run first. A read here gives the state
            # before the change.
            widget.bind(when, lambda _e, w=widget, v=value, b=base, s=states:
                        w.after_idle(self._dress, w, v, b, s), add="+")

    def _panel_click(self, event):
        """A click anywhere in the panel takes an open drop-down down.

        The grab did this before, and this code does it without a grab. A
        click in the list does not come here. A toplevel is in the bindtags of
        its own children only, and the list is a toplevel of its own.
        """
        if self._popup is None or event.widget is self._popup.owner:
            return                              # the field toggles itself
        self._dismiss_menus()

    def _menu_closed(self):
        self._popup = None

    def _dismiss_menus(self, _event=None):
        """Closes the drop-down, if one is open."""
        if self._popup is not None:
            self._popup.close()

    def _show_swatch(self, key):
        """Put the chosen colour on the button, where it can be seen."""
        button = self._widgets[key]
        self._dress(button, self._value_for(key, button.cget("text")))

    def _label_for(self, key, value):
        """The entry for a configured value, added to the menu if it is new.

        Editing the file by hand and pressing Reload is how these settings are
        meant to be used from a terminal, so a value the menu does not offer
        has to become an entry rather than be silently replaced.
        """
        choices = self._menus[key]
        label = ledpanel.menu_label(choices, value)
        if label is not None:
            return label
        choices.append((value, value))
        return value

    def _value_for(self, key, label):
        """Back from the menu entry to what the config file wants."""
        return ledpanel.menu_value(self._menus[key], label)

    def _scale(self, grid, row, variable, low, high, step, lead=0):
        # Across the three control columns: a slider in the first of them
        # would be as narrow as a switch, and its readout would land under
        # somebody's colour menu.
        holder = ttk.Frame(grid)
        holder.grid(row=row, column=CONTROL_COLUMN, columnspan=CONTROL_SPAN,
                    sticky="ew", pady=(lead, ROW_PAD))
        holder.columnconfigure(0, weight=1)
        readout = ttk.Label(holder, width=6)
        pattern = "%%.%df" % _decimals(step)

        def show(*_args):
            value = variable.get()
            # Snap to the step, so the knob rests where the readout says: a
            # slider showing 2.4 while holding 2.4372 lies. Rounding to the
            # step's decimals also keeps 2.4000000000000004 out of the file.
            snapped = round(round(value / step) * step, _decimals(step))
            snapped = min(max(snapped, low), high)
            # The readout first, and at each call. A measurement showed this:
            # a ttk.Scale does not call its command again for a value that the
            # command set. So each line after that set does not run. During a
            # drag, each value also arrives between two steps. The number
            # beside the slider therefore never changed.
            readout.configure(text=pattern % snapped)
            if abs(value - snapped) > 1e-9:
                variable.set(snapped)

        scale = ttk.Scale(holder, from_=low, to=high, variable=variable,
                          command=show)
        scale.grid(row=0, column=0, sticky="ew")
        readout.grid(row=0, column=1, padx=(6, 0))
        show()
        # The holder too: it is what the outer grid actually holds, so it
        # is what has to go when the row is taken away.
        return scale, readout, holder

    def _collect(self):
        """The service's settings out of the widgets, validated.

        The system settings are not in this result. See _collect_system. They
        are a different file with a different validator. A call to
        config_module.validate for one of them asks the LED service to accept
        a keyboard layout.
        """
        values = {}
        for key, (variable, kind) in self.vars.items():
            if key in SYSTEM_KEYS or key in POWER_KEYS or key in APP_KEYS:
                continue
            raw = variable.get()
            values[key] = (bool(raw) if kind == "bool"
                           else int(round(raw)) if kind == "int"
                           else float(raw) if kind == "float"
                           else self._value_for(key, raw)
                           if kind in ("sensor", "named", "power", "theme")
                           else str(raw))
        # The idle rate cannot exceed the active one, which two independent
        # sliders cannot express. Pulling FPS below IDLE_FPS is an obvious
        # intention, so follow it rather than refuse the adjustment.
        if values["IDLE_FPS"] > values["FPS"]:
            values["IDLE_FPS"] = values["FPS"]
            self.vars["IDLE_FPS"][0].set(float(values["FPS"]))
            self._write("Idle frame rate lowered to %d to stay under the "
                        "active rate.\n" % values["FPS"])

        merged = dict(self.config)
        merged.update(values)
        config_module.validate(merged)      # raises ConfigError
        return values

    def _load_power(self):
        """What the CPU settings file holds. Readable without any rights."""
        return ledpanel.read_power_config()

    def _collect_system(self):
        """The machine's own settings out of the widgets, validated."""
        values = {key: self._value_for(key, self.vars[key][0].get())
                  for key in SYSTEM_KEYS if key in self.vars}
        syssettings.validate(values)        # raises SettingError
        return values

    def _collect_power(self):
        """The CPU settings out of the widgets, checked against the machine.

        Against the machine and not against a list, and here and not in the
        helper alone: the window must refuse a value this hardware does not
        offer, and show the reason.
        """
        # It starts from the values in the file, so a row with no hardware on
        # this machine keeps its stored value. Without this, each Apply
        # removes that row from the configuration.
        values = dict(self.power)
        values.update({key: self._value_for(key, self.vars[key][0].get())
                       for key in POWER_KEYS if key in self.vars})
        power.validate(values)              # raises ValueError
        return values

    def apply_settings(self):
        """Put the window into the files, one prompt at most.

        The settings of the machine come first, because they need no rights.
        This function writes them now, as the user. The settings of the
        service go through pkexec, and only after a change. A keyboard layout
        must not ask for a password, and it must not restart the LED service.
        """
        try:
            values = self._collect()
        except config_module.ConfigError as exc:
            self._say("Not a usable setting", str(exc))
            return

        try:
            system = self._collect_system()
        except syssettings.SettingError as exc:
            self._say("Not a usable setting", str(exc))
            return
        if system != self.system:
            try:
                syssettings.write(system)
            except OSError as exc:
                self._say("System settings",
                          "Could not write %s:\n%s"
                          % (syssettings.directory(), exc))
                return
            self.system = system
            self._refresh_unsaved()
            self._write("Saved the machine's settings. They take effect at "
                        "the next login.\n\n")

        try:
            cpu = self._collect_power()
        except ValueError as exc:
            self._say("Not a usable setting", str(exc))
            return
        if cpu != self.power:
            # This has its own prompt, and only after a change. Two prompts in
            # sequence are not good. But these are two different files, and two
            # different helpers install them. The other method is one helper
            # for each file, and this project does not use that method on
            # purpose. See scripts/apply-power.sh.
            cpu_staged = ctl.stage(ledpanel.power_config_text(cpu),
                                   ctl.STAGED["power"])

            def cpu_done(code, path=cpu_staged, wanted=dict(cpu)):
                os.unlink(path)
                if code == 0:
                    self.power = wanted
                    self._refresh_unsaved()

            self._run_privileged(
                ledpanel.apply_power_command(SOURCE_DIR, cpu_staged),
                ledpanel.apply_power_command(SOURCE_DIR, cpu_staged, ask=True),
                cpu_done)

        if values == {key: self.config.get(key, config_module.DEFAULTS[key])
                      for key in values}:
            # Nothing of the service's changed, so there is nothing to install
            # and nothing to restart. Without this, changing only a system
            # setting would still ask for a password and bounce the bar.
            return

        try:
            with open(config_module.DEFAULT_CONFIG_PATH) as handle:
                text = handle.read()
        except OSError:
            # No config yet: start from the one shipped in the repository so
            # its comments come along.
            shipped = os.path.join(SOURCE_DIR, "server",
                                   "steamos-utility-center.conf")
            try:
                with open(shipped) as handle:
                    text = handle.read()
            except OSError as exc:
                self._say("Configuration", str(exc))
                return

        # At the name that the sudoers rule permits, where there is one. A
        # temporary file has a name that nobody knows in advance, and no rule
        # can name it. ctl.stage falls back to one where this directory is not
        # there, and the run then asks for a password as it did before.
        staged_path = ctl.stage(config_module.update_text(text, values),
                                ctl.STAGED["strip"])

        def finished(code):
            os.unlink(staged_path)
            if code != 0:
                self.refresh_status()
                return
            self.config.update(values)
            self._refresh_unsaved()
            # The helper restarted the service. But the two watchers read the
            # same file, and they are user units that the helper cannot reach.
            # Without this call, a changed flash setting waits for the end of
            # the next game, and the switch for the phone flashes has no result.
            self.runner.start(ledpanel.restart_watchers_command(),
                              lambda _code: self.refresh_status())

        self._run_privileged(
            ledpanel.apply_config_command(SOURCE_DIR, staged_path),
            ledpanel.apply_config_command(SOURCE_DIR, staged_path, ask=True),
            finished)

    def _show_values(self, values):
        """Put these settings into the controls. Keys we do not show are
        ignored, and anything missing falls back to the shipped default."""
        shown = 0
        for key, (variable, kind) in self.vars.items():
            if key not in values:
                continue
            value = values[key]
            variable.set(bool(value) if kind == "bool"
                         else self._label_for(key, str(value))
                         if kind in ("sensor", "named", "power", "theme")
                         else str(value) if kind == "choice"
                         else float(value))
            shown += 1
        self._catch_up()                # now: the caller reports what it did
        return shown

    def reload_settings(self):
        """Both files back into the window, throwing away what is unsaved.

        This reads both files, because the button has the text "Reload from
        file" and the window shows two files. With the file of the service
        only, the System page keeps an edit that Reload appeared to remove.
        """
        self.config = self._load_config()
        self.system = syssettings.read()
        merged = dict(config_module.DEFAULTS)
        merged.update(self.config)
        merged.update(self.system)
        self._show_values(merged)
        # This message is here and not at the end of load_profile. That
        # function reports the profile that it loaded, and it also reported a
        # reload of /etc. It does not reload /etc. This function reloads /etc
        # and gave no message.
        self._write("Reloaded %s and %s\n\n"
                    % (config_module.DEFAULT_CONFIG_PATH,
                       syssettings.directory()))

    # -- profiles ---------------------------------------------------------

    def save_profile(self):
        """Write the settings in this window to a file of their own."""
        try:
            values = self._collect()
        except config_module.ConfigError as exc:
            self._say("Not a usable setting", str(exc))
            return

        directory = ledpanel.profiles_dir(SOURCE_DIR)
        try:
            os.makedirs(directory, exist_ok=True)
        except OSError as exc:
            self._say("Profiles", str(exc))
            return

        path = ProfileDialog(self.root, directory, self.roles,
                             saving=True).chosen
        if not path:
            return
        try:
            with open(path, "w") as handle:
                handle.write(ledpanel.profile_text(values))
        except OSError as exc:
            self._say("Profiles", str(exc))
            return
        self._write("Saved %d settings to %s\n\n" % (len(values), path))

    def load_profile(self):
        """Reads a profile into the controls, and does nothing more.

        This function does not apply the profile, on purpose. The values come
        into the window as Reload puts them there. The user therefore sees the
        new values before this program writes to /etc.
        """
        directory = ledpanel.profiles_dir(SOURCE_DIR)
        path = ProfileDialog(self.root, directory, self.roles,
                             saving=False).chosen
        if not path:
            return
        try:
            values = ledpanel.read_profile(path)
        except (config_module.ConfigError, OSError) as exc:
            self._say("Profile", str(exc))
            return

        shown = self._show_values(values)
        self._write("Loaded %d settings from %s\n" % (shown, path))
        skipped = len(values) - shown
        if skipped:
            # Settings of the service that this window does not show. The
            # serial port is one of them. This message is better than a user
            # who believes that Apply wrote them and lost them.
            self._write("%d setting(s) in the file are not shown here and "
                        "were left alone.\n" % skipped)
        self._write("Nothing is written yet - press Apply to keep it.\n\n")

    # -- tests ------------------------------------------------------------

    # -- the preview tab ---------------------------------------------------
    #
    # Only the effects this project added. Steam's own can be seen by picking
    # them in Steam, and the standby and startup breaths are states the
    # machine puts itself into rather than anything chosen here.

    # How many buttons fit across the window at its narrowest, which is what a
    # row of them wraps at.
    BUTTONS_ACROSS = 4

    PREVIEW_FPS = 25
    # The stage takes the free space of the page, and the strip takes the
    # size of the stage. The stage is not one fixed size in a corner. The
    # stage is the subject of this page, so it must be the largest element.
    PREVIEW_CELL_MAX = 56       # a wide window must not give absurd LEDs
    PREVIEW_BAR_MAX = 84
    PREVIEW_BAR_MIN = 22
    PREVIEW_MARGIN = 16
    PREVIEW_MIN_HEIGHT = 150

    def _build_preview(self, parent):
        """A simulated strip, so an effect can be looked at before it is set."""
        outer = ttk.Frame(parent, style="Page.TFrame")

        # The stage keeps its dark background for each desktop theme. A user
        # reads a strip against a dark room and not against the theme. So the
        # stage is a raised panel and not a part of the page. It also expands.
        # This page is shorter than the tallest page, and the free space must
        # go somewhere. A dark room with a strip in the middle is a better use
        # of that space than an empty window.
        stage = self._card(outer, padding=10)
        stage.pack(fill="both", expand=True, padx=SIDE_MARGIN,
                   pady=(GROUP_GAP, ROW_GAP))
        self.preview_canvas = tk.Canvas(
            stage, height=self.PREVIEW_MIN_HEIGHT, highlightthickness=0,
            background=preview_module.BACKDROP)
        self.preview_canvas.pack(fill="both", expand=True)
        self.preview_canvas.bind("<Configure>", self._preview_layout)

        # Built once per strip length and only moved and recoloured
        # afterwards: creating four items per LED twenty-five times a second is
        # how a canvas gets slow. The coordinates are put in by
        # _preview_layout, which is the only place that knows how much room
        # there is.
        self._preview_items = []
        self._preview_leds(shim.LOGICAL_LEDS)

        # Page.Muted, not Muted: this line stands under the stage rather than
        # on it, so the card's ground behind it was a band of the wrong shade
        # the width of the words.
        self.preview_blurb = ttk.Label(outer, style="Page.Muted.TLabel")
        self.preview_blurb.pack(anchor="center", pady=(0, 8))

        picker = ttk.Frame(outer, style=self._ground(outer))
        picker.pack(fill="x", padx=SIDE_MARGIN)
        picker.columnconfigure(0, weight=1)
        picker.columnconfigure(1, weight=1)

        self.preview_choice = tk.StringVar(value="slot:" + render.SHOWS_FIRE)
        self.preview_choice.trace_add("write",
                                      lambda *_a: self._preview_chosen())

        # The title is no longer "in the rainbow slot". The slot holds these
        # four effects in Game Mode, and on the desktop each of them is a scene
        # of its own. A title with one of the two places makes a user of the
        # other place look for a heading that is not there.
        groups = (("Our effects", "slot"),
                  ("Notification shapes", "shape"))
        for column, (title, wanted) in enumerate(groups):
            box = ttk.Frame(picker, style=self._ground(picker))
            box.grid(row=0, column=column, sticky="nsew",
                     padx=(0, GROUP_GAP) if column == 0 else (GROUP_GAP, 0))
            ttk.Label(box, text=title, style="Page.Section.TLabel").pack(
                anchor="w", pady=(0, 4))
            for label, kind, name, _blurb in preview_module.entries():
                if kind != wanted:
                    continue
                # The surface below it, for the same reason as _ground. A radio
                # button paints its own background and its own indicator. Both
                # use a colour from the build step of the style. See the two
                # families in dress().
                ttk.Radiobutton(
                    box, text=label, value=kind + ":" + name,
                    variable=self.preview_choice,
                    style=("Page.TRadiobutton"
                           if self._ground(box) == "Page.TFrame"
                           else "TRadiobutton")).pack(anchor="w")

        # page=True: this one stands under the cards, not in one.
        self._note(
            outer,
            "Drawn by the same code that drives the strip, and on the strip "
            "you have: the length, the mapping, the direction and the "
            "brightness ceiling are the ones currently in this window, so "
            "moving any of them changes what you see here. Nothing is applied "
            "and the strip itself is not touched.",
            page=True).pack(anchor="w", padx=SIDE_MARGIN,
                            pady=(GROUP_GAP, GROUP_GAP))

        # This page is shorter than the tallest page, and the free space must
        # go somewhere. The stage takes one half and this frame takes the
        # other half. The space of the strip then grows with the window and
        # does not take all of the free space. With all of it, the strip
        # stood alone in the middle of a very large dark box.
        ttk.Frame(outer, style="Page.TFrame").pack(fill="both", expand=True)

        self._preview = preview_module.Preview()
        self._preview_job = None
        self._preview_started = None
        # The animation has a frame booked at all times while the page is up.
        # Closing the window would leave that one to fire at a callback that
        # no longer exists, which Tk reports as an invalid command name.
        self.root.bind("<Destroy>", self._stop_timers, add="+")
        self._preview_chosen()
        return outer

    def _stop_timers(self, event=None):
        """Drop what is booked, so nothing fires at a window that has gone.

        Each of them has work in the queue for most of the time. The preview has
        work while its page is open. The resize has work between a fold and the
        layout pass after it. The idle catch-up has work after a change. Tk
        reports a callback for a window that no longer exists as an invalid
        command name.
        """
        if event is not None and event.widget is not self.root:
            return                              # a child of ours, not the window
        for job in (self._preview_job, self._refit_job, self._catching_up,
                    getattr(self, "_cec_first", None),
                    getattr(self, "_gpu_first", None)):
            if job is not None:
                self.root.after_cancel(job)
        self._preview_job = self._refit_job = self._catching_up = None
        self._cec_first = self._gpu_first = None

    def _preview_chosen(self):
        """Restart the clock, so a shape is seen from its beginning."""
        for label, kind, name, blurb in preview_module.entries():
            if kind + ":" + name == self.preview_choice.get():
                self.preview_blurb.configure(text=blurb)
                break
        self._preview_started = time.monotonic()
        self._preview = preview_module.Preview()
        if self._preview_job is None and self._preview_visible():
            self._preview_tick()

    def _preview_leds(self, count):
        """Lay out this many LEDs, rebuilding the canvas if the number changed.

        The length of the strip is a setting, and this page must show the
        strip of the machine. So this function follows that slider and does
        not use a fixed number.
        """
        if count == len(self._preview_items):
            return
        self.preview_canvas.delete("all")
        self._preview_items = []
        for _index in range(count):
            halo = self.preview_canvas.create_rectangle(0, 0, 1, 1, width=0)
            body = self.preview_canvas.create_rectangle(0, 0, 1, 1, width=0)
            spill = [self.preview_canvas.create_rectangle(0, 0, 1, 1, width=0)
                     for _step in range(2)]
            self._preview_items.append((halo, body, spill))
        self._preview_layout()

    def _preview_layout(self, _event=None):
        """Lay the strip out for the room the canvas actually has.

        The width gives the size: seventeen LEDs across it, at each width.
        The strip is in the centre of the height, so it is in the middle of
        its dark room at each height of the page.
        """
        width = self.preview_canvas.winfo_width()
        height = self.preview_canvas.winfo_height()
        if width < 80 or height < 40:
            return                              # not laid out yet
        leds = len(self._preview_items)
        gap = max(4, width // 150)
        cell = min(self.PREVIEW_CELL_MAX,
                   (width - 2 * self.PREVIEW_MARGIN - (leds - 1) * gap) // leds)
        cell = max(4, cell)
        bar = min(self.PREVIEW_BAR_MAX, int(cell * 1.4))
        # The glow below the strip is what a real one throws onto the shelf it
        # stands on, so it is a share of the strip rather than a fixed depth.
        spill = max(5, bar // 4)
        span = leds * cell + (leds - 1) * gap
        first = (width - span) // 2
        top = max(6, (height - bar - spill * 2) // 2)

        # The halo grows with the LED rather than with the gap: it is the
        # bloom around a bright thing, so a bigger thing blooms further.
        edge = max(3, cell // 7)
        for index, (halo, body, spill_items) in enumerate(self._preview_items):
            left = first + index * (cell + gap)
            self.preview_canvas.coords(halo, left - edge, top - edge,
                                       left + cell + edge, top + bar + edge)
            self.preview_canvas.coords(body, left, top, left + cell, top + bar)
            for step, item in enumerate(spill_items):
                below = top + bar + 2 + step * spill
                self.preview_canvas.coords(item, left - edge, below,
                                           left + cell + edge, below + spill)

    def _preview_visible(self):
        return (getattr(self, "preview_tab", None) is not None
                and self.notebook.select() == str(self.preview_tab))

    def _preview_tick(self):
        """Draws one frame and schedules the next, while the tab is open.

        A window on another tab must not draw seventeen rectangles twenty-five
        times each second with no viewer.
        """
        self._preview_job = None
        if not self._preview_visible():
            return

        self._preview.settings = self._preview_settings()
        elapsed = time.monotonic() - self._preview_started
        kind, _, name = self.preview_choice.get().partition(":")
        if kind == "slot":
            pixels = self._preview.slot_frame(name, elapsed)
        else:
            pixels = self._preview.shape_frame(
                name, ledpanel.SHAPE_TEST_COLOUR, elapsed)

        self._preview_leds(len(pixels))
        for (halo, body, spill), pixel in zip(self._preview_items, pixels):
            self.preview_canvas.itemconfigure(
                body, fill=preview_module.hex_colour(pixel))
            self.preview_canvas.itemconfigure(
                halo, fill=preview_module.toward(pixel, 0.28))
            self.preview_canvas.itemconfigure(
                spill[0], fill=preview_module.toward(pixel, 0.22))
            self.preview_canvas.itemconfigure(
                spill[1], fill=preview_module.toward(pixel, 0.10))

        self._preview_job = self.root.after(1000 // self.PREVIEW_FPS,
                                            self._preview_tick)

    def _preview_settings(self):
        """The window's values as they stand, as far as they can be read.

        Deliberately not _collect(): that validates and puts a dialog up when
        it does not like something, and a preview redrawing twenty-five times
        a second is no place to find that out. Anything unreadable is simply
        left out, and Preview falls back to the shipped default.
        """
        values = {}
        for key, (variable, kind) in self.vars.items():
            try:
                raw = variable.get()
                values[key] = (bool(raw) if kind == "bool"
                               else int(round(raw)) if kind == "int"
                               else float(raw) if kind == "float"
                               else self._value_for(key, raw)
                               if kind in ("sensor", "named", "power", "theme")
                               else str(raw))
            except (ValueError, TypeError, KeyError, tk.TclError):
                continue
        return values

    def _buttons(self, parent, entries, style="Tonal.TButton", lead=0):
        """A row of buttons that wraps rather than running off the window.

        Six shape buttons in one row are wider than the minimum width of the
        window, and a row that packs to the left loses the last buttons. So
        this function uses a grid and counts the columns.

        The row starts with four buttons. This code measures the number that
        fits after the row has a width. See _relay_buttons. The columns are
        equal and they stretch. A button with a name that is longer than its
        column does not become narrower. The row cuts it, and "Wake the
        television" became "Wake the televisic".

        `lead` is the room above the row, for the places where it follows a
        column of settings rather than a paragraph.
        """
        row = ttk.Frame(parent, style=self._ground(parent))
        row.pack(fill="x", pady=(lead, 0))
        for column in range(self.BUTTONS_ACROSS):
            row.columnconfigure(column, weight=1, uniform="buttons")
        made = []
        for index, (label, command) in enumerate(entries):
            button = ttk.Button(row, text=label, style=style, command=command)
            button.grid(row=index // self.BUTTONS_ACROSS,
                        column=index % self.BUTTONS_ACROSS, sticky="ew",
                        padx=(0, ROW_GAP), pady=(0, ROW_GAP))
            made.append(button)
        self._button_rows.append((row, made))
        self._button_across[str(row)] = self.BUTTONS_ACROSS
        return row

    def _build_tests(self, parent):
        outer = ttk.Frame(parent, style="Page.TFrame")

        flashes = self._section(outer, "Flash the bar", first=True, card=True)
