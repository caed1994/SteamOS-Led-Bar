START_WIDTH = 1400
START_HEIGHT = 900
MIN_WIDTH = 1120
MIN_HEIGHT = 680
FIELD_RADIUS = material.SHAPE_EXTRA_SMALL

# The user selects a page from a list at the left, and not from a row of tabs
