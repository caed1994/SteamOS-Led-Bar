#!/usr/bin/env python3
"""Control panel for the SteamOS LED bar bridge.

Settings, tests and repair in one window. Installation stays with install.sh -
this is for everything after it, which is the part you do more than once.

Deliberately tkinter and nothing else: SteamOS has a read-only rootfs, so
anything installed with a package manager is gone at the next system update.
Only the standard library survives that.

Unprivileged. Flashing the bar and asking Steam questions need no rights at
all, and the two things that do - writing the config and restarting the
service - go through pkexec one prompt at a time.
"""

from __future__ import annotations

import os
import queue
import subprocess
import sys
import tempfile
import threading

HERE = os.path.dirname(os.path.abspath(__file__))
SOURCE_DIR = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(SOURCE_DIR, "server"))
sys.path.insert(0, HERE)

try:
    import tkinter as tk
    from tkinter import ttk, colorchooser, messagebox
except ImportError:                                         # pragma: no cover
    sys.exit(
        "This panel needs Python's tkinter, which is not installed.\n"
        "On SteamOS everything it does is also available from the terminal -\n"
        "see the README. To install it: sudo pacman -S tk\n"
        "(and remember a SteamOS update will remove it again).")

import kdetheme                                             # noqa: E402
import roundrect                                            # noqa: E402
import ledpanel                                             # noqa: E402
from steamos_led import config as config_module             # noqa: E402


# Which settings to show, in this order, and how. The bounds repeat what
# config.validate() enforces - it raises text rather than exposing numbers, and
# a slider needs the numbers. The validator stays the authority: everything is
# handed to it before it is written, so a disagreement here is caught, not
# shipped.
SETTINGS = [
    ("LED_COUNT", "LEDs on the strip", "int", 1, 1024),
    ("MAPPING", "Mapping of the 17 logical LEDs", "choice",
     config_module.MAPPINGS, None),
    ("REVERSE", "Flip the strip direction", "bool", None, None),
    ("MAX_BRIGHTNESS", "Maximum brightness", "int", 0, 255),
    ("MIN_BRIGHTNESS", "Minimum brightness", "int", 0, 255),
    ("GAMMA", "Gamma", "float", 0.1, 4.0),
    ("SPEED", "Effect speed", "float", 0.1, 4.0),
    ("PATROL_DOTS", "Patrol dots", "int", 1, 8),
    ("TEMPERATURE_GAUGE", "Show temperature instead of the rainbow", "bool",
     None, None),
    # The two marks are coupled - the bar has to fill over a span, not at a
    # point - and the ranges are kept apart so no combination of the two
    # sliders can produce a config the service refuses. Anything more exotic
    # than "starts somewhere under 70, full somewhere over 75" belongs in the
    # config file, which takes 0-150 for both.
    # Whole degrees: half a degree is below what a bar of 17 LEDs can show
    # anyway, and "85.38" reads like a measurement rather than a setting.
    ("TEMPERATURE_MIN", "Temperature: bar starts filling (C)", "int", 20, 70),
    ("TEMPERATURE_MAX", "Temperature: bar full (C)", "int", 75, 120),
    ("NOTIFY", "Flash on notifications", "bool", None, None),
    ("NOTIFY_MESSAGES", "Flash on friend messages", "bool", None, None),
    ("NOTIFY_DURATION", "Flash duration (seconds)", "float", 0.1, 60.0),
    ("NOTIFY_STYLE", "Flash shape", "choice", config_module.NOTIFY_STYLES, None),
    ("FPS", "Frames per second", "int", 1, 240),
    ("IDLE_FPS", "Frames per second when idle", "int", 1, 240),
    ("LOG_LEVEL", "Log level", "choice",
     ("debug", "info", "warning", "error"), None),
]


# PhotoImage objects are only alive while something references them; a widget
# element does not count, so an image that goes out of scope leaves the widget
# blank. They are parked here for the life of the window.
_IMAGES = []

TAB_RADIUS = 9
BOX_RADIUS = 10
BUTTON_RADIUS = 9
# Sizes are set for fingers and a trackpad, not for a mouse on a desk: this
# runs on a machine people also use handheld, where a hairline control is
# genuinely hard to hit. Everything here is comfortably above the ~20 px that
# desktop guidelines treat as the smallest sensible target.
CHECKBOX_SIZE = 24          # clam's own indicator is barely a quarter of this
TRACK_THICKNESS = 12        # the groove a slider runs in
KNOB_DIAMETER = 24          # thick enough to grab, round enough to read as a pill
ARROW_SIZE = 18             # the drop-down arrow, which clam draws tiny


def _photo(picture):
    """A list of pixel rows as a PhotoImage."""
    photo = tk.PhotoImage(width=len(picture[0]), height=len(picture))
    photo.put(roundrect.as_put_string(picture))
    _IMAGES.append(photo)
    return photo


def _rounded(width, height, radius, fill, background, border=None):
    return _photo(roundrect.rows(width, height, radius, fill, background,
                                 border=border,
                                 border_width=1 if border else 0))


def round_the_corners(style, palette, shade):
    """Replace the square widget parts with rounded pictures.

    ttk has no corner radius and no way to ask for one. It does have image
    elements: a part of a widget can be a picture, stretched with nine-slice
    scaling so the corners keep their shape while the middle grows. So the
    corners are drawn as pixels and handed over.

    Best effort - an older Tk that will not take image elements keeps the flat
    look rather than an unpainted window.
    """
    window, view = palette["window"], palette["view"]
    accent = palette["selection"]

    def tab(fill, background):
        # Square at the bottom and with no border along it: that edge is where
        # the tab meets the page, and a line there is precisely the stripe
        # that makes a row of tabs look struck through.
        return _photo(roundrect.rows(
            TAB_RADIUS * 2 + 4, 34, (TAB_RADIUS, TAB_RADIUS, 0, 0),
            fill, background, border=shade["border"], border_width=1,
            open_bottom=True))

    def box(fill, background, radius=BOX_RADIUS):
        return _rounded(radius * 2 + 4, radius * 2 + 4, radius, fill,
                        background, border=shade["border"])

    # Each group stands on its own: an older Tk that refuses one element
    # should leave that part flat, not everything after it as well.
    def attempt(what, build):
        try:
            build()
        except tk.TclError as exc:                          # pragma: no cover
            print("could not round %s: %s" % (what, exc), file=sys.stderr)

    def tabs():
        # --- tabs: rounded on top, square where they meet the page ---------
        style.element_create(
            "Rounded.Tab", "image", tab(shade["raised"], window),
            ("selected", tab(window, window)),
            ("active", tab(shade["hover"], window)),
            border=(TAB_RADIUS, TAB_RADIUS, TAB_RADIUS, 0),
            sticky="nsew", padding=(18, 8))
        style.layout("TNotebook.Tab", [
            ("Rounded.Tab", {"sticky": "nsew", "children": [
                ("Notebook.label", {"side": "top", "sticky": ""})]})])

    def page():
        style.element_create("Rounded.Client", "image", box(window, window),
                             border=BOX_RADIUS, sticky="nsew")
        style.layout("TNotebook", [
            ("Rounded.Client", {"sticky": "nsew"})])

    def boxes():
        style.element_create("Rounded.Box", "image", box(window, window),
                             border=BOX_RADIUS, sticky="nsew")
        style.layout("TLabelframe", [("Rounded.Box", {"sticky": "nsew"})])

    def buttons():
        def button_element(name, fill, hover, pressed):
            style.element_create(
                name, "image",
                _rounded(BUTTON_RADIUS * 2 + 4, 32, BUTTON_RADIUS, fill,
                         window, border=shade["border"]),
                ("pressed", _rounded(BUTTON_RADIUS * 2 + 4, 32, BUTTON_RADIUS,
                                     pressed, window, border=shade["border"])),
                ("active", _rounded(BUTTON_RADIUS * 2 + 4, 32, BUTTON_RADIUS,
                                    hover, window, border=shade["border"])),
                border=BUTTON_RADIUS, sticky="nsew", padding=(14, 7))

        button_element("Rounded.Button", palette["button"], shade["hover"],
                       accent)
        style.layout("TButton", [
            ("Rounded.Button", {"sticky": "nsew", "children": [
                ("Button.label", {"side": "top", "sticky": ""})]})])

        button_element("Accent.Button", accent,
                       kdetheme.mix(accent, "#ffffff", 0.18),
                       kdetheme.mix(accent, "#000000", 0.15))
        style.layout("Accent.TButton", [
            ("Accent.Button", {"sticky": "nsew", "children": [
                ("Button.label", {"side": "top", "sticky": ""})]})])

    def checkboxes():
        # clam's indicator is a few pixels of hairline - too small to hit and
        # too small to read. A drawn one can be any size; the tick is drawn
        # rather than taken from a font, which would depend on what happens to
        # be installed.
        size = CHECKBOX_SIZE

        def indicator(fill, edge, tick=None):
            picture = roundrect.rows(size, size, 5, fill, window,
                                     border=edge, border_width=1)
            if tick:
                roundrect.draw_check(picture, tick)
            return _photo(picture)

        style.element_create(
            "Rounded.Indicator", "image",
            indicator(view, shade["border"]),
            ("selected", indicator(accent, accent,
                                   palette["selection_text"])),
            ("active", indicator(shade["hover"], accent)),
            sticky="", padding=2)
        style.layout("TCheckbutton", [
            ("Checkbutton.padding", {"sticky": "nsew", "children": [
                ("Rounded.Indicator", {"side": "left", "sticky": ""}),
                ("Checkbutton.label", {"side": "left", "sticky": "w"})]})])

    def sliders():
        # A pill-shaped groove and a round knob.
        radius = TRACK_THICKNESS / 2.0

        # The groove is drawn inside an image as tall as the knob. ttk sizes
        # the widget from the trough element, so a groove-sized image would
        # crop a knob that is deliberately bigger than it.
        groove = roundrect.pill(TRACK_THICKNESS * 3, TRACK_THICKNESS, view,
                                window, border=shade["border"], border_width=1)
        padding = (KNOB_DIAMETER - TRACK_THICKNESS) // 2
        picture = [[window] * (TRACK_THICKNESS * 3)
                   for _ in range(KNOB_DIAMETER)]
        for offset, line in enumerate(groove):
            picture[padding + offset] = line
        track = _photo(picture)
        knob = _photo(roundrect.pill(KNOB_DIAMETER, KNOB_DIAMETER, accent,
                                     window, border=shade["border"],
                                     border_width=1))
        knob_hot = _photo(roundrect.pill(
            KNOB_DIAMETER, KNOB_DIAMETER,
            kdetheme.mix(accent, "#ffffff", 0.22), window,
            border=shade["border"], border_width=1))

        style.element_create("Pill.trough", "image", track,
                             border=(int(radius), 0, int(radius), 0),
                             sticky="ew", padding=0)
        style.element_create("Pill.slider", "image", knob,
                             ("active", knob_hot), sticky="")
        style.layout("Horizontal.TScale", [
            ("Pill.trough", {"sticky": "ew", "children": [
                ("Pill.slider", {"side": "left", "sticky": ""})]})])

    attempt("the tabs", tabs)
    attempt("the checkboxes", checkboxes)
    attempt("the page", page)
    attempt("the boxes", boxes)
    attempt("the buttons", buttons)
    attempt("the sliders", sliders)


def apply_theme(root):
    """Dress the window in whatever colours Plasma is using.

    ttk ships no theme that resembles a modern desktop, and it cannot ask one
    either - so the scheme is read from KDE's own config and painted on. clam
    is the base because it is the only built-in theme that honours colour
    options at all; the others draw fixed bitmaps.

    Returns the palette, so the parts tkinter styles cannot reach - the text
    pane, the status marks - can use the same colours.
    """
    palette = kdetheme.read()
    shade = kdetheme.derived(palette)
    dark = kdetheme.is_dark(palette)

    style = ttk.Style()
    try:
        style.theme_use("clam")
    except tk.TclError:                                     # pragma: no cover
        pass

    if palette["font"]:
        family, size = palette["font"]
        root.option_add("*Font", (family, size))
        style.configure(".", font=(family, size))
        heading = (family, size + 3, "bold")
    else:
        heading = ("TkDefaultFont", 13, "bold")

    root.configure(background=palette["window"])
    style.configure(".", background=palette["window"],
                    foreground=palette["window_text"],
                    fieldbackground=palette["view"],
                    bordercolor=shade["border"],
                    focuscolor=palette["selection"],
                    troughcolor=shade["raised"], relief="flat")
    style.configure("TFrame", background=palette["window"])
    style.configure("TLabel", background=palette["window"],
                    foreground=palette["window_text"])
    style.configure("Heading.TLabel", font=heading)
    style.configure("Muted.TLabel", foreground=shade["muted"])
    style.configure("Good.TLabel", foreground=palette["positive"])
    style.configure("Bad.TLabel", foreground=palette["negative"])

    style.configure("TLabelframe", background=palette["window"],
                    bordercolor=shade["border"])
    style.configure("TLabelframe.Label", background=palette["window"],
                    foreground=shade["muted"])

    style.configure("TButton", background=palette["button"],
                    foreground=palette["button_text"],
                    bordercolor=shade["border"], padding=(12, 6))
    style.map("TButton",
              background=[("pressed", palette["selection"]),
                          ("active", shade["hover"])],
              foreground=[("pressed", palette["selection_text"])])

    style.configure("Accent.TButton", background=palette["selection"],
                    foreground=palette["selection_text"])
    style.map("Accent.TButton",
              background=[("active", kdetheme.mix(palette["selection"],
                                                  "#ffffff", 0.15))])

    style.configure("TNotebook", background=palette["window"],
                    bordercolor=shade["border"], tabmargins=(2, 6, 2, 0))
    style.configure("TNotebook.Tab", background=shade["raised"],
                    foreground=shade["muted"], padding=(16, 8),
                    bordercolor=shade["border"])
    style.map("TNotebook.Tab",
              background=[("selected", palette["window"])],
              foreground=[("selected", palette["window_text"])],
              expand=[("selected", (0, 0, 0, 2))])

    style.configure("TCheckbutton", background=palette["window"],
                    foreground=palette["window_text"],
                    indicatorcolor=palette["view"])
    style.map("TCheckbutton",
              indicatorcolor=[("selected", palette["selection"])],
              background=[("active", palette["window"])])

    style.configure("TCombobox", fieldbackground=palette["view"],
                    background=palette["button"],
                    foreground=palette["view_text"],
                    arrowcolor=palette["window_text"],
                    bordercolor=shade["border"], padding=(8, 7),
                    arrowsize=ARROW_SIZE)
    # A read-only combobox draws its text as a *selection*, so without these
    # the label comes out in the selection colours - which is how it ended up
    # pale grey on pale grey and all but unreadable.
    style.map("TCombobox",
              fieldbackground=[("readonly", palette["view"]),
                               ("disabled", palette["window"])],
              foreground=[("readonly", palette["view_text"]),
                          ("disabled", shade["muted"])],
              selectbackground=[("readonly", palette["view"]),
                                ("focus", palette["view"])],
              selectforeground=[("readonly", palette["view_text"]),
                                ("focus", palette["view_text"])],
              arrowcolor=[("readonly", palette["window_text"])],
              bordercolor=[("focus", palette["selection"])])
    root.option_add("*TCombobox*Listbox.background", palette["view"])
    root.option_add("*TCombobox*Listbox.foreground", palette["view_text"])
    root.option_add("*TCombobox*Listbox.selectBackground",
                    palette["selection"])
    root.option_add("*TCombobox*Listbox.selectForeground",
                    palette["selection_text"])

    style.configure("Horizontal.TScale", background=palette["window"],
                    troughcolor=shade["raised"],
                    bordercolor=shade["border"])
    style.configure("TScrollbar", background=shade["raised"],
                    troughcolor=palette["window"],
                    bordercolor=shade["border"],
                    arrowcolor=palette["window_text"])

    round_the_corners(style, palette, shade)

    palette["_shade"] = shade
    palette["_dark"] = dark
    return palette


class Runner:
    """Runs a command without freezing the window.

    tkinter may only be touched from the thread that owns it, so the worker
    posts lines into a queue and the UI drains it on a timer.
    """

    def __init__(self, widget, sink):
        # sink(text, tag=None) - the tag is optional so a plain writer works.
        self.widget = widget
        self.sink = sink
        self.queue = queue.Queue()
        self.busy = False
        self.transcript = []
        self._drain()

    def start(self, command, done=None):
        if self.busy:
            self.sink("Still busy with the last command.\n")
            return False
        self.busy = True
        self.transcript = []
        self.sink("$ %s\n" % " ".join(command), "command")
        threading.Thread(target=self._work, args=(command, done),
                         daemon=True).start()
        return True

    def _work(self, command, done):
        try:
            process = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
        except OSError as exc:
            self.queue.put(("line", "cannot run: %s\n" % exc))   # noqa
            self.queue.put(("done", (1, done)))
            return
        for line in process.stdout:
            self.transcript.append(line)
            self.queue.put(("line", line))
        code = process.wait()
        self.queue.put(("done", (code, done)))

    def _drain(self):
        try:
            while True:
                kind, payload = self.queue.get_nowait()
                if kind == "line":
                    self.sink(payload)
                else:
                    code, done = payload
                    self.busy = False
                    self.sink("[exit %d]\n" % code, "command")
                    # pkexec's own complaint explains nothing to anyone who
                    # has not met it before; say what it means instead.
                    if ledpanel.looks_like_no_auth_agent(
                            "".join(self.transcript), code):
                        self.sink("\n%s\n" % ledpanel.NO_AGENT_ADVICE)
                    self.sink("\n")
                    if done is not None:
                        done(code)
        except queue.Empty:
            pass
        self.widget.after(120, self._drain)


class Panel:
    def __init__(self, root):
        self.root = root
        root.title("SteamOS LED bar")
        root.minsize(720, 640)

        self.palette = apply_theme(root)
        self.shade = self.palette["_shade"]
        self.config = self._load_config()
        self.vars = {}

        header = ttk.Frame(root)
        header.pack(fill="x", padx=16, pady=(14, 0))
        ttk.Label(header, text="SteamOS LED bar",
                  style="Heading.TLabel").pack(anchor="w")
        self.headline = ttk.Label(header, text="", style="Muted.TLabel")
        self.headline.pack(anchor="w", pady=(2, 0))

        notebook = ttk.Notebook(root)
        notebook.pack(fill="both", expand=True, padx=16, pady=(12, 0))

        self.output = self._build_output(root)
        self.runner = Runner(root, self._write)

        notebook.add(self._build_settings(notebook), text="  Settings  ")
        notebook.add(self._build_tests(notebook), text="  Test  ")
        notebook.add(self._build_status(notebook), text="  Status && repair  ")

        if ledpanel.in_game_mode():
            self._write(
                "Running in Game Mode. Flashing the bar and the Steam checks "
                "work here;\nchanging settings, the self-test and repairing "
                "need administrator rights,\nwhich only Desktop Mode can ask "
                "for.\n\n")

        self.refresh_status()

    # -- helpers ----------------------------------------------------------

    def _load_config(self):
        try:
            return config_module.load()
        except (config_module.ConfigError, OSError) as exc:
            messagebox.showwarning(
                "Configuration",
                "Could not read %s:\n%s\n\nShowing defaults instead."
                % (config_module.DEFAULT_CONFIG_PATH, exc))
            return dict(config_module.DEFAULTS)

    def _write(self, text, tag=None):
        self.output.configure(state="normal")
        self.output.insert("end", text, tag or ())
        self.output.see("end")
        self.output.configure(state="disabled")

    def _build_output(self, parent):
        frame = ttk.LabelFrame(parent, text="Output", padding=1)
        frame.pack(fill="both", expand=True, padx=16, pady=14)
        # tk.Text is not a themed widget, so its colours have to be set by
        # hand - and it is the one place a fixed-width font is right, because
        # everything landing here is command output.
        text = tk.Text(frame, height=9, wrap="word", state="disabled",
                       relief="flat", borderwidth=0, padx=10, pady=8,
                       background=self.palette["view"],
                       foreground=self.palette["view_text"],
                       insertbackground=self.palette["view_text"],
                       selectbackground=self.palette["selection"],
                       selectforeground=self.palette["selection_text"],
                       font=("TkFixedFont",))
        scroll = ttk.Scrollbar(frame, command=text.yview)
        text.configure(yscrollcommand=scroll.set)
        text.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")
        text.tag_configure("command", foreground=self.shade["muted"])
        return text

    # -- settings ---------------------------------------------------------

    def _build_settings(self, parent):
        outer = ttk.Frame(parent)
        grid = ttk.Frame(outer)
        grid.pack(fill="both", expand=True, padx=16, pady=16)
        grid.columnconfigure(1, weight=1)

        for row, (key, label, kind, low, high) in enumerate(SETTINGS):
            ttk.Label(grid, text=label).grid(row=row, column=0, sticky="w",
                                             pady=5, padx=(0, 14))
            value = self.config.get(key, config_module.DEFAULTS[key])

            if kind == "bool":
                variable = tk.BooleanVar(value=bool(value))
                ttk.Checkbutton(grid, variable=variable).grid(
                    row=row, column=1, sticky="w")
            elif kind == "choice":
                variable = tk.StringVar(value=str(value))
                ttk.Combobox(grid, textvariable=variable, values=list(low),
                             state="readonly", width=12).grid(
                                 row=row, column=1, sticky="w")
            else:
                variable = tk.DoubleVar(value=float(value))
                self._scale(grid, row, variable, kind, low, high)
            self.vars[key] = (variable, kind)

        buttons = ttk.Frame(outer)
        buttons.pack(fill="x", padx=16, pady=(0, 16))
        ttk.Button(buttons, text="Apply and restart service",
                   style="Accent.TButton",
                   command=self.apply_settings).pack(side="left")
        ttk.Button(buttons, text="Reload from file",
                   command=self.reload_settings).pack(side="left", padx=6)
        return outer

    def _scale(self, grid, row, variable, kind, low, high):
        holder = ttk.Frame(grid)
        holder.grid(row=row, column=1, sticky="ew")
        holder.columnconfigure(0, weight=1)
        readout = ttk.Label(holder, width=6)

        def show(*_args):
            value = variable.get()
            if kind == "int":
                # Snap to whole numbers, so the knob rests where the readout
                # says it is - ttk.Scale is continuous, and a slider showing
                # 40 while holding 40.38 is a slider that lies. The guard ends
                # the recursion: setting the variable calls this again, and
                # the second time round the value is already whole.
                whole = round(value)
                if abs(value - whole) > 1e-9:
                    variable.set(whole)
                    return
                readout.configure(text="%d" % whole)
            else:
                readout.configure(text="%.2f" % value)

        scale = ttk.Scale(holder, from_=low, to=high, variable=variable,
                          command=show)
        scale.grid(row=0, column=0, sticky="ew")
        readout.grid(row=0, column=1, padx=(6, 0))
        show()

    def _collect(self):
        """Widget values as the config wants them, validated."""
        values = {}
        for key, (variable, kind) in self.vars.items():
            raw = variable.get()
            values[key] = (bool(raw) if kind == "bool"
                           else int(round(raw)) if kind == "int"
                           else float(raw) if kind == "float"
                           else str(raw))
        # The two frame rates are coupled - the idle rate cannot exceed the
        # active one - and two independent sliders cannot express that. Pulling
        # FPS below IDLE_FPS is an obvious intention, so follow it and move the
        # other slider rather than refusing the adjustment.
        if values["IDLE_FPS"] > values["FPS"]:
            values["IDLE_FPS"] = values["FPS"]
            self.vars["IDLE_FPS"][0].set(float(values["FPS"]))
            self._write("Idle frame rate lowered to %d to stay under the "
                        "active rate.\n" % values["FPS"])

        merged = dict(self.config)
        merged.update(values)
        config_module.validate(merged)      # raises ConfigError
        return values

    def apply_settings(self):
        try:
            values = self._collect()
        except config_module.ConfigError as exc:
            messagebox.showerror("Not a usable setting", str(exc))
            return

        try:
            with open(config_module.DEFAULT_CONFIG_PATH) as handle:
                text = handle.read()
        except OSError:
            # No config yet: start from the one shipped in the repository so
            # its comments come along.
            shipped = os.path.join(SOURCE_DIR, "server",
                                   "steamos-led-serial.conf")
            try:
                with open(shipped) as handle:
                    text = handle.read()
            except OSError as exc:
                messagebox.showerror("Configuration", str(exc))
                return

        staged = tempfile.NamedTemporaryFile(
            "w", suffix=".conf", prefix="steamos-led-", delete=False)
        with staged:
            staged.write(config_module.update_text(text, values))
        os.chmod(staged.name, 0o644)

        def finished(code):
            os.unlink(staged.name)
            if code == 0:
                self.config.update(values)
            self.refresh_status()

        self.runner.start(
            ledpanel.apply_config_command(SOURCE_DIR, staged.name), finished)

    def reload_settings(self):
        self.config = self._load_config()
        for key, (variable, kind) in self.vars.items():
            value = self.config.get(key, config_module.DEFAULTS[key])
            variable.set(bool(value) if kind == "bool"
                         else str(value) if kind == "choice"
                         else float(value))
        self._write("Reloaded %s\n\n" % config_module.DEFAULT_CONFIG_PATH)

    # -- tests ------------------------------------------------------------

    def _build_tests(self, parent):
        outer = ttk.Frame(parent)
        flashes = ttk.LabelFrame(outer, text="Flash the bar")
        flashes.pack(fill="x", padx=10, pady=10)
        ttk.Label(
            flashes,
            text="Needs no privileges - the trigger pipe is open to anyone.",
        ).pack(anchor="w", padx=8, pady=(6, 2))

        row = ttk.Frame(flashes)
        row.pack(fill="x", padx=8, pady=(0, 8))
        for kind, label in (("achievement", "Achievement (gold)"),
                            ("message", "Friend message (purple)"),
                            ("warning", "Warning (orange)")):
            ttk.Button(row, text=label,
                       command=lambda k=kind: self.runner.start(
                           ledpanel.notify_command(k))).pack(side="left",
                                                             padx=(0, 6))
        ttk.Button(row, text="Pick a colour...",
                   command=self.flash_colour).pack(side="left")

        strip = ttk.LabelFrame(outer, text="Strip and Steam")
        strip.pack(fill="x", padx=10, pady=(0, 10))
        row = ttk.Frame(strip)
        row.pack(fill="x", padx=8, pady=8)
        ttk.Button(row, text="Self-test (stops the service briefly)",
                   command=lambda: self.runner.start(
                       ledpanel.self_test_command(SOURCE_DIR))).pack(
                           side="left", padx=(0, 6))
        ttk.Button(row, text="Steam check",
                   command=lambda: self.runner.start(
                       ledpanel.steam_check_command())).pack(side="left",
                                                             padx=(0, 6))
        ttk.Button(row, text="Message probe",
                   command=lambda: self.runner.start(
                       ledpanel.probe_messages_command())).pack(side="left",
                                                                padx=(0, 6))
        ttk.Button(row, text="Temperature sensors",
                   command=lambda: self.runner.start(
                       ledpanel.temperature_command())).pack(side="left")
        ttk.Label(
            strip,
            text="Steam check and the message probe need a game running.",
        ).pack(anchor="w", padx=8, pady=(0, 8))
        return outer

    def flash_colour(self):
        chosen = colorchooser.askcolor(title="Flash this colour")[1]
        if chosen:
            self.runner.start(ledpanel.notify_command(chosen))

    # -- status and repair ------------------------------------------------

    def _build_status(self, parent):
        outer = ttk.Frame(parent)
        self.summary = ttk.Label(outer, text="", wraplength=640,
                                 justify="left")
        self.summary.pack(anchor="w", padx=16, pady=(16, 10))

        self.checklist = ttk.Frame(outer)
        self.checklist.pack(fill="both", expand=True, padx=16)

        buttons = ttk.Frame(outer)
        buttons.pack(fill="x", padx=10, pady=10)
        ttk.Button(buttons, text="Check again",
                   command=self.refresh_status).pack(side="left")
        ttk.Button(buttons, text="Repair / reinstall",
                   style="Accent.TButton",
                   command=self.reinstall).pack(side="left", padx=8)
        ttk.Label(
            outer,
            text=("A SteamOS update replaces the kernel, and the LED module "
                  "has to be rebuilt for it. Repairing keeps your settings "
                  "and never touches the ESP."),
            wraplength=580, justify="left",
        ).pack(anchor="w", padx=10, pady=(0, 10))
        return outer

    def refresh_status(self):
        for child in self.checklist.winfo_children():
            child.destroy()
        checks = ledpanel.run_checks(config=self.config)
        summary = ledpanel.repair_summary(checks)
        self.summary.configure(
            text=summary,
            style="Good.TLabel" if not ledpanel.broken(checks)
            else "Bad.TLabel")
        self.headline.configure(text=summary)
        for row, check in enumerate(checks):
            ttk.Label(self.checklist, text="\u2713" if check.ok else "\u2717",
                      width=3, style="Good.TLabel" if check.ok
                      else "Bad.TLabel").grid(row=row, column=0, sticky="nw",
                                              pady=2)
            ttk.Label(self.checklist, text=check.name,
                      style="TLabel" if check.ok else "Bad.TLabel").grid(
                          row=row, column=1, sticky="w", pady=2)
            if not check.ok:
                ttk.Label(self.checklist, text=check.detail, wraplength=460,
                          justify="left", style="Muted.TLabel").grid(
                              row=row, column=2, sticky="w", pady=2)

    def reinstall(self):
        if not os.path.exists(os.path.join(SOURCE_DIR, "install.sh")):
            messagebox.showerror(
                "Repair",
                "install.sh is not next to this panel (%s).\nRepairing needs "
                "the cloned repository." % SOURCE_DIR)
            return
        if not messagebox.askokcancel(
                "Repair", "Re-run the installer?\n\nYour configuration is "
                          "kept and the ESP is not touched. This asks for "
                          "your password."):
            return
        self.runner.start(ledpanel.reinstall_command(SOURCE_DIR),
                          lambda _code: self.refresh_status())


def main():
    root = tk.Tk()
    try:
        ttk.Style().theme_use("clam")
    except tk.TclError:                                     # pragma: no cover
        pass
    Panel(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
