#!/usr/bin/env python3
"""Control panel for the SteamOS LED bar bridge.

Settings, tests and repair in one window. Installation stays with install.sh;
this is for everything after it, the part you do more than once.

Deliberately tkinter and nothing else: SteamOS has a read-only rootfs, so
anything a package manager installs is gone at the next system update. Only
the standard library survives that. Unprivileged except for writing the config
and restarting the service, which go through pkexec one prompt at a time.
"""

from __future__ import annotations

import os
import queue
import subprocess
import sys
import tempfile
import threading

HERE = os.path.dirname(os.path.abspath(__file__))
SOURCE_DIR = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(SOURCE_DIR, "server"))
sys.path.insert(0, HERE)

try:
    import tkinter as tk
    from tkinter import ttk, colorchooser, messagebox
except ImportError:                                         # pragma: no cover
    sys.exit(
        "This panel needs Python's tkinter, which is not installed.\n"
        "On SteamOS everything it does is also available from the terminal -\n"
        "see the README. To install it: sudo pacman -S tk\n"
        "(and remember a SteamOS update will remove it again).")

import kdetheme                                             # noqa: E402
import roundrect                                            # noqa: E402
import ledpanel                                             # noqa: E402
from steamos_led import config as config_module             # noqa: E402


# Which settings to show, in order: key, label, kind, and for numeric ones the
# two ends and the step. The bounds repeat what config.validate() enforces,
# which raises text where a slider needs numbers - but the validator stays the
# authority, so a disagreement here is caught rather than shipped. The step is
# what the slider can stop on, ttk.Scale being continuous whatever is drawn on
# it. Every range starts on a multiple of its step, so both ends are reachable.
SETTINGS = [
    # 120, not the 1024 the service accepts. Two limits meet there: the
    # GPIO14 firmware is built with MAX_LEDS=120 and rejects longer frames,
    # and 230400 baud carries about 125 LEDs at 60 fps. Past that the slider
    # would offer lengths that go dark or stutter. Longer strips are still a
    # config file away.
    ("LED_COUNT", "LEDs on the strip", "int", 1, 120, 1),
    ("REVERSE", "Flip the strip direction", "bool", None, None, None),
    ("MAX_BRIGHTNESS", "Maximum brightness", "int", 0, 255, 1),
    ("MIN_BRIGHTNESS", "Minimum brightness", "int", 0, 255, 1),
    ("PATROL_DOTS", "Patrol dots", "int", 1, 8, 1),
    ("TEMPERATURE_GAUGE", "Show temperature instead of the rainbow", "bool",
     None, None, None),
    # The two marks are coupled - the bar fills over a span, not at a point -
    # and the ranges are kept apart so no combination can produce a config the
    # service refuses. Anything more exotic belongs in the file, which takes
    # 0-150 for both. Whole degrees: half of one is below what 17 LEDs show,
    # and "85.38" reads like a measurement rather than a setting.
    ("TEMPERATURE_MIN", "Temperature: bar starts filling (C)", "int",
     20, 70, 1),
    ("TEMPERATURE_MAX", "Temperature: bar full (C)", "int", 75, 120, 1),
    # Not a "choice": the values are paths into /sys and the machine decides
    # what they are, so the menu is built from what it reports.
    ("TEMPERATURE_SENSOR", "Temperature sensor", "sensor", None, None, None),
    # The master switch: with this off nothing flashes at all, not even
    # --notify, because the trigger pipe is never opened.
    ("NOTIFY", "Flash on notifications", "bool", None, None, None),
    # Then one switch per thing worth watching for, each with the colour it
    # flashes underneath it, so the pair reads as one setting.
    ("NOTIFY_ACHIEVEMENTS", "Flash on achievements", "bool", None, None, None),
    ("ACHIEVEMENT_COLOR", "Achievement colour", "named",
     ledpanel.ACHIEVEMENT_COLOURS, None, None),
    ("NOTIFY_MESSAGES", "Flash on friend messages", "bool", None, None, None),
    ("MESSAGE_COLOR", "Friend message colour", "named",
     ledpanel.MESSAGE_COLOURS, None, None),
    # From half a second: the validator allows a tenth, but the flash grows,
    # breathes and retracts, none of which is visible in that.
    ("NOTIFY_DURATION", "Flash duration (seconds)", "float", 0.5, 60.0, 0.5),
    ("NOTIFY_STYLE", "Flash shape", "choice", config_module.NOTIFY_STYLES,
     None, None),
]

# Set once and left alone: the defaults suit a 17 LED bar on the shipped
# firmware, and each of these is a knob you turn because something specific is
