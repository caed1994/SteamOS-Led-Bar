    ("GAMMA", "Gamma", "float", 0.1, 4.0, 0.1),
    ("SPEED", "Effect speed", "float", 0.1, 4.0, 0.1),
    # Whole seconds: this is "how long before the bar mentions it again",
    # which nobody thinks about in halves.
    ("NOTIFY_REPEAT_GAP", "Quiet time before the same flash repeats (s)",
