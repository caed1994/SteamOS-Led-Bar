# rather than the command's own last line, and the reason is that half a
# sentence is worse than none: the line shares a bar with two indicators and
# the version, so a real error had to be cut to fit - and what got cut was the
# end, which is the part that says what went wrong. A pointer that is always
# whole beats a reason that is sometimes truncated.
#
# The reason itself is not lost. It goes to stderr like everything else the
# window's commands print, which is what this sentence is pointing at.
PROBLEM_TEXT = ("A command failed. Start the panel from a terminal to see "
                "why.")

# What a vertical scrollbar takes off the side of a page. Measured on the
# built window at this theme's own metrics; a couple of pixels over, because
# being generous here costs a slightly narrower paragraph and being short
# costs a sentence with its last word cut off. See Panel._rewrap.
SCROLLBAR_ROOM = 16

# How wide a page's content is allowed to get, whatever the monitor is. These
# pages are a column of label-and-control, and a column read past about this
# width stops being one: the label is at one end of the eye's travel and the
# thing it names at the other. On a 2560 monitor the slack goes to the margin.
CONTENT_MAX = 1040

# What the window opens at, and the smallest it may be dragged to.
#
# Sized for the monitors this is actually used on now - 1920x1080 and
# 2560x1440 - rather than for the 1280x800 of the machine itself, which is
# where Game Mode runs and where this window is not the thing on screen.
# The width is the sidebar, the inner list, a full content column and the
# margins between them; anything narrower and the two lists crowd the settings
# they are there to reach.
# How wide a paragraph inside a card may run. The card is CONTENT_MAX at its
# widest and has padding on both sides, so a paragraph that wrapped at
# CONTENT_MAX would have its last words drawn past the card's own edge.
# In material.SPACE rather than in GROUP_GAP, which is four of these and is
# defined further down this file - a constant cannot use one declared after it.
CARD_WRAP = CONTENT_MAX - 24 * material.SPACE

START_WIDTH = 1400
START_HEIGHT = 900
MIN_WIDTH = 1120
MIN_HEIGHT = 680
FIELD_RADIUS = material.SHAPE_EXTRA_SMALL

# The pages are picked from a list down the left rather than a row of tabs
# along the top, which is what Material suggests once there are more
# destinations than a row wants to carry - and six is over that line. The
# height of one entry, which is also the diameter of the pill behind it.
RAIL_HEIGHT = 40

# How wide a switch and a radio's ring stand from the label beside them. Drawn
# into the picture, because the label is a separate element and ttk puts the
# two flush.
RADIO_GAP = 8
ARROW_SIZE = 18             # the drop-down arrow, which clam draws tiny

# One width for every drop-down on a settings page, so a column of them has an
# edge rather than a ragged one. The sensor menu is the exception it has to be:
# its entries are paths into /sys, and cutting one off defeats the point of
# being able to see which sensor was picked.
MENU_WIDTH = 18
SENSOR_WIDTH = 30
# The columns of a settings grid: name, the control, and - for a notification -
# the colour and shape beside it. The last one holds the slack, so the three
# control columns stand together rather than being spread across the window.
CONTROL_COLUMN = 1
COLOUR_COLUMN = 2
SHAPE_COLUMN = 3
# A control standing on its own spans all three, so it neither widens the
# switch column - which would push the colours away from the switches they
# belong to - nor has to fit inside it.
CONTROL_SPAN = 3
# What separates a switch from the colour that belongs to it. On the colour
# column rather than on the switch, so the tabs that have no such column are
# untouched by it.
LOOK_GAP = 24
# Narrower than a settings menu: these two stand in a row of three controls
# rather than alone, and their entries are short words.
COLOUR_WIDTH = 15
SHAPE_WIDTH = 16
# The branch field, which stands in a row of buttons rather than a column of
# settings. Wide enough for a long branch name without pushing the two update
# buttons off a narrow window.
BRANCH_WIDTH = 22

# The square of colour a menu entry carries when what it holds is a colour.
SWATCH_SIZE = 16
SWATCH_GAP = 7              # drawn beside it, where the name goes
_COLOUR = re.compile(r"^#[0-9a-fA-F]{6}$")
DETAILS_GAP = 10            # under the checklist, and part of what it costs

# What to leave for the titlebar and whatever panel the desktop has, when
# deciding how tall the window may open.
SCREEN_ALLOWANCE = 120

# How wide a message in a dialog is allowed to run before it wraps. Wide
# enough for a path, narrow enough that a sentence is not one line.
DIALOG_WRAP = 460


# Everything else a control measures is worked out from the desktop's own font
# - see material.control_sizes, and the note there on why a fixed size is
# wrong. Sized for fingers and a trackpad rather than a mouse on a desk: this
# runs on a machine people also use handheld.

# The 4dp grid Material spaces everything on, in the amounts this window needs.
# The gap between groups is what replaces the boxes that used to be drawn round
# them, so it is deliberately larger than any gap inside one.
SIDE_MARGIN = 4 * material.SPACE

# How wide the switch column on the CEC page is, so a feature's sentence lines
# up under its own label rather than under the switch.
CEC_INDENT = 9 * material.SPACE
GROUP_GAP = 6 * material.SPACE
ROW_GAP = 2 * material.SPACE
INDENT_STEP = 5 * material.SPACE

# What one settings row keeps above and below its control, and the extra a row
# gets when it starts a new block - the switch that a stepped-in pair hangs
# off. With every control the same height, that extra is the only thing saying
# where one block ends and the next begins.
# Six a side, so twelve between one control and the next - Material's own
# spacing for a list of them. Four left two filled shapes forty pixels tall
# looking glued together, which is what a switch above a drop-down was.
ROW_PAD = 6
BLOCK_GAP = 4 * material.SPACE

# The type scale, as offsets from whatever size the desktop is set to. Material
# has fifteen sizes; a window this size needs four, and the weights matter more
# than the sizes do.
TYPE_HEADLINE = 6
TYPE_SECTION = 0
TYPE_SUPPORT = -1

# The window is dark whatever the desktop is, and only the *accent* follows.
#
# Not a preference, and the two halves of that are deliberate. This is a panel
# for a machine that spends its life on a television in a dark room, and the
# one thing every screenshot of it is judged against is the bar it is
# configuring - a strip of light. A light window round a preview of lit LEDs
# is the preview washed out.
#
# The accent still comes from Plasma, because that part of following the
# desktop is the part that says whose machine this is - see kdetheme. What is
# given up is the light/dark half of it, which is why this is one name in one
# place rather than a condition spread through the styles.
DARK = True


def _decimals(step):
    """How many decimals a step needs: 1 -> 0, 0.5 -> 1, 0.05 -> 2."""
    return len(("%g" % step).partition(".")[2])


def _photo(picture, keep=True):
    """A list of pixel rows as a PhotoImage.

    `keep` parks it in _IMAGES for the window's life, which is what a style
    element needs. A swatch says no and is held by the widget wearing it
    instead: those are drawn again whenever the widget's shade moves, and a
    list that only ever grew would collect one image per hover.
    """
    photo = tk.PhotoImage(width=len(picture[0]), height=len(picture))
    photo.put(roundrect.as_put_string(picture))
    if keep:
        _IMAGES.append(photo)
    return photo


def _slice(radius, fill, background, border=None, width=1):
    """A rounded rectangle sized to be stretched by nine-slice scaling.

    Only the corners of these are ever seen: ttk keeps a square of `radius` at
    each one and stretches what is between them, so one picture serves a button
    of any width.
    """
    return _photo(roundrect.rows(radius * 2 + 4, radius * 2 + 4, radius, fill,
                                 background, border=border,
                                 border_width=width if border else 0))


def dress(style, roles, sizes):
    """Replace the parts ttk draws square and flat with Material ones.

    Best effort throughout: an older Tk that will not take image elements keeps
    the plain look rather than leaving an unpainted window, and each group
    stands on its own so one refusal does not take the rest with it.
    """
    surface = roles["surface"]
    # The ground a card's own corners are drawn against - see apply_theme.
    page = roles["_page"]
    # style name -> the colour that style's picture has baked into its own
    # corners. A nine-slice keeps its corners whatever it is stretched over,
    # so a widget wearing one has to stand on a parent of exactly this colour
    # or the corners show as a box. Recorded here rather than reasoned about
    # later: the mistake is invisible in the source and obvious on screen, and
    # it has been made four times. See the live test that walks it.
    grounds = roles["_grounds"] = {}

    def wash(container, content, amount):
        """A state layer: the content colour laid over its container."""
        return material.blend(roles[container], roles[content], amount)

    def attempt(what, build):
        try:
            build()
        except tk.TclError as exc:                          # pragma: no cover
            print("could not draw %s: %s" % (what, exc), file=sys.stderr)

    def rail():
        """The list down the left that picks a page.

        Which one is open is said by a filled pill behind its name - the same
        tone a raised container would take, in the shape a button would take.

        Every picture here is drawn against the *card* the list stands on
        rather than against the page. A nine-slice image carries its own
        corners, and a corner painted against the wrong ground is a pale notch
        at each end of every entry - which is what the list looked like the
        moment it was given a card to sit on.
        """
        radius = RAIL_HEIGHT // 2
        ground = surface
        grounds["Rail.TRadiobutton"] = ground

        style.element_create(
            "Material.Rail", "image", _slice(radius, ground, ground),
            ("selected", "active",
             _slice(radius, material.blend(roles["secondary_container"],
                                           roles["on_surface"],
                                           material.STATE_HOVER), ground)),
            ("selected", _slice(radius, roles["secondary_container"], ground)),
            ("active", _slice(radius, material.blend(
                ground, roles["on_surface"], material.STATE_HOVER), ground)),
            border=radius, sticky="nsew", padding=(18, 10))
        style.layout("Rail.TRadiobutton", [
            ("Material.Rail", {"sticky": "nsew", "children": [
                ("Radiobutton.label", {"side": "left", "sticky": "w"})]})])
        # An empty layout is what takes the notebook's own tab row out: the
        # pages stay, the events stay, only the row nobody is using goes.
        style.layout("TNotebook.Tab", [])

    def panels():
        # The one raised surface in the window: a tone up from the page, no
        # line round it. Used where the content is not a ttk widget and so
        # cannot take a background of its own - the log and the preview stage.
        style.element_create(
            "Material.Panel", "image",
            _slice(CARD_RADIUS, surface, page),
            border=CARD_RADIUS, sticky="nsew")
        style.layout("Card.TFrame", [("Material.Panel", {"sticky": "nsew"})])
        grounds["Card.TFrame"] = page

    def buttons():
        def variant(name, fill, over, outline=None, sides=20):
            grounds[name.replace(".Button", ".TButton")] = roles[over]

            def picture(colour, edge=outline):
                return _slice(BUTTON_HEIGHT // 2, colour, roles[over],
                              border=edge)

            style.element_create(
                name, "image", picture(fill),
                # Disabled first: it has to win over hover, or a button you
                # cannot press lights up under the pointer as if you could.
                ("disabled", picture(material.disabled_container(roles),
                                     None)),
                ("pressed", picture(material.blend(fill, roles["on_surface"],
                                                   material.STATE_PRESSED))),
                ("active", picture(material.blend(fill, roles["on_surface"],
                                                  material.STATE_HOVER))),
                # The padding lives on the element, not on the style: an
                # image element's own padding wins, so configuring it later
                # changes nothing at all.
                border=BUTTON_HEIGHT // 2, sticky="nsew", padding=(sides, 8))

        # Material's four weights of button, which is how a row of them says
        # which one you probably want: filled for the action the page is for,
        # tonal for the ones beside it, outlined and text for the rest.
        variant("Filled.Button", roles["primary"], "surface")
        variant("Tonal.Button", roles["secondary_container"], "surface")
        variant("Outlined.Button", surface, "surface", outline=roles["outline"])
        # A text button stands among text and lines up with it; the padding a
        # filled button needs would hang it off to the right of everything.
        variant("Text.Button", surface, "surface", sides=2)
        # And again for a button standing on the page rather than on a card -
        # every weight the page uses, not only the ones whose fill *is* their
        # ground. A nine-slice keeps its own corners whatever the fill is, so
        # a filled button standing on the page had a square of the card's
        # colour behind its pill, which is exactly what it looked like.
        variant("Page.Filled.Button", roles["primary"], "_page")
        variant("Page.Tonal.Button", roles["secondary_container"], "_page")
        variant("Page.Outlined.Button", page, "_page", outline=roles["outline"])
        for name in ("Filled", "Tonal", "Outlined", "Text",
                     "Page.Filled", "Page.Tonal", "Page.Outlined"):
            style.layout("%s.TButton" % name, [
                ("%s.Button" % name, {"sticky": "nsew", "children": [
                    ("Button.label", {"side": "top", "sticky": ""})]})])
        grounds["TButton"] = surface        # wears Tonal's picture
        style.layout("TButton", [
            ("Tonal.Button", {"sticky": "nsew", "children": [
                ("Button.label", {"side": "top", "sticky": ""})]})])

    def switches():
        width, height = sizes["switch_width"], sizes["switch_height"]

        def picture(track, edge, thumb, radius, on, tick=None):
            rows = roundrect.rows(width, height, height / 2.0, track, surface,
                                  border=edge, border_width=2 if edge else 0)
            middle = height / 2.0
            across = (width - middle) if on else middle
            roundrect.draw_disc(rows, across, middle - 0.5, radius, thumb)
            if tick:
                roundrect.draw_check(
                    rows, tick, thickness=1.8,
                    box=(across - radius, middle - 0.5 - radius,
                         radius * 2, radius * 2))
            return _photo(rows)

        def off(track, edge, thumb):
            return picture(track, edge, thumb, sizes["thumb_off"], False)

        def on(track, thumb, tick):
            return picture(track, None, thumb, sizes["thumb_on"], True, tick)

        style.element_create(
            "Material.Switch", "image",
            off(roles["surface_container_highest"], roles["outline"],
                roles["outline"]),
            # A greyed-out switch still has to say whether it is on: the
            # setting it governs is off, which is not the same as this one
            # being off.
            ("disabled", "selected",
             on(material.disabled(roles, roles["primary"]),
                material.disabled(roles, roles["on_primary"]),
                material.disabled(roles, roles["primary"]))),
            ("disabled",
             off(material.disabled_container(roles),
                 material.disabled(roles, roles["outline"]),
                 material.disabled(roles, roles["outline"]))),
            ("selected", "active",
             on(material.blend(roles["primary"], roles["on_primary"],
                               material.STATE_HOVER),
                roles["on_primary"], roles["primary"])),
            ("selected", on(roles["primary"], roles["on_primary"],
                            roles["primary"])),
            ("active", off(wash("surface_container_highest", "on_surface",
                                material.STATE_HOVER),
                           roles["outline"], roles["on_surface_variant"])),
            # No padding: the widget is then exactly as tall as the picture,
            # which is what puts a switch and a drop-down on the same height
            # and gives every row in the column the same air around it.
            sticky="", padding=0)
        style.layout("TCheckbutton", [
            ("Checkbutton.padding", {"sticky": "nsew", "children": [
                ("Material.Switch", {"side": "left", "sticky": ""}),
                ("Checkbutton.label", {"side": "left", "sticky": "w"})]})])

    def radios():
        size = sizes["radio"]

        def picture(ring, dot=None, ground=None):
            # Wider than it is tall: the label beside it is a separate element
            # and ttk puts them flush, so the gap has to be part of the
            # picture or the text sits against the ring.
            ground = ground or surface
            rows = [[ground] * (size + RADIO_GAP) for _ in range(size)]
            middle = (size - 1) / 2.0
            roundrect.draw_ring(rows, middle, middle, size / 2.0 - 1.0, 2.0,
                                ring)
            if dot:
                roundrect.draw_disc(rows, middle, middle, size / 4.0, dot)
            return _photo(rows)

        style.element_create(
            "Material.Radio", "image", picture(roles["on_surface_variant"]),
            ("disabled", "selected",
             picture(material.disabled(roles, roles["primary"]),
                     material.disabled(roles, roles["primary"]))),
            ("disabled", picture(material.disabled(roles,
                                                   roles["on_surface"]))),
            ("selected", picture(roles["primary"], roles["primary"])),
            ("active", picture(roles["on_surface"], None,
                               wash("surface", "on_surface",
                                    material.STATE_HOVER))),
            sticky="", padding=2)
        style.layout("TRadiobutton", [
            ("Radiobutton.padding", {"sticky": "nsew", "children": [
                ("Material.Radio", {"side": "left", "sticky": ""}),
                ("Radiobutton.label", {"side": "left", "sticky": "w"})]})])

    def sliders():
        # A pill-shaped groove and a round knob.
        thickness, diameter = sizes["track"], sizes["knob"]
        radius = thickness / 2.0

        # Drawn inside an image as tall as the knob: ttk sizes the widget from
        # the trough, so a groove-sized one would crop the larger knob.
        groove = roundrect.pill(thickness * 3, thickness,
                                roles["surface_container_highest"], surface,
                                border_width=0)
        padding = (diameter - thickness) // 2
        rows = [[surface] * (thickness * 3) for _ in range(diameter)]
        rows[padding:padding + thickness] = groove

        def knob(colour):
            return _photo(roundrect.pill(diameter, diameter, colour, surface,
                                         border_width=0))

        # The two names end in "trough" and "slider" because ttk::scale finds
        # them by that suffix: it is what tells the widget which element to
        # move as the value changes. Named anything else the scale still draws,
        # and the knob sits at the left whatever the setting is - which is a
        # slider that lies about every value on the tab.
        style.element_create("Material.trough", "image", _photo(rows),
                             border=(int(radius), 0, int(radius), 0),
                             sticky="ew", padding=0)
        style.element_create(
            "Material.slider", "image", knob(roles["primary"]),
            ("disabled", knob(material.disabled(roles, roles["primary"]))),
            ("active", knob(material.blend(roles["primary"],
                                           roles["on_surface"],
                                           material.STATE_HOVER))),
            sticky="")
        style.layout("Horizontal.TScale", [
            ("Material.trough", {"sticky": "ew", "children": [
                ("Material.slider", {"side": "left", "sticky": ""})]})])

    def arrows():
        # One mark for every drop-down, drawn rather than left to clam - whose
        # own is a filled triangle half the height of the field, from the same
        # decade as its 3D edges.
        def picture(colour):
            rows = [[surface] * ARROW_SIZE for _ in range(ARROW_SIZE)]
            roundrect.draw_chevron(rows, colour, thickness=1.9)
            return _photo(rows)

        muted = roles["on_surface_variant"]
        style.element_create(
            "Material.Arrow", "image", picture(muted),
            ("disabled", picture(material.disabled(roles, muted))),
            sticky="")

    def fields():
        # Material's outlined field: a thin edge that thickens and takes the
        # accent when the field has the focus.
        def picture(edge, width=1, fill=None):
            return _slice(FIELD_RADIUS, fill or surface, surface, border=edge,
                          width=width)

        style.element_create(
            "Material.Field", "image", picture(roles["outline"]),
            ("disabled", picture(material.disabled(roles, roles["outline"]),
                                 fill=material.disabled_container(roles))),
            ("focus", picture(roles["primary"], width=2)),
            ("hover", picture(roles["on_surface"])),
            border=FIELD_RADIUS, sticky="nsew")
        # The same field around a typed-in one.
        style.layout("Material.TEntry", [
            ("Material.Field", {"sticky": "nsew", "children": [
                ("Entry.padding", {"sticky": "nsew", "children": [
                    ("Entry.textarea", {"sticky": "nsew"})]})]})])
        # The same field around the button a drop-down is: it opens a list of
        # our own drawing rather than a tk.Menu - see Popup - so what is
        # wanted here is a field with a label and an arrow in it.
        style.layout("Field.TButton", [
            ("Material.Field", {"sticky": "nsew", "children": [
                ("Material.Arrow", {"side": "right", "sticky": ""}),
                ("Button.padding", {"expand": 1, "sticky": "nsew",
                                    "children": [
                                        ("Button.label",
                                         {"sticky": "w"})]})]})])

    attempt("the rail", rail)
    attempt("the panels", panels)
    attempt("the buttons", buttons)
    attempt("the switches", switches)
    attempt("the radio buttons", radios)
    attempt("the sliders", sliders)
    attempt("the arrows", arrows)
    attempt("the fields", fields)


# One ttk theme per dressing, counted rather than named after the look: the
# same look can be applied twice in a session - dark, light, dark - and the
# second pass needs a namespace the first one is not still holding.
_THEMES_MADE = itertools.count()
_THEME_NAME = [None]


def _theme_name(fresh=False):
    if fresh or _THEME_NAME[0] is None:
        _THEME_NAME[0] = "material%d" % next(_THEMES_MADE)
    return _THEME_NAME[0]


def wants_dark(mode, desktop):
    """Whether to build a dark scheme, given the setting and the desktop.

    The one place the three answers become two. Dark and light say so; the
    third asks the desktop, which is what this window did before its look was
    rebuilt around a dark one.
    """
    if mode == appsettings.THEME_LIGHT:
        return False
    if mode == appsettings.THEME_SYSTEM:
        return kdetheme.is_dark(desktop)
    return True


def apply_theme(root, mode=appsettings.THEME_DARK):
    """Dress the window in Material 3, seeded from the desktop's accent.

    ttk ships no theme resembling a modern desktop and cannot ask one either,
    so the scheme is worked out and painted on. clam is the base: the only
    built-in theme that honours colour options rather than drawing fixed
    bitmaps. Returns the roles, for the parts ttk cannot reach.

    Called again whenever the look changes, which is why each call works in a
    ttk theme of its own. Element names are per theme and cannot be redefined
    within one: a second pass over the same theme raises "Duplicate element"
    for every picture in dress() - and dress swallows what it cannot draw, so
    the window would have kept its old colours and said nothing.
    """
    desktop = kdetheme.read()
    roles = material.scheme(desktop["selection"],
                            dark=wants_dark(mode, desktop),
                            error=desktop["negative"],
                            positive=desktop["positive"])
    surface = roles["surface"]
    on_surface = roles["on_surface"]
    variant = roles["on_surface_variant"]
    # The desk the cards lie on. Every widget in this window keeps `surface`
    # as its ground - which is what keeps the pictures ttk draws correct,
    # since each of them has its background baked into its own corners - and
    # the *page* behind them is the tone that differs. The other way round
    # would mean a second copy of every style and a second set of pictures.
    page = roles["_page"] = roles["surface_container"]

    style = ttk.Style()
    try:
        style.theme_create(_theme_name(fresh=True), parent="clam")
        style.theme_use(_theme_name())
    except tk.TclError:                                     # pragma: no cover
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

    family, size = desktop["font"] or ("TkDefaultFont", 10)
    root.option_add("*Font", (family, size))
    style.configure(".", font=(family, size))
    # Every control's height comes from what the font actually measures, so a
    # switch, a slider and a drop-down stand the same height as each other on
    # any desktop - which is what a column of settings needs before any amount
    # of spacing between the rows can look regular.
    sizes = material.control_sizes(
        tkfont.Font(root, font=(family, size)).metrics("linespace"))

    root.configure(background=page)
    # One background for the whole window. Material tells groups apart by
    # spacing and a heading rather than by a box round each, which is what
    # keeps a page of thirty settings from reading as thirty compartments -
    # and it means no widget has to be told which container it is standing on.
    style.configure(".", background=surface, foreground=on_surface,
                    fieldbackground=surface, bordercolor=roles["outline"],
                    focuscolor=roles["primary"],
                    troughcolor=roles["surface_container_highest"],
                    relief="flat", borderwidth=0)
    style.configure("TFrame", background=surface)
    # The few things that stand on the page rather than on a card: the header,
    # the status bar, the row of buttons under the pages. Named variants
    # rather than a second theme, and only a background - everything else
    # cascades from the style each is derived from.
    #
    # Written out one by one rather than looped, like the buttons below: a
    # style name that only ever appears in a variable is a name nothing can
    # check, and a misspelled one is the quietest bug ttk has.
    style.configure("Page.TFrame", background=page)
    style.configure("Page.Muted.TLabel", background=page)
    style.configure("Page.Heading.TLabel", background=page)
    style.configure("Page.Good.TLabel", background=page)
    style.configure("Page.Bad.TLabel", background=page)
    style.configure("Card.TFrame", background=surface)
    # The same tone, and no corners. For a frame that stands *on* a card
    # rather than being one: a Card.TFrame inside a Card.TFrame draws its own
    # rounded rectangle, and that picture's corners are painted against the
    # page - so a nested one puts four notches of the page's colour on top of
    # the card underneath it. The layout is left alone here, which is what
    # keeps it flat; see panels() in dress, where Card.TFrame gets its image.
    style.configure("OnCard.TFrame", background=surface)
    style.configure("TLabel", background=surface, foreground=on_surface)
    style.configure("Heading.TLabel", font=(family, size + TYPE_HEADLINE))
    # A group's name, in the accent: it is the one place colour is used to
    # organise rather than to decorate, and it lets the boxes go away.
    style.configure("Section.TLabel", foreground=roles["primary"],
                    font=(family, size + TYPE_SECTION, "bold"))
    style.configure("Muted.TLabel", foreground=variant,
                    font=(family, size + TYPE_SUPPORT))
    style.configure("Good.TLabel", foreground=roles["positive"])
    style.configure("Bad.TLabel", foreground=roles["error"])
    style.configure("TSeparator", background=roles["outline_variant"])

    # Material's four weights of button. Written out one by one rather than
    # looped: a style name that only ever appears in a variable is a name
    # nothing can check, and a misspelled one is the quietest bug ttk has -
    # the widget keeps the default look and nothing is reported.
    def button(fill, text, sides=20):
        return dict(background=roles[fill], foreground=roles[text],
                    padding=(sides, 8), anchor="center")

    def label_fades(text):
        # Setting a map replaces clam's own, so without this the label of a
        # disabled button keeps its full colour.
        return dict(foreground=[("disabled",
                                 material.disabled(roles, roles[text]))])

    style.configure("TButton", **button("secondary_container",
                                        "on_secondary_container"))
    style.map("TButton", **label_fades("on_secondary_container"))
    style.configure("Filled.TButton", **button("primary", "on_primary"))
    style.map("Filled.TButton", **label_fades("on_primary"))
    style.configure("Tonal.TButton", **button("secondary_container",
                                              "on_secondary_container"))
    style.map("Tonal.TButton", **label_fades("on_secondary_container"))
    style.configure("Outlined.TButton", **button("surface", "primary"))
    style.configure("Page.Filled.TButton", **button("primary", "on_primary"))
    style.map("Page.Filled.TButton", **label_fades("on_primary"))
    style.configure("Page.Tonal.TButton", **button("secondary_container",
                                                   "on_secondary_container"))
    style.map("Page.Tonal.TButton", **label_fades("on_secondary_container"))
    style.configure("Page.Outlined.TButton", **button("_page", "primary"))
    style.map("Page.Outlined.TButton", **label_fades("primary"))
    style.map("Outlined.TButton", **label_fades("primary"))
    style.configure("Text.TButton", **button("surface", "primary", sides=2))
    style.map("Text.TButton", **label_fades("primary"))

    # On the page: a notebook is the stack the pages live in, and its own
    # background shows above and beside whatever the page puts in it - which
    # was a dark band across the top of every card.
    style.configure("TNotebook", background=page, borderwidth=0,
                    bordercolor=page, lightcolor=page,
                    darkcolor=page, tabmargins=(0, 4, 0, 0))
    # On the card the list stands on, not on the page - see rail() in dress.
    style.configure("Rail.TRadiobutton", background=surface,
                    foreground=variant, focuscolor=surface, anchor="w")
    style.map("Rail.TRadiobutton",
              background=[("active", surface)],
              foreground=[("selected", roles["on_secondary_container"])])

    # No padding: the layout's padding element would otherwise add four
    # pixels that a drop-down beside it does not have, and the two would stand
    # at different heights in a column meant to be regular.
    style.configure("TCheckbutton", background=surface, foreground=on_surface,
                    focuscolor=surface, padding=0)
    style.map("TCheckbutton", background=[("active", surface)])
    style.configure("TRadiobutton", background=surface, foreground=on_surface,
                    focuscolor=surface, padding=(0, 3))
    style.map("TRadiobutton", background=[("active", surface)])

    # Nothing here dresses a ttk.Combobox, and that is deliberate: there is
    # not one left in the window. Every drop-down is a Field.TButton opening a
    # Popup of our own, because a combobox drops a Tk listbox - which cannot
    # hold a swatch, cannot be made to look like the rest of this, and is
    # posted under a grab that kept it floating over other applications.

    # No selection colours here: clam pins an entry's and will not have them
    # configured away - measured, style.lookup gives clam's own grey back
    # whatever is set, on the base style or a derived one, and the option
    # database does not reach it either. So nothing selects text on anyone's
    # behalf in this window; a selection the user made is theirs, in whatever
    # colour Tk gives it.
    style.configure("Material.TEntry", fieldbackground=surface,
                    foreground=on_surface, insertcolor=on_surface,
                    padding=(10, sizes["field_padding"]))

    style.configure("Field.TButton", background=surface,
                    foreground=on_surface, arrowcolor=variant,
                    padding=(10, sizes["field_padding"]),
                    arrowsize=ARROW_SIZE, anchor="w", compound="left")
    # The background matters on a field carrying a swatch, and only there.
    # Tk draws an image on a disabled widget through a fifty per cent
    # stipple - the hatching you see over a greyed colour - and what shows
    # through the holes is this option, not the shade Material.Field paints.
    # Left at surface, half the pixels under the swatch came out the ordinary
    # shade while the field around them was the greyed one, which in a dark
    # theme is exactly the box this was reported as.
    style.map("Field.TButton",
              foreground=[("disabled", material.disabled(roles, on_surface))],
              arrowcolor=[("disabled", material.disabled(roles, variant))],
              background=[("disabled", material.disabled_container(roles)),
                          ("active", surface), ("pressed", surface)])

    style.configure("Horizontal.TScale", background=surface,
                    troughcolor=roles["surface_container_highest"])
    style.configure("TScrollbar", background=roles["surface_container_highest"],
                    troughcolor=page, bordercolor=page,
                    arrowcolor=variant, relief="flat")

    dress(style, roles, sizes)

    roles["_font"] = (family, size)
    roles["_sizes"] = sizes
    return roles


class Runner:
    """Runs a command without freezing the window.

    tkinter may only be touched from the thread that owns it, so the worker
    posts lines into a queue and the UI drains it on a timer.
    """

    def __init__(self, widget, sink, on_state=None):
        # sink(text, tag=None) - the tag is optional so a plain writer works.
        # on_state(busy, code) - what the window shows while something runs,
        # and how it ended. Optional, so a Runner works on its own.
        self.widget = widget
        self.sink = sink
        self.on_state = on_state or (lambda _busy, _code: None)
        self.queue = queue.Queue()
        self.busy = False
        self.transcript = []
        self._job = None
        # The timer outlives the window otherwise: closing it leaves one drain
        # already booked, which then fires at a callback that no longer exists
        # and Tk reports as an invalid command name.
        widget.bind("<Destroy>", self._stop, add="+")
        self._drain()

    def _stop(self, event=None):
        if event is not None and event.widget is not self.widget:
            return                          # a child of ours, not the window
        if self._job is not None:
            self.widget.after_cancel(self._job)
            self._job = None

    def start(self, command, done=None):
        if self.busy:
            self.sink("Still busy with the last command.\n")
            return False
        self.busy = True
        self.transcript = []
        self.on_state(True, None)
        self.sink("$ %s\n" % " ".join(command), "command")
        threading.Thread(target=self._work, args=(command, done),
                         daemon=True).start()
        return True

    def _work(self, command, done):
        try:
            process = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
        except OSError as exc:
            self.queue.put(("line", "cannot run: %s\n" % exc))   # noqa
            self.queue.put(("done", (1, done)))
            return
        for line in process.stdout:
            self.transcript.append(line)
            self.queue.put(("line", line))
        code = process.wait()
        self.queue.put(("done", (code, done)))

    def _drain(self):
        try:
            while True:
                kind, payload = self.queue.get_nowait()
                if kind == "line":
                    self.sink(payload)
                else:
                    code, done = payload
                    self.busy = False
                    self.sink("[exit %d]\n" % code, "command")
                    self.on_state(False, code)
                    # pkexec's own complaint explains nothing to anyone who
                    # has not met it before; say what it means instead.
                    if ledpanel.looks_like_no_auth_agent(
                            "".join(self.transcript), code):
                        self.sink("\n%s\n" % ledpanel.NO_AGENT_ADVICE)
                    self.sink("\n")
                    if done is not None:
                        done(code)
        except queue.Empty:
            pass
        self._job = self.widget.after(120, self._drain)


class Popup:
    """The list a drop-down drops down, drawn here rather than left to Tk.

    A tk.Menu cannot be made to look like the rest of this window. The entry
    you are on can only be marked with an indicator - never with the filled
    row every other list on the desktop uses - and its trim is not ours to
    set. It also outlives its moment: Tk posts it under a grab of its own and
    gives the menu no say in when to go, so it went on floating over whatever
    took the focus next, which is what a menu must never do.

    So it is a window of our own. Rows we draw, and it closes when the focus
    leaves it - by which time it is a plain Toplevel and the focus is a thing
    we are told about. See the note below the constructor for why there is no
    grab.
    """

    PAD_X = 14
    PAD_Y = 8

    def __init__(self, button, key, roles, choices, variable, swatch, on_close):
        self.roles = roles
        self.variable = variable
        self.on_close = on_close
        self.rows = []

        self.owner = button
        self.key = key
        self.window = window = tk.Toplevel(button)
        window.withdraw()
        window.overrideredirect(True)
        # One pixel of edge, which is the Toplevel showing through: a window
        # cannot be given a border of its own without a frame round everything.
        window.configure(background=roles["outline_variant"])
        inner = tk.Frame(window, background=roles["surface_container"],
                         borderwidth=0, highlightthickness=0)
        inner.pack(padx=1, pady=1, fill="both", expand=True)

        # A swatch has no alpha: it is drawn against a known background and
        # carries it in the corners and in the gap beside it. A row has three
        # backgrounds - plain, hovered, chosen - so it needs three, or the one
        # baked against the plain shade sits on the filled row as a patch of
        # the wrong colour. Which is exactly what it did.
        self.swatch = swatch
        for label, value in choices:
            row = tk.Label(inner, text=label, compound="left", anchor="w",
                           font=roles["_font"], padx=self.PAD_X,
                           pady=self.PAD_Y, borderwidth=0,
                           highlightthickness=0)
            row.pack(fill="x")
            row.bind("<Enter>", lambda _e, name=label: self._hover(name))
            row.bind("<Leave>", lambda _e: self._hover(None))
            row.bind("<Button-1>", lambda _e, name=label: self._take(name))
            self.rows.append((row, label, value))
        self._paint(None)

        window.bind("<Escape>", lambda _e: self.close())
        # Two ways out that do not need a click. The list takes the focus when
        # it opens, so losing it means it went somewhere else; focus_get()
        # coming back as None means it went out of this application
        # altogether, which is the case where the list was left floating over
        # somebody else's window.
        window.bind("<FocusOut>", lambda _e: self._left())
        self._watching = button.winfo_toplevel()
        self._watching.bind("<FocusOut>", lambda _e: self._left(), add="+")
        self._watching.bind("<Unmap>", lambda _e: self.close(), add="+")
        window.bind("<Up>", lambda _e: self._step(-1))
        window.bind("<Down>", lambda _e: self._step(1))
        window.bind("<Return>", lambda _e: self.close())
        # Under a local grab every click in this application arrives here; one
        # that did not land on a row is a click away, which closes.
        window.bind("<Button-1>", lambda _e: self.close())
        self._place(button)
        window.deiconify()

    # No grab, and that is the point rather than an omission. Measured under a
    # window manager, with another application raised over the panel: with a
    # grab of either kind the list stayed up, without one it goes. A grab
    # swallows the focus change that says the application is no longer the one
    # being used, and that notice is the only thing an override-redirect
    # window - which is what an undecorated list has to be - ever gets. So the
    # grab went, and the clicks it used to catch are caught by the panel
    # instead: see Panel._panel_click.

    def _left(self):
        """The focus moved: gone, unless it stayed in this application.

        Never asked straight away, on either of the two bindings that get
        here. A focus change arrives as it starts, and asking then can catch
        the moment when the old window has let go and the new one has not yet
        taken hold - which is exactly what pressing a second field while the
        first list is open looks like. One turn of the idle loop later the
        answer is settled.
        """
        self.window.after_idle(self._elsewhere)

    def _elsewhere(self, _event=None):
        try:
            if self.window.focus_get() is None:
                self.close()
        except (tk.TclError, KeyError):                      # pragma: no cover
            self.close()                        # focus is somewhere we cannot see

    def _place(self, button):
        """Under the field, its top edge on the field's bottom one.

        It used to open *over* the field, lined up so the chosen row covered
        it - which is what a menu button does, and what several desktops do.
        It also means the list lands in a different place depending on which
        entry you happen to be on, and covers the thing you just pressed. Under
        it, the field stays visible and the list is always in the same place.

        Upwards instead when there is no room below, which is the one case
        where a list that insisted on opening downwards would run off the
        screen or be clamped back over the field it came from.
        """
        window = self.window
        window.update_idletasks()
        height = window.winfo_reqheight()
        width = max(button.winfo_width(), window.winfo_reqwidth())

        left = button.winfo_rootx()
        below = button.winfo_rooty() + button.winfo_height()
        if below + height <= window.winfo_screenheight():
            top = below
        else:
            # Above, sitting on the field's top edge; and if it does not fit
            # there either - a list longer than the screen - as far down as it
            # can go, which is what the clamp does.
            top = max(0, min(button.winfo_rooty() - height,
                             window.winfo_screenheight() - height))
        left = max(0, min(left, window.winfo_screenwidth() - width))
        window.geometry("%dx%d+%d+%d" % (width, height, left, top))

    def _paint(self, hovered):
        """Colour every row: the one chosen filled, the one under the pointer lit.

        The swatch is repainted with it, against the shade the row has ended
        up: see the note where the rows are built.
        """
        for row, label, value in self.rows:
            if label == self.variable.get():
                fill, ink = "secondary_container", "on_secondary_container"
            elif label == hovered:
                fill, ink = "surface_container_high", "on_surface"
            else:
                fill, ink = "surface_container", "on_surface"
            row.configure(background=self.roles[fill],
                          foreground=self.roles[ink],
                          image=self.swatch(value, fill) or "")

    def _hover(self, label):
        self._paint(label)

    def _step(self, by):
        labels = [label for _row, label, _value in self.rows]
        if not labels:
            return
        try:
            at = labels.index(self.variable.get())
        except ValueError:
            at = 0
        self.variable.set(labels[max(0, min(at + by, len(labels) - 1))])
        self._paint(None)

    def _take(self, label):
        self.variable.set(label)
        self.close()

    def close(self):
        for sequence in ("<FocusOut>", "<Unmap>"):
            try:
                self._watching.unbind(sequence)
            except tk.TclError:                             # pragma: no cover
                pass
        try:
            self.window.destroy()
        except tk.TclError:                                 # pragma: no cover
            pass                                            # already gone
        self.on_close()


class Dialog:
    """A message in the window's own clothes.

    Tk draws its message boxes itself, and next to a Material window they are
    a visitor from another decade - which matters here because this window
    puts one up for everything from a mistyped setting to "this reflashes the
    ESP". A Toplevel costs about as much and inherits the theme, ttk styles
    being global to the interpreter.

    Modal the way a question has to be: transient to the window it belongs to,
    grabbing the pointer, and waited on - so the caller reads the answer as a
    return value rather than through a callback.
    """

    def __init__(self, parent, title, message, confirm=None, deny="Cancel"):
        self.answer = confirm is None
        self.window = window = tk.Toplevel(parent)
        window.withdraw()                       # placed before it is shown
        window.title(title)
        window.transient(parent)
        window.resizable(False, False)
        window.protocol("WM_DELETE_WINDOW", self._deny)
        # A ttk frame fills it, but a sliver shows while it is being laid out
        # and the default Tk grey is not a colour this window uses.
        window.configure(background=ttk.Style().lookup("TFrame", "background"))

        body = ttk.Frame(window, padding=GROUP_GAP)
        body.pack(fill="both", expand=True)
        ttk.Label(body, text=title, style="Heading.TLabel").pack(
            anchor="w", pady=(0, ROW_GAP))
        if message:
            ttk.Label(body, text=message, justify="left",
                      wraplength=DIALOG_WRAP).pack(anchor="w")
        self.build(body)

        buttons = ttk.Frame(body)
        buttons.pack(fill="x", pady=(GROUP_GAP, 0))
        ttk.Button(buttons, text=confirm or "OK", style="Filled.TButton",
                   command=self._confirm).pack(side="right")
        if confirm is not None:
            ttk.Button(buttons, text=deny, style="Text.TButton",
                       command=self._deny).pack(side="right",
                                                padx=(0, ROW_GAP))

        window.bind("<Return>", lambda _event: self._confirm())
        window.bind("<Escape>", lambda _event: self._deny())
        self._centre(parent)
        window.deiconify()
        window.grab_set()
        window.focus_set()
        parent.wait_window(window)

    def build(self, body):
        """What goes between the message and the buttons, if anything."""

    def _centre(self, parent):
        self.window.update_idletasks()
        width = self.window.winfo_reqwidth()
        height = self.window.winfo_reqheight()
        left = parent.winfo_rootx() + (parent.winfo_width() - width) // 2
        top = parent.winfo_rooty() + (parent.winfo_height() - height) // 3
        self.window.geometry("+%d+%d" % (max(0, left), max(0, top)))

    def _confirm(self):
        self.answer = True
        self.window.destroy()

    def _deny(self):
        self.answer = False
        self.window.destroy()


class ColourDialog(Dialog):
    """Pick a colour to flash: a grid of them, or type one in.

    Tk's own chooser is the ugliest window this panel could put up, and it is
    the one that matters most - a project about colour asking for a colour.
    The offered ones are the colours the notifications already use, which are
    the ones this strip is known to look good in; anything else is typed, the
    trigger taking any colour.
    """

    ACROSS = 5

    def __init__(self, parent, dress, title="Flash a colour"):
        self.chosen = None
        # Given a way to dress a button rather than an image: an outlined
        # button blends its own fill under the pointer, and a swatch baked
        # against the plain shade sits on the hovered one as a box - which is
        # the same fault as a greyed field's, and has the same answer.
        self.dress = dress
        super().__init__(parent, title, None, confirm="Flash")

    def build(self, body):
        grid = ttk.Frame(body)
        grid.pack(anchor="w")
        for index, (label, value) in enumerate(ledpanel.palette()):
            button = ttk.Button(grid, text=label, compound="left",
                                style="Outlined.TButton",
                                command=lambda hue=value: self._take(hue))
            button.grid(row=index // self.ACROSS, column=index % self.ACROSS,
                        sticky="ew", padx=(0, ROW_GAP), pady=(0, ROW_GAP))
            self.dress(button, value)

        typed = ttk.Frame(body)
        typed.pack(fill="x", pady=(ROW_GAP, 0))
        ttk.Label(typed, text="Or a colour of your own").pack(anchor="w")
        self.entry = ttk.Entry(typed, width=12, style="Material.TEntry")
        self.entry.insert(0, ledpanel.SHAPE_TEST_COLOUR)
        self.entry.pack(anchor="w", pady=(ROW_GAP, 0))

    def _take(self, value):
        """A swatch is the whole answer: pick it and the dialog is done."""
        self.chosen = value
        self._confirm()

    def _confirm(self):
        if self.chosen is None:
            typed = self.entry.get().strip()
            if not _COLOUR.match(typed):
                self.entry.focus_set()
                return                      # not a colour; say nothing, wait
            self.chosen = typed
        super()._confirm()


class ProfileDialog(Dialog):
    """Save or load one of your own profiles, without a file browser.

    Tk's file chooser is Tk's own and not the desktop's, which is exactly what
    it looks like next to this window. A browser is the wrong shape for the
    job as well: profiles live in one directory beside the clone, they are
    named rather than filed, and what anybody wants here is the list of the
    ones they have.
    """

    def __init__(self, parent, directory, roles, saving):
        self.directory = directory
        self.roles = roles
        self.saving = saving
        self.names = ledpanel.profiles(directory)
        self.chosen = None
        super().__init__(
            parent, "Save profile" if saving else "Load profile",
            "Saved beside the clone, in %s." % directory if saving
            else "Loaded into this window; nothing is written until you press "
                 "Apply.",
            confirm="Save" if saving else "Load")

    def build(self, body):
        self.listing = tk.Listbox(
            body, height=min(8, max(3, len(self.names))), activestyle="none",
            borderwidth=0, highlightthickness=0, exportselection=False,
            # A tk widget, not a themed one: it has no style to take a colour
            # from and has to be told. Every ttk label in this window already
            # carries the ground it stands on - see dress().
            background=self.roles["surface_container_low"],
            foreground=self.roles["on_surface"],
            selectbackground=self.roles["secondary_container"],
            selectforeground=self.roles["on_secondary_container"])
        for name in self.names:
            self.listing.insert("end", name)
        self.listing.pack(fill="x", pady=(GROUP_GAP, 0))
        self.listing.bind("<<ListboxSelect>>", self._picked)
        self.listing.bind("<Double-Button-1>", lambda _event: self._confirm())
        if not self.names:
            self.listing.insert("end", " nothing saved yet")
            self.listing.configure(foreground=self.roles["on_surface_variant"],
                                   state="disabled")

        if not self.saving:
            return
        typed = ttk.Frame(body)
        typed.pack(fill="x", pady=(GROUP_GAP, 0))
        ttk.Label(typed, text="Call it").pack(anchor="w")
        self.entry = ttk.Entry(typed, style="Material.TEntry")
        self.entry.pack(fill="x", pady=(ROW_GAP, 0))
        self.entry.focus_set()
        ttk.Label(typed, text="A profile of the same name is replaced.",
                  style="Muted.TLabel").pack(anchor="w", pady=(ROW_GAP, 0))

    def _picked(self, _event=None):
        """Clicking one fills the name in, so overwriting is a click away."""
        picked = self.listing.curselection()
        if picked and self.saving:
            self.entry.delete(0, "end")
            self.entry.insert(0, self.names[picked[0]])

    def _confirm(self):
        if self.saving:
            self.chosen = ledpanel.profile_path(self.directory,
                                                self.entry.get())
            if self.chosen is None:
                self.entry.focus_set()
                return                          # unnamed; say nothing, wait
        else:
            picked = self.listing.curselection()
            if not picked or not self.names:
                return                          # nothing chosen yet
            self.chosen = ledpanel.profile_path(self.directory,
                                                self.names[picked[0]])
        super()._confirm()


class SidebarEntry:
    """One section in the list down the left edge.

    A canvas rather than a ttk.Radiobutton, which is what the inner rail is.
    That one has a single label in a single font, and this needs two: a title
    and, under it in a smaller muted face, what the section is for. ttk has no
    way to say that - a widget has one -font option - and a two-line label in
    one face loses the distinction the subtitle exists to make.

    A canvas has neither problem, and it is also how everything else in this
    window that ttk could not draw is drawn: the preview
    stage, the swatches. Text items take a font and a fill apiece, so the
    whole entry is four items on one surface.

    What it gives up is ttk's states, so hover and selection are bound here by
    hand. That is three bindings, and it is the price of the second line.
    """

    def __init__(self, parent, roles, fonts, entry, on_pick):
        self.roles = roles
        self.key, title, subtitle, icon = entry
        self.on_pick = on_pick
        self.selected = False
        self.hovering = False

        self.canvas = tk.Canvas(
            parent, width=SIDEBAR_WIDTH, height=SIDEBAR_ENTRY_HEIGHT,
            highlightthickness=0, borderwidth=0, background=roles["_page"])
        # The pill behind it, in each of the three shades it takes. Drawn once
        # apiece and swapped, rather than redrawn on every pointer crossing:
        # building one is a rounded rectangle the size of the entry, and the
        # sidebar would otherwise do that work every time the pointer travels
        # down the list.
        self._grounds = {
            state: _photo(roundrect.rows(
                SIDEBAR_WIDTH, SIDEBAR_ENTRY_HEIGHT, SIDEBAR_RADIUS,
                colour, roles["_page"]))
            for state, colour in (
                ("rest", roles["_page"]),
                ("hover", material.blend(roles["_page"],
                                         roles["on_surface"],
                                         material.STATE_HOVER)),
                ("selected", roles["secondary_container"]))}
        self.ground = self.canvas.create_image(0, 0, anchor="nw",
                                               image=self._grounds["rest"])
        self._draw_icon(icon)
        self.title = self.canvas.create_text(
            SIDEBAR_TEXT_X, SIDEBAR_ENTRY_HEIGHT // 2 - 9, anchor="w",
            text=title, font=fonts["title"], fill=roles["on_surface"])
        self.subtitle = self.canvas.create_text(
            SIDEBAR_TEXT_X, SIDEBAR_ENTRY_HEIGHT // 2 + 10, anchor="w",
            text=subtitle, font=fonts["subtitle"],
            fill=roles["on_surface_variant"])

        self.canvas.bind("<Button-1>", lambda _event: self.on_pick(self.key))
        self.canvas.bind("<Enter>", lambda _event: self._hover(True))
        self.canvas.bind("<Leave>", lambda _event: self._hover(False))

    def _draw_icon(self, name):
        """A small pictogram, drawn from primitives.

        Four shapes and a letter, none of them a font glyph: the symbols that
        would say these things - a lightning bolt, a television - live in
        emoji fonts that a machine may not have, and a missing glyph is an
        empty box beside every entry rather than a plain one.
        """
        left, middle = SIDEBAR_ICON_X, SIDEBAR_ENTRY_HEIGHT // 2
        colour = self.roles["on_surface_variant"]
        # (item, which option carries its colour). Recorded as it is drawn
        # rather than asked for later: a canvas line has no -outline at all,
        # and itemcget raises on an option the item does not have instead of
        # answering empty - so probing for it is a Tcl error, not a no-op.
        self.icon = []

        def solid(item):
            self.icon.append((item, "fill"))

        def drawn(item):
            self.icon.append((item, "outline"))

        if name == "strip":                     # the bar itself: four LEDs
            for step in range(4):
                spot = left + step * 6
                solid(self.canvas.create_oval(spot, middle - 2, spot + 4,
                                              middle + 2, outline="",
                                              fill=colour))
        elif name == "bolt":                    # power
            solid(self.canvas.create_polygon(
                left + 11, middle - 9, left + 3, middle + 1, left + 8,
                middle + 1, left + 6, middle + 9, left + 15, middle - 2,
                left + 10, middle - 2, outline="", fill=colour))
        elif name == "screen":                  # a television
            drawn(self.canvas.create_rectangle(left, middle - 7, left + 18,
                                               middle + 4, outline=colour,
                                               width=1.6))
            solid(self.canvas.create_line(left + 5, middle + 8, left + 13,
                                          middle + 8, fill=colour, width=1.6))
            solid(self.canvas.create_line(left + 9, middle + 4, left + 9,
                                          middle + 8, fill=colour, width=1.6))
        elif name == "keys":                    # a keyboard
            drawn(self.canvas.create_rectangle(left, middle - 6, left + 18,
                                               middle + 6, outline=colour,
                                               width=1.6))
            for step in range(3):
                spot = left + 4 + step * 5
                solid(self.canvas.create_line(spot, middle - 2, spot + 2,
                                              middle - 2, fill=colour,
                                              width=1.6))
            solid(self.canvas.create_line(left + 5, middle + 3, left + 13,
                                          middle + 3, fill=colour, width=1.6))
        elif name == "sliders":                 # this window's own settings
            for step, across in enumerate((5, 11)):
                spot = middle - 5 + step * 10
                solid(self.canvas.create_line(left, spot, left + 18, spot,
                                              fill=colour, width=1.6))
                drawn(self.canvas.create_oval(left + across - 3, spot - 3,
                                              left + across + 3, spot + 3,
                                              outline=colour, width=1.6,
                                              fill=self.roles["_page"]))
        elif name == "wrench":                  # putting it right
            solid(self.canvas.create_line(left + 2, middle + 8, left + 11,
                                          middle - 1, fill=colour, width=3))
            drawn(self.canvas.create_oval(left + 8, middle - 9, left + 17,
                                          middle, outline=colour, width=2))
        else:                                   # about
            drawn(self.canvas.create_oval(left, middle - 9, left + 18,
                                          middle + 9, outline=colour,
                                          width=1.6))
            solid(self.canvas.create_line(left + 9, middle - 5, left + 9,
                                          middle - 4, fill=colour, width=2))
            solid(self.canvas.create_line(left + 9, middle - 1, left + 9,
                                          middle + 5, fill=colour, width=1.6))

    def pack(self, **options):
        self.canvas.pack(**options)
        return self

    def _hover(self, over):
        self.hovering = over
        self._repaint()

    def set_selected(self, selected):
        self.selected = selected
        self._repaint()

    def _repaint(self):
        """The pill, and the two texts that have to stay legible on it."""
        state = ("selected" if self.selected
                 else "hover" if self.hovering else "rest")
        self.canvas.itemconfigure(self.ground, image=self._grounds[state])
        # On the filled pill the text is the colour that container asks for,
        # which is not the same as the one the page uses - a selected entry
        # keeping the page's foreground is the one that goes unreadable.
        lit = self.selected
        title = self.roles["on_secondary_container" if lit else "on_surface"]
        rest = self.roles["on_secondary_container" if lit
                          else "on_surface_variant"]
        self.canvas.itemconfigure(self.title, fill=title)
        self.canvas.itemconfigure(self.subtitle, fill=rest)
        for item, option in self.icon:
            self.canvas.itemconfigure(item, **{option: rest})


class Indicator:
    """A coloured dot and a sentence, at the foot of the window.

    Two of them now: whether the LED bar is being driven, and whether HDMI CEC
    can reach the television. Both answer a question somebody has while
    looking at any page, which is why they are at the foot rather than on the
    page that configures them.

    Three states, and the third is the point. Before anything has been read
    there is nothing to claim, and a grey dot saying "looking" is honest where
    a red one saying "not connected" would be a fault report about a question
    nobody has answered yet.

    The dot is a canvas because a coloured disc is not something ttk draws.
    The pair is packed and unpacked together - an indicator with no dot is a
    sentence, and one with no sentence is a dot nobody can read.
    """

    def __init__(self, parent, roles, text):
        self.roles = roles
        self.canvas = tk.Canvas(parent, width=STATUS_DOT * 2,
                                height=STATUS_DOT * 2, highlightthickness=0,
                                borderwidth=0, background=roles["_page"])
        self.dot = self.canvas.create_oval(
            1, 1, STATUS_DOT * 2 - 1, STATUS_DOT * 2 - 1, width=0,
            fill=roles["on_surface_variant"])
        self.label = ttk.Label(parent, text=text, style="Page.Muted.TLabel")

    def show(self, after=None):
        """Put it in the bar, in a place that does not depend on when.

        `after` pins where: an indicator shown later would otherwise land at
        the end of whatever is packed to the left at that moment, which on a
        window that has already reported a failure means landing after it.
        """
        if self.canvas.winfo_ismapped():
            return
        # Room in front of it when it follows another one. Without it the
        # second dot sits against the first one's last word and the two read
        # as one long sentence with a bullet in the middle of it.
        self.canvas.pack(side="left",
                         padx=(GROUP_GAP if after is not None else 0, ROW_GAP),
                         **({"after": after} if after is not None else {}))
        self.label.pack(side="left", after=self.canvas)

    def hide(self):
        self.canvas.pack_forget()
        self.label.pack_forget()

    def say(self, good, text):
        self.canvas.itemconfigure(self.dot, fill=(
            self.roles["on_surface_variant"] if good is None
            else self.roles["positive"] if good
            else self.roles["error"]))
        self.label.configure(text=text)


class Panel:
    def __init__(self, root):
        self.root = root
        root.title("SteamOS LED bar")
        # Wide enough that the sidebar, the inner list and a full-width
        # setting row all fit without the window having to be dragged bigger
        # before anything can be read - which is what the old 820 meant once
        # there was a second list down the left. The height is a floor only:
        # _refit gives the window what the open page actually needs.
        root.minsize(MIN_WIDTH, MIN_HEIGHT)
        root.geometry("%dx%d" % (START_WIDTH, START_HEIGHT))
        self._set_window_icon()

        # Read before anything is drawn, because it decides how it is drawn.
        # Its own file and its own reader: this one is about the window.
        self.app = appsettings.read()
        self.roles = apply_theme(root, self.app[appsettings.THEME])
        self.config = self._load_config()
        # The machine's own settings, kept beside the service's rather than
        # merged into them: they come from different files, they are written
        # back by different means, and only one of the two restarts anything.
        self.system = syssettings.read()
        # And the CPU's, which live in /etc like the service's own and are
        # written the same way: through a short helper under pkexec.
        self.power = self._load_power()
        self.vars = {}
        # key -> the (label, value) pairs and the widget, so a value that
        # turns up later can be added to both.
        self._menus = {}
        self._widgets = {}
        # key -> the variable its drop-down writes
        self._menu_parts = {}
        # The one drop-down standing open, if any
        self._popup = None
        # What the last update check found; see _say_update
        self._update_state = ledpanel.UPDATE_UNKNOWN
        self.update_button = None
        # key -> (labels, controls), so a setting can be greyed out whole
        self._rows = {}
        # key -> (grid, row, minsize, widgets), for a row that is taken away
        # rather than greyed. Apart from _rows because everything else reads
        # that as a pair, and because only some rows ever need this.
        self._row_places = {}
        # page -> the canvas that scrolls it, for the wheel to find
        self._scrollers = {}
        # What is booked with after(), so it can be dropped when the window is
        self._preview_job = None
        self._refit_job = None
        # And the catching-up a moved control books - see _settings_changed.
        self._catching_up = None
        # Explanations that should use the width the window actually has
        self._wrapped = []
        # How much narrower than the page one of them is, by widget name. A
        # label indented under a switch has that much less room than the ones
        # starting at the card's edge, and _rewrap hands the same width to
        # every label - so without this the indented ones were laid out into
        # room they do not have, and a label wider than its slot is not
        # wrapped, it is cut off.
        self._wrap_insets = {}
        self._wrap_width = 0

        # The header says which *section* is open, not what the program is
        # called - the title bar already does that, and repeating it inside
        # the window spends the one line that could say where you are.
        # Two levels, outer first: the sidebar picks a section, and what a
        # section holds is its own business. Only the LED strip has an inner
        # list of pages; the rest are one page each.
        outer = ttk.Frame(root, style="Page.TFrame")
        self.sidebar = ttk.Frame(outer, style="Page.TFrame")
        self.sidebar.pack(side="left", fill="y",
                          padx=(SIDE_MARGIN, GROUP_GAP), pady=GROUP_GAP)
        main = ttk.Frame(outer, style="Page.TFrame")
        main.pack(side="left", fill="both", expand=True)

        # The header is a child of `main` rather than of the window packed
        # into it with in_. That form works until stacking order matters, and
        # here it did not: the header is drawn behind the section under it and
        # the window simply came up with no title on it at all.
        header = self.header = ttk.Frame(main, style="Page.TFrame")
        header.pack(fill="x", pady=(GROUP_GAP, GROUP_GAP // 2))
        self.section_title = ttk.Label(header, text="",
                                       style="Page.Heading.TLabel")
        self.section_title.pack(anchor="w")
        self.headline = ttk.Label(header, text="",
                                  style="Page.Muted.TLabel",
                                  justify="left", wraplength=CONTENT_MAX)
        self.headline.pack(anchor="w", pady=(2, 0))
        # Wrapped like everything else that is a sentence rather than a label.
        # Left to one line it is the longest thing in the window - a toplevel
        # asks for what its widest child wants, so the repair summary alone
        # decided how wide the window opened.
        self._wrapped.append(self.headline)

        self.sections = ttk.Notebook(main)

        # The foot of the window is claimed before the pages are, and from the
        # bottom up: pack hands out room in the order it was asked, so the
        # pages taking all of it first left a short window with no Apply row
        # and no status bar at all - they were packed later and there was
        # nothing left. The pages scroll and these do not, so these go first.
        #
        # Under the sections, not inside one: one Apply for every setting in
        # the window, whichever section it is on - see apply_settings.
        self._build_statusbar(root)
        self.runner = Runner(root, self._write, self._set_busy)
        self._build_apply(root)
        self.sections.pack(fill="both", expand=True)
        outer.pack(fill="both", expand=True,
                   padx=SIDE_MARGIN // 2, pady=(0, 0))

        # With the rail the pages have no tab row of their own: the list down
        # the left side is what picks them, and the notebook is only the stack
        # of pages underneath.
        strip = ttk.Frame(self.sections, style="Page.TFrame")
        # The inner list sits on a raised card, which is the one place in the
        # window that needs a box round it: it is a list of pages standing
        # beside the page it chose, and with both on the same ground the two
        # read as one column of things you can click.
        rail_card = ttk.Frame(strip, style="Card.TFrame")
        rail_card.pack(side="left", fill="y", padx=(0, GROUP_GAP),
                       pady=(0, GROUP_GAP))
        self.rail = ttk.Frame(rail_card, style="OnCard.TFrame")
        self.rail.pack(fill="y", expand=True, padx=ROW_GAP, pady=ROW_GAP)
        notebook = self.notebook = ttk.Notebook(strip)
        notebook.pack(side="left", fill="both", expand=True)

        # Which tabs the Apply row belongs under, by widget rather than by
        # position - reordering the tabs must not silently change this.
        self._settings_tabs = set()
        for entry in SETTINGS_TABS:
            title, table = entry[0], entry[1]
            note = entry[2] if len(entry) > 2 else None
            tab = self._page(notebook,
                             lambda where, t=table, n=note:
                             self._build_settings(where, t, n))
            notebook.add(tab, text=title)
            self._settings_tabs.add(str(tab))
        self.preview_tab = self._page(notebook, self._build_preview)
        notebook.add(self.preview_tab, text="Preview")
        notebook.add(self._page(notebook, self._build_tests), text="Test")
        self._build_rail()

        # And the sections themselves, in the order the sidebar lists them.
        self._section_pages = {}
        # Built in the order the sidebar lists them, and from the same table,
        # so a section added to SECTIONS and to neither of the two below is
        # caught here rather than showing an empty page.
        self._section_pages["strip"] = None      # placed by _add_section
        self._add_section("strip", strip)
        for key, _title, _subtitle, _icon in SECTIONS:
            if key == "strip":
                continue
            if key in SECTION_SETTINGS:
                table, note = SECTION_SETTINGS[key]
                page = self._page(self.sections,
                                  lambda where, t=table, n=note:
                                  self._build_settings(where, t, n))
            elif key == "cec":
                page = self._page(self.sections, self._build_cec)
            elif key in SOON:
                page = self._page(self.sections,
                                  lambda where, k=key: self._build_soon(where,
                                                                        k))
            elif key == "status":
                page = self.status_tab = self._page(self.sections,
                                                    self._build_status)
            else:                                            # pragma: no cover
                raise AssertionError("no page for the %s section" % key)
            self._add_section(key, page)
        self._add_section("about", self._page(self.sections,
                                              self._build_about))
        self._build_sidebar()
        self._catch_up()                # now: the window is about to be shown

        # Closing goes through here so what is booked is dropped first. The
        # <Destroy> binding is the backstop; by the time it runs, some of the
        # widgets holding those bookings have already gone.
        root.protocol("WM_DELETE_WINDOW", self._close)
        # Minimising or hiding the window leaves a posted menu on screen too.
        root.bind("<Unmap>", self._dismiss_menus, add="+")
        root.bind("<Button-1>", self._panel_click, add="+")

        for wheel in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            root.bind_all(wheel, self._wheel)

        notebook.bind("<<NotebookTabChanged>>", self._tab_changed)
        self._tab_changed()
        notebook.bind("<Configure>", self._rewrap)
        self.sections.bind("<Configure>", self._rewrap)

        if ledpanel.in_game_mode():
            self._write(
                "Running in Game Mode. Flashing the bar and the Steam checks "
                "work here;\nchanging settings, the self-test and repairing "
                "need administrator rights,\nwhich only Desktop Mode can ask "
                "for.\n\n")

        self._register_buttons()
        self.refresh_status()
        self._say_cec_link()
        self._cec_first = None
        if cec.installed():
            self._cec_first = self.root.after(CEC_FIRST_LOOK,
                                              self._reread_cec)
        # Open at the height the content needs, so the first thing anyone does
        # is not what resizes the window.
        self._fit_window()

    def _page(self, notebook, build):
        """One page of the notebook, scrolling if the window is too short.

        A page is as long as its settings are; a window is only as tall as the
        screen allows. Without this the foot of the longest page is simply out
        of reach on a smaller screen - and a settings panel with a setting
        nobody can get to is worse than an ugly one.

        Nothing appears while it is not needed: the bar shows up when the
        content outgrows the room and goes away again when it fits, so on a
        screen with the height for it the panel looks exactly as it did.
        """
        holder = ttk.Frame(notebook, style="Page.TFrame")
        canvas = tk.Canvas(holder, highlightthickness=0, borderwidth=0,
                           background=self.roles["_page"])
        bar = ttk.Scrollbar(holder, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=bar.set)
        canvas.pack(side="left", fill="both", expand=True)

        inner = ttk.Frame(canvas, style="Page.TFrame")
        window = canvas.create_window(0, 0, window=inner, anchor="nw")
        build(inner).pack(fill="both", expand=True)

        def fit(_event=None):
            wanted = inner.winfo_reqheight()
            across = inner.winfo_reqwidth()
            # Capped, so a wide monitor gets air down the right rather than a
            # slider two thousand pixels long. A settings column is read like
            # a column: past a certain width the label and the control it
            # belongs to are far enough apart to have to be traced by eye.
            width = min(canvas.winfo_width(), CONTENT_MAX)
            room = canvas.winfo_height()
            # At least the room it has, so a page with something set to expand
            # - the preview's stage - still fills the window when it fits.
            height = max(wanted, room)
            canvas.itemconfigure(window, width=width, height=height)
            canvas.configure(scrollregion=(0, 0, width, height))
            # Asking for what the content needs keeps the window opening at the
            # size the page wants; the cap in _refit is what decides whether it
            # gets the height. The width matters as much: a canvas does not
            # pass on what is inside it, it asks for its own default - so
            # without this the window opened at a canvas's idea of wide and
            # squeezed every page into it. Only when it changed, or setting it
            # brings this handler straight back and the two chase each other.
            if (canvas.winfo_reqheight() != wanted
                    or canvas.winfo_reqwidth() != across):
                canvas.configure(height=wanted, width=across)
            if (wanted > room) != bool(bar.winfo_ismapped()):
                if wanted > room:
                    # before= the canvas, so the bar is allocated its width
                    # first. pack hands out the cavity in packing order, and
                    # the canvas asks for as much width as its content wants:
                    # packed after it there was nothing left, so the bar was
                    # placed, sized, and never mapped - a page that scrolled
                    # by wheel and showed no bar to say so.
                    bar.pack(side="right", fill="y", before=canvas)
                else:
                    bar.pack_forget()
                    canvas.yview_moveto(0)

        inner.bind("<Configure>", fit)
        canvas.bind("<Configure>", fit)
        self._scrollers[str(holder)] = canvas
        return holder

    def _wheel(self, event):
        """Turn the wheel into a scroll of whichever page is open.

        Bound to everything rather than to the canvas: an event goes to the
        widget under the pointer and then up its bindtags, not up its parents,
        so a wheel over a label in the middle of the page would never reach the
        canvas underneath it.
        """
        self._dismiss_menus()                   # a list is not scrolled past
        canvas = self._scrollers.get(self._open_page())
        if canvas is None or not canvas.winfo_ismapped():
            return
        down = getattr(event, "num", 0) == 5 or getattr(event, "delta", 0) < 0
        canvas.yview_scroll(1 if down else -1, "units")

    def _add_section(self, key, page):
        """One page of the outer notebook, remembered by name.

        By name rather than by position: the sidebar, the header and the
        Apply row all need to say something about "the section that is open",
        and an index into a notebook is the wrong handle for that - inserting
        a section anywhere but the end would move every answer after it.
        """
        self.sections.add(page, text=key)
        self._section_pages[key] = str(page)

    def _build_sidebar(self):
        """The list down the left edge, and the About entry under it.

        About is packed to the bottom first. pack hands out room in the order
        it is asked for, so a widget that wants the foot has to claim it
        before the list above it takes the lot.
        """
        family, size = self.roles["_font"]
        fonts = {"title": (family, size, "bold"),
                 "subtitle": (family, size + TYPE_SUPPORT)}
        self._sidebar_entries = {}
        about = SidebarEntry(self.sidebar, self.roles, fonts, ABOUT,
                             self._open_section)
        about.pack(side="bottom", anchor="w")
        self._sidebar_entries[ABOUT[0]] = about
        for entry in SECTIONS:
            made = SidebarEntry(self.sidebar, self.roles, fonts, entry,
                                self._open_section)
            made.pack(side="top", anchor="w", pady=(0, 2))
            self._sidebar_entries[entry[0]] = made
        self._open_section(SECTIONS[0][0])

    def _open_section(self, key):
        """Show a section, and make the window say which one is open."""
        self.sections.select(self._section_pages[key])
        for name, entry in self._sidebar_entries.items():
            entry.set_selected(name == key)
        self.section = key
        self.section_title.configure(text=dict(
            (entry[0], entry[1]) for entry in SECTIONS + (ABOUT,))[key])
        if key == "cec":
            self._catch_up_cec()
        self._tab_changed()

    def _build_statusbar(self, parent):
        """The line across the foot: is the bar there, and which version.

        At the very bottom of the window rather than on the status page,
        because it answers the question somebody has while looking at any of
        them - a page of LED settings is worth less if nothing is listening.
        """
        bar = self.statusbar = ttk.Frame(parent, style="Page.TFrame")
        bar.pack(side="bottom", fill="x",
                 padx=SIDE_MARGIN + SIDE_MARGIN // 2, pady=(0, GROUP_GAP))
        self.link = Indicator(bar, self.roles, "Looking for the bar...")
        self.link.show()
        # The second one is built here and shown only once there is a toolkit
        # to report on - see _say_cec_link. A machine that has never installed
        # HDMI CEC has nothing to indicate, and a permanent grey "not
        # installed" would be the foot of the window reporting an absence
        # nobody asked about.
        self.cec_link = Indicator(bar, self.roles, "Looking for HDMI CEC...")
        # Built here and packed only when there is something to say - see
        # _say_problem. An empty label sitting in the bar would still take its
        # padding, and the gap would be the one thing in this line that means
        # nothing.
        self.problem = ttk.Label(bar, text="\u26a0 " + PROBLEM_TEXT,
                                 style="Page.Bad.TLabel")
        ttk.Label(bar, text="SteamOS LED bar v%s" % VERSION,
                  style="Page.Muted.TLabel").pack(side="right")

    def _say_link(self, connected, detail=""):
        self.link.say(connected,
                      detail or ("Looking for the bar..." if connected is None
                                 else "LED bar connected"
                                 if connected else "LED bar not connected"))

    def _say_cec_link(self):
        """The same for HDMI CEC, and away entirely when there is none.

        What it reports is the adapter rather than the switches: every feature
        can be on and none of them work if nothing can be sent, and that is
        the question worth answering from a page about something else. Which
        features are on is a thing you go to the section to see.
        """
        if not cec.installed():
            self.cec_link.hide()
            return
        self.cec_link.show(after=self.link.label)
        if self._cec is None:
            # Asked and got nothing back is not the same as not asked yet. The
            # first is a toolkit that is installed and will not answer, which
            # is a fault; the second is a window that has not looked.
            if self._cec_asked:
                self.cec_link.say(False, "HDMI CEC is not answering")
            else:
                self.cec_link.say(None, "Looking for HDMI CEC...")
        elif cec.usable(self._cec):
            self.cec_link.say(True, "HDMI CEC ready")
        else:
            found = cec.device(self._cec)
            self.cec_link.say(False, "HDMI CEC: %s" % (
                "adapter cannot be written to" if found.get("exists")
                else "no adapter"))

    def _build_soon(self, where, key):
        """A section that is planned but not built.

        It says what it will do and what is in the way, rather than only that
        it is coming: a page that promises a feature and explains nothing is
        indistinguishable from one that has quietly failed to load.
        """
        title, doing, blocked = SOON[key]
        holder = ttk.Frame(where, style="Page.TFrame")
        holder.pack(fill="both", expand=True, padx=SIDE_MARGIN,
                    pady=SIDE_MARGIN)
        card = ttk.Frame(holder, style="Card.TFrame")
        card.pack(fill="x")
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="Coming soon", style="Section.TLabel").pack(
                      anchor="w")
        ttk.Label(inner, text=title, style="Heading.TLabel").pack(
                      anchor="w", pady=(ROW_GAP, GROUP_GAP // 2))
        for text in (doing, blocked):
            said = ttk.Label(inner, text=text, style="Muted.TLabel",
                             justify="left", wraplength=CARD_WRAP)
            said.pack(anchor="w", pady=(0, ROW_GAP))
            self._wrapped.append(said)
        return holder

    def _build_about(self, where):
        """Who made it, what it is, and where to go for the rest."""
        holder = ttk.Frame(where, style="Page.TFrame")
        holder.pack(fill="both", expand=True, padx=SIDE_MARGIN,
                    pady=SIDE_MARGIN)
        card = ttk.Frame(holder, style="Card.TFrame")
        card.pack(fill="x")
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="SteamOS LED bar", style="Heading.TLabel").pack(anchor="w")
        ttk.Label(inner, text="Version %s" % VERSION,
                  style="Muted.TLabel").pack(
                      anchor="w", pady=(2, GROUP_GAP // 2))
        # The label over its text rather than beside it. Beside it, the text
        # column is the card's width less whatever the widest label takes -
        # a number this had to be told, was told wrong, and the last words of
        # two of the four lines were drawn past the edge of the card.
        # Stacked, both are the same width and there is nothing to get wrong.
        for label, text in ABOUT_LINES:
            ttk.Label(inner, text=label, style="Section.TLabel").pack(anchor="w", pady=(GROUP_GAP // 2,
                                                                2))
            said = ttk.Label(inner, text=text, style="Muted.TLabel", justify="left",
                             wraplength=CARD_WRAP)
            said.pack(anchor="w")
            self._wrapped.append(said)
        return holder

    def _build_rail(self):
        """Fill the rail, once the notebook knows what pages it has.

        A rail rather than a row of tabs is what Material suggests once there
        are more than a handful of destinations, and six is over that line. It
        also buys back the vertical space the tab row was using, which on a
        window this tall is worth having.

        The notebook keeps its pages and its events - only its own tab row is
        taken out of the layout - so everything that watches for a page change
        goes on working, and the rail is what drives it.
        """
        self._rail_choice = tk.StringVar(value=self.notebook.tabs()[0])
        for name in self.notebook.tabs():
            ttk.Radiobutton(
                self.rail, text=self.notebook.tab(name, "text"), value=name,
                variable=self._rail_choice, style="Rail.TRadiobutton",
                command=lambda page=name: self.notebook.select(page)).pack(
                    fill="x", pady=(0, 2))

    # -- helpers ----------------------------------------------------------

    def _set_busy(self, busy, code=None):
        """What the window does while a command runs, and when it ends.

        Every button that starts a command goes dead, so a second one cannot
        be started - the Runner refuses it anyway, but only by printing a line
        nobody is looking at - and when a command ends badly the reason goes
        beside the status light.

        There was a moving rule under the title as well. It said only what the
        greyed buttons already say, and it said it by animating four pixels
        sixty times a second for the length of an install.
        """
        for button in self._busy_buttons:
            button.state(["disabled"] if busy else ["!disabled"])
        if not busy:
            # These have reasons of their own to be dead, which outlive the
            # command that greyed everything - and _busy_buttons is every
            # button in the window, drop-down fields included, so waking them
            # all would hand back settings that a switch above them is meant
            # to be holding shut. Reported: pressing Apply with a rainbow
            # scene ungreyed its colour until the window was opened again.
            self._refresh_enabled()
            self._refresh_unsaved()
            self._refresh_update()
            # Cleared on success as firmly as it is set on failure: a warning
            # left standing beside a command that has just worked is worse
            # than no warning at all.
            self._say_problem(bool(code))

    def _say(self, title, message):
        """Tell the user something; there is nothing to answer."""
        Dialog(self.root, title, message)

    def _ask(self, title, message, confirm, deny="Cancel"):
        """Ask a yes-or-no question, and return whether it was confirmed."""
        return Dialog(self.root, title, message, confirm=confirm,
                      deny=deny).answer

    def _theme_chosen(self):
        """The look was picked. Save it and wear it, without an Apply.

        A look you have to press a button to see is a look you are choosing
        blind. It is also the one setting in this window where being wrong
        costs nothing: pick the other one back.
        """
        wanted = self._value_for("THEME", self.vars["THEME"][0].get())
        if wanted == self.app.get(appsettings.THEME):
            return                              # the trace fires on rebuild too
        settings = dict(self.app, **{appsettings.THEME: wanted})
        try:
            appsettings.write(settings)
        except (appsettings.SettingError, OSError) as exc:
            self._say("Appearance", "Could not save it:\n%s" % exc)
            return
        self.app = settings
        self.rebuild()

    def rebuild(self):
        """Build the window again, in whatever the settings now say.

        Rebuilt rather than repainted, and that is a considered choice. Half
        of this window is not ttk: the sidebar's pills, its icons, the
        status dot, every page's canvas and every colour
        swatch are pictures with their colours already baked in. Repainting
        would mean a second path that has to reach all of them - and this
        session has already produced two bugs from one picture drawn against
        the wrong ground. Construction is the path that is tested.

        What survives is what the window cannot read back off disk: the page
        you were on and the edits you had not applied. Everything else comes
        from the files again, which is where it came from the first time.
        """
        unsaved = {}
        for key, (variable, _kind) in self.vars.items():
            try:
                unsaved[key] = variable.get()
            except (ValueError, tk.TclError):                # pragma: no cover
                pass
        section = getattr(self, "section", None)
        page = self.notebook.tab(self.notebook.select(), "text")
        # Whether a command has failed since the window opened. The only part
        # of the status bar whose reason to be there lives nowhere but in the
        # window being thrown away: the lights re-read the machine a moment
        # later on their own, and the version is a constant.
        problem = bool(self.problem.winfo_ismapped())

        self._teardown()
        self.__init__(self.root)                # the one construction path

        if section is not None:
            self._open_section(section)
        for tab in self.notebook.tabs():
            if self.notebook.tab(tab, "text") == page:
                self.notebook.select(tab)
        for key, value in unsaved.items():
            if key in self.vars:
                try:
                    self.vars[key][0].set(value)
                except (ValueError, tk.TclError):            # pragma: no cover
                    pass
        self._say_problem(problem)
        self._catch_up()

    def _teardown(self):
        """Everything the old window booked or bound, before it is replaced.

        A destroyed *child* fires no <Destroy> on the window, so the two
        cleanups that hang off that binding - the timers and the Runner's
        drain - have to be asked directly. And bind_all is on the interpreter
        rather than on a widget: left alone, every rebuild would add another
        wheel handler pointing at a window that no longer exists.
        """
        self._stop_timers()
        self.runner._stop()
        for wheel in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.root.unbind_all(wheel)
        for child in self.root.winfo_children():
            child.destroy()

    def _close(self):
        self._stop_timers()
        self.root.destroy()

    def _register_buttons(self):
        """Every button that would start a command, to grey while one runs.

        Collected by walking rather than listed: a button added later would be
        left pressable, and the failure - two pkexec prompts stacked on each
        other - is not one anybody would connect back to a list here. The one
        that only folds something away stays live: it starts nothing, so
        greying it would be the window taking away a control for no reason.
        """
        folds = {str(self.details)}
        self._busy_buttons = []

        def walk(widget):
            for child in widget.winfo_children():
                if isinstance(child, ttk.Button) and str(child) not in folds:
                    self._busy_buttons.append(child)
                walk(child)

        walk(self.root)

    def _set_window_icon(self):
        """The same icon the menu entry uses, in the titlebar and task bar.

        Optional in every direction - the file may be missing, and Tk reads
        PNG only from 8.6 on. A default icon is not worth failing over.
        """
        icon = ledpanel.panel_icon(SOURCE_DIR)
        if not os.path.isabs(icon):
            return                              # a theme name, not a file
        try:
            picture = tk.PhotoImage(file=icon)
        except tk.TclError:
            return
        _IMAGES.append(picture)                 # Tk keeps no reference itself
        self.root.iconphoto(True, picture)

    def _load_config(self):
        try:
            return config_module.load()
        except (config_module.ConfigError, OSError) as exc:
            self._say("Configuration",
                      "Could not read %s:\n%s\n\nShowing defaults instead."
                      % (config_module.DEFAULT_CONFIG_PATH, exc))
            return dict(config_module.DEFAULTS)

    def _write(self, text, tag=None):
        """Put a line where a log belongs, which is not in this window.

        There is no log pane. Nine lines of command output were a fifth of the
        window spent on something almost nobody reads, and the people who do
        want it are better served by a terminal, where the output is
        selectable, searchable and does not disappear with the window. So it
        goes to stderr, which is where the terminal, the journal and anything
        wrapping this program are already looking.

        Nothing is kept here. The window used to hold a copy so the status bar
        could show the last line of it; the bar says one fixed sentence now -
        see PROBLEM_TEXT - and a list nobody reads is a session-long leak.

        It cannot raise. The README tells people to start this from a
        terminal, and a terminal closed while the window stays open leaves a
        broken pipe: writing to it throws, and an exception here would come
        out of the middle of an install.

        `tag` is accepted and ignored. It is the Runner's contract - it marks
        its own two bookend lines with one - and honouring the signature keeps
        the Runner usable by anything else that wants a plain writer.
        """
        try:
            print(text, end="", file=sys.stderr)
        except (OSError, ValueError):
            pass                                # nobody is reading it any more

    def _say_problem(self, failed):
        """Show or clear the warning beside the status lights.

        One line, in the error colour, beside the lights that say whether the
        bar and the television are there - the things in this window that
        report a state rather than set one, in the same place.

        It says the same thing every time. What it used to say was the failing
        command's own last line, which had to be cut to fit the room left over
        beside the indicators, and a complaint cut off at the end has had the
        useful half removed. This points at where the whole of it is instead.
        """
        if not failed:
            self.problem.pack_forget()
            return
        self.problem.pack(side="left", padx=(GROUP_GAP, 0))

    # -- the pieces a page is built from ----------------------------------

    def _section(self, parent, title=None, first=False, before=None):
        """A named group of controls, with no box drawn round it.

        Material tells groups apart by a heading and the space around them
        rather than by a line, which is what keeps a page of thirty settings
        from reading as thirty compartments.

        The heading goes *inside* the frame this returns rather than beside it,
        so a group is one widget: something packed before it lands above the
        heading and not between the heading and what it names.
        """
        holder = ttk.Frame(parent)
        holder.pack(fill="x", padx=SIDE_MARGIN,
                    pady=(ROW_GAP if first else GROUP_GAP, 0),
                    **({"before": before} if before is not None else {}))
        if title:
            ttk.Label(holder, text=title, style="Section.TLabel").pack(
                anchor="w", pady=(0, ROW_GAP))
        return holder

    def _build_settings(self, parent, groups, note=None):
        """One tab: a heading per group, a row per setting.

        One grid for the whole tab rather than one per group, headings included
        as rows spanning it. A grid per group sizes its label column to its own
        longest label, so the controls of one group started at a different x
        than the next - two ragged columns down a page whose whole point is
        that it is a list.

        `note` is a line under the lot, for a page whose rows cannot say for
        themselves when they apply. Under rather than over: it explains what
        you have just read.
        """
        outer = ttk.Frame(parent, style="Page.TFrame")
        grids = []

        row = 0
        headed = False
        for index, (title, entries) in enumerate(groups):
            # A card per group. One grid for the whole page would keep the
            # label column aligned by itself, which is why it used to be one -
            # but a page of thirty settings on one flat field is what made the
            # light theme read as a wall, and the cards are what the eye rests
            # against. The alignment is put back below instead, by hand.
            card = ttk.Frame(outer, style="Card.TFrame")
            card.pack(fill="x", padx=SIDE_MARGIN,
                      pady=(ROW_GAP if index == 0 else GROUP_GAP, 0))
            grid = ttk.Frame(card)
            grid.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
            grids.append(grid)
            # The slack goes to the last of the control columns, not the
            # first. On the first it would push the colour menus away from the
            # switches they belong to; here a slider still has somewhere to
            # stretch into, because a slider spans all three.
            grid.columnconfigure(SHAPE_COLUMN, weight=1)
            row = 0
            if title:
                ttk.Label(grid, text=title, style="Section.TLabel").grid(
                    row=row, column=0, columnspan=2, sticky="w",
                    pady=(0, ROW_GAP))
                row += 1
            # Once, over the first group that has them. The columns line up
            # all the way down - see _align below - so a second set of
            # headings further on would only be repeating itself.
            if not headed and any(entry[2] == FLASH for entry in entries):
                headed = True
                for column, heading in ((COLOUR_COLUMN, "Colour"),
                                        (SHAPE_COLUMN, "Shape")):
                    ttk.Label(grid, text=heading, style="Muted.TLabel").grid(
                        row=row, column=column, sticky="w", pady=(0, ROW_PAD),
                        padx=(LOOK_GAP if column == COLOUR_COLUMN else 0,
                              ROW_GAP))
                row += 1
            # A block is a switch with stepped-in rows under it. The extra
            # space goes above the switch that opens one, above the first row
            # under it, and above the row that follows the last of them - so a
            # switch has the same gap either side of it, and what belongs to it
            # is what is stepped in and packed close underneath.
            indents = [self._indent(entry[0]) for entry in entries]
            for position, entry in enumerate(entries):
                here = indents[position]
                before = indents[position - 1]
                after = (indents[position + 1]
                         if position + 1 < len(indents) else 0)
                fenced = (here == 0 and (after > 0 or before > 0)
                          or here > 0 and before == 0
                          # Two stepped-in rows that can never be on the page
                          # together are two blocks, however close together
                          # they are written: whichever of them is showing is
                          # the first row under the choice that brought it,
                          # and wants the same room under it as the other one.
                          or (position
                              and self._exclusive(entry[0],
                                                  entries[position - 1][0])))
                self._build_row(grid, row, *entry,
                                lead=BLOCK_GAP if position and fenced else 0)
                row += 1
        self._align(grids)
        if note:
            # On the page under the cards, not inside one: it is about the
            # page as a whole rather than about the last group on it.
            said = self._note(outer, note, page=True)
            said.pack(anchor="w", padx=SIDE_MARGIN, pady=(GROUP_GAP, 0))
        return outer

    @staticmethod
    def _align(grids):
        """One label column width across every card on the page.

        What a single grid used to do for free. A grid sizes its first column
        to its own longest label, so cards left to themselves start their
        controls at a different x apiece - which is several ragged columns
        down a page whose whole point is that it is a list.
        """
        widest = 0
        for grid in grids:
            for child in grid.grid_slaves(column=0):
                if int(child.grid_info().get("columnspan", 1)) == 1:
                    widest = max(widest, child.winfo_reqwidth())
        for grid in grids:
            grid.columnconfigure(0, minsize=widest + GROUP_GAP)

    @staticmethod
    def _switches(need):
        """The keys one rule watches, as a tuple - one of them, or several."""
        return need[0] if isinstance(need[0], tuple) else (need[0],)

    @classmethod
    def _wanted(cls, needs, switch):
        """Which answers from `switch` this row accepts, as a set."""
        for need in needs:
            if isinstance(need, tuple) and switch in cls._switches(need):
                value = need[1]
                return set(value if isinstance(value, tuple) else (value,))
        return set()

    def _exclusive(self, key, other):
        """Whether these two rows can never be on the page at the same time.

        Which is not the same as "they hang off different rules". The desktop
        scene's colour and its brightness hang off different lists of scenes
        and are on the page together under three of them - one block. The
        temperature marks and the load gauge's colours hang off answers from
        the same choice that share nothing, so they are two.
        """
        needs, theirs = DEPENDS_ON.get(key, ()), DEPENDS_ON.get(other, ())
        for switch in {switch for need in needs if isinstance(need, tuple)
                       for switch in self._switches(need)}:
            mine, yours = self._wanted(needs, switch), self._wanted(theirs,
                                                                   switch)
            if yours and not (mine & yours):
                return True
        return False

    def _indent(self, key):
        """How far in a setting sits, by what it hangs off.

        A row that only needs the tab's own master switch stays at the margin;
        one that also needs a particular row above it is stepped in under it,
        which is what makes the three notification blocks read as blocks rather
        than as twelve equal lines. A row waiting on a *choice* - the
        temperature marks, which mean nothing unless the slot is showing the
        temperature - is stepped in for the same reason.
        """
        needs = DEPENDS_ON.get(key, ())
        return (max(0, len(needs) - 1)
                + (1 if any(isinstance(need, tuple) for need in needs) else 0))

    def _build_row(self, grid, row, key, label, kind, low, high, step,
                   lead=0):
        """One setting: its name, its control, and a way to grey both out.

        `lead` is extra room above, for a row that begins a block. The row's
        own padding is the same everywhere, which is what makes the column
        regular now that the controls in it all stand the same height.
        """
        if kind == "power" and key == "CPU_EPP" and not power.epp_values():
            # Not greyed and not hidden: never built. A driver in passive mode
            # has no preference file at all, and a menu with nothing in it is
            # a row about a setting this machine does not have. Left out of
            # self.vars too, so nothing collects it and nothing compares it -
            # see _collect_power, which keeps the stored value instead.
            return
        minsize = self.roles["_sizes"]["control"] + 2 * ROW_PAD + lead
        grid.rowconfigure(row, minsize=minsize)
        name = ttk.Label(grid, text=label)
        name.grid(row=row, column=0, sticky="w", pady=(ROW_PAD + lead, ROW_PAD),
                  padx=(self._indent(key) * INDENT_STEP, GROUP_GAP))
        value = self._saved(key)
        labels, controls = [name], []
        # What actually sits in this grid, which is not the same list: a
        # slider is two widgets inside a frame, and it is the frame the grid
        # knows about. Taking a row away means taking these - see _set_enabled.
        occupies = [name]

        if kind in ("bool", FLASH, FIXED):
            variable = tk.BooleanVar(value=bool(value))
            control = ttk.Checkbutton(grid, variable=variable)
            control.grid(row=row, column=CONTROL_COLUMN, sticky="w",
                         pady=(ROW_PAD + lead, ROW_PAD))
            controls.append(control)
            occupies.append(control)
            self._follow(variable)
            if kind == FLASH:
                self._build_look(grid, row, low, lead=lead)
            elif kind == FIXED:
                # What the two menus would have said, where they would have
                # been. A blank there reads as a setting that failed to draw.
                said = ttk.Label(grid, text=low, style="Muted.TLabel")
                said.grid(row=row, column=COLOUR_COLUMN, columnspan=2,
                          sticky="w", padx=(LOOK_GAP, 0),
                          pady=(ROW_PAD + lead, ROW_PAD))
                occupies.append(said)
        elif kind in ("choice", "sensor", "named", "power", "theme"):
            # Entries that are labels for something else - see the menu
            # helpers in ledpanel. A "choice" is the case where the label and
            # the value are the same word. "sensor" and "power" are the two
            # that are read off the machine when the row is built rather than
            # written into the settings table: what a machine offers is not
            # something this file can know, and a list here would be a list
            # that is wrong on somebody's hardware.
            variable = tk.StringVar()
            choices = (ledpanel.sensor_choices(*ledpanel.read_sensors(),
                                               current=str(value))
                       if kind == "sensor"
                       else appsettings.theme_choices() if kind == "theme"
                       else ledpanel.power_choices(
                           power.governors() if key == "CPU_GOVERNOR"
                           else power.epp_values(),
                           current=str(value), labels=power.LABELS,
                           unset=key == "CPU_GOVERNOR")
                       if kind == "power"
                       else [(entry, entry) for entry in low]
                       if kind == "choice" else list(low))
            self._menu(grid, row, key, variable, choices, str(value),
                       width=(SENSOR_WIDTH
                              if kind in ("sensor", "power", "theme")
                              else MENU_WIDTH),
                       lead=ROW_PAD + lead)
            controls.append(self._widgets[key])
            occupies.append(self._widgets[key])
            self._follow(variable)
            if kind == "theme":
                # Not through _follow's unsaved count: this one has no Apply
                # to wait for. after_idle so the menu has finished closing
                # itself before the window it is standing in is replaced.
                variable.trace_add(
                    "write",
                    lambda *_a: self.root.after_idle(self._theme_chosen))
        else:
            variable = tk.DoubleVar(value=float(value))
            scale, readout, holder = self._scale(grid, row, variable, low,
                                                 high, step,
                                                 lead=ROW_PAD + lead)
            controls.append(scale)
            self._follow(variable)
            labels.append(readout)
            occupies.append(holder)

        self.vars[key] = (variable, "bool" if kind in (FLASH, FIXED) else kind)
        self._rows[key] = (labels, controls)
        # Only what a row that can be taken away needs, and kept apart from
        # _rows because everything else reads that as a pair.
        self._row_places[key] = (grid, row, minsize, occupies)

    def _build_look(self, grid, row, prefix, lead=0):
        """The colour and the shape of one notification, beside its switch.

        Registered as settings of their own, under their own keys: that is
        what lets DEPENDS_ON grey them with the switch they sit next to, and
        what lets Apply collect them, without either knowing that the three
        now share a line. The keys are built from the prefix, which is the
        same one the service spells them under - see CONFIGURABLE_KINDS.
        """
        for column, key, choices, width in (
                (COLOUR_COLUMN, prefix + "_COLOR",
                 ledpanel.NOTIFICATION_COLOURS, COLOUR_WIDTH),
                (SHAPE_COLUMN, prefix + "_STYLE", KIND_STYLE_CHOICES,
                 SHAPE_WIDTH)):
            variable = tk.StringVar()
            value = str(self.config.get(key, config_module.DEFAULTS[key]))
            field = self._field(grid, key, variable, list(choices), value,
                                width=width)
            field.grid(row=row, column=column, sticky="w",
                       padx=(LOOK_GAP if column == COLOUR_COLUMN else 0,
                             ROW_GAP),
                       pady=(ROW_PAD + lead, ROW_PAD))
            self._follow(variable)
            self.vars[key] = (variable, "named")
            self._rows[key] = ([], [field])

    def _follow(self, variable):
        """Watch a control, so the window can keep up with it.

        Anything can be the setting another row hangs off - a switch or a
        menu - and following one costs nothing, so every candidate is followed
        rather than DEPENDS_ON having to be kept in step by hand. Every kind
        is followed and not only those: the count of what is unsaved has to
        move when any control does, sliders included.
        """
        variable.trace_add("write", self._settings_changed)

    def _settings_changed(self, *_args):
        """A control moved. Book the catching-up rather than doing it here.

        Dragging a slider delivers a motion event for every pixel the pointer
        travels, and each one of them lands here. Working through every
        dependent row and every unsaved setting on each was measured at nine
        milliseconds - call it ninety per cent of a core while a knob is
        moving, and the window repainted as fast as the events arrived, which
        is what put the desktop's own load gauge up.

        Booked for the next idle moment instead. Tk runs idle work before it
        redraws, so the window still catches up before anything is seen; it
        just does it once per redraw rather than once per pixel.
        """
        if self._catching_up is None:
            self._catching_up = self.root.after_idle(self._catch_up)

    def _catch_up(self, *_args):
        """Everything the window owes a control that moved."""
        self._catching_up = None
        self._refresh_enabled()
        self._refresh_unsaved()

    def _saved(self, key):
        """What is on disk for this setting, from whichever file holds it.

        The one place the window has to know that its rows come from two
        files. Everything else - the unsaved count, the controls a page is
        built from, Reload - goes through here and does not have to care.
        """
        if key in SYSTEM_KEYS:
            return self.system.get(key, syssettings.DEFAULTS[key])
        if key in POWER_KEYS:
            return self.power.get(key, power.DEFAULTS[key])
        if key in APP_KEYS:
            return self.app.get(key, appsettings.DEFAULTS[key])
        return self.config.get(key, config_module.DEFAULTS[key])

    def _differences(self):
        """Which settings in the window are not what the file holds.

        Read leniently, the way the preview reads them - this runs on every
        step of a drag, and a value being half-entered is not the moment to
        complain about it.
        """
        changed = []
        for key, (variable, kind) in self.vars.items():
            saved = self._saved(key)
            try:
                raw = variable.get()
            except (ValueError, tk.TclError):        # pragma: no cover
                continue
            if kind == "bool":
                same = bool(raw) == bool(saved)
            elif kind in ("sensor", "named", "power", "theme"):
                # What is shown against what the file's value would show, so a
                # colour written in capitals in the file is not a change.
                same = raw == self._label_for(key, str(saved))
            elif kind in ("int", "float"):
                try:
                    same = abs(float(raw) - float(saved)) < 1e-9
                except (TypeError, ValueError):      # pragma: no cover
                    same = False
            else:
                same = str(raw) == str(saved)
            if not same:
                changed.append(key)
        return changed

    def _refresh_unsaved(self):
        """Say what is in the window and not in the file, and gate Apply on it.

        A button that is always pressable says nothing about whether pressing
        it would do anything. This one goes dead when the window and the file
        agree, which is also the answer to "did I already apply that?".
        """
        count = len(self._differences())
        self.unsaved.configure(
            text="" if not count
            else "1 unsaved change" if count == 1
            else "%d unsaved changes" % count)
        apply_button = self._apply_buttons[0][1]
        apply_button.state(["!disabled"] if count else ["disabled"])

    def _refresh_enabled(self):
        """Grey out every setting whose switch is off."""
        for key, needs in DEPENDS_ON.items():
            if key not in self._rows:
                continue
            self._set_enabled(key, all(self._satisfied(need) for need in needs))

    def _satisfied(self, need):
        """Whether one DEPENDS_ON entry is met.

        Switched on, set to this, or set to any one of these - the last
        because a menu with nine entries can have three of them mean the same
        thing to the row below, and three rules saying so would each have to
        be met at once.

        A rule watching more than one menu is met if any of them says so, for
        the same reason the other way round: the temperature marks are in play
        whether Game Mode's slot or the desktop's scene is showing the gauge.
        """
        wanted = None
        if isinstance(need, tuple):
            need, wanted = need
        if wanted is None:
            if need not in self.vars:
                return True             # not on any tab, nothing to hang off
            return bool(self.vars[need][0].get())
        switches = [switch for switch in self._switches((need, wanted))
                    if switch in self.vars]
        if not switches:
            return True
        return any(self._answers(switch, wanted) for switch in switches)

    def _answers(self, switch, wanted):
        """Whether one menu is set to the value, or to one of the values."""
        variable, kind = self.vars[switch]
        # A menu holds the label it shows, not the value it stands for.
        shown = variable.get()
        if kind in ("sensor", "named", "power", "theme"):
            shown = self._value_for(switch, shown)
        if isinstance(wanted, tuple):
            return shown in wanted
        return shown == wanted

    def _hides(self, key):
        """Whether this row is taken away rather than greyed while it is off.

        By what it hangs off, not by a list: a rule naming a value is a
        *choice*, and the rows waiting on one belong to whichever thing the
        slot is holding. See the note above DEPENDS_ON for why the two kinds
        are answered differently.
        """
        return any(isinstance(need, tuple) for need in DEPENDS_ON.get(key, ()))

    def _set_enabled(self, key, on):
        labels, controls = self._rows[key]
        if self._hides(key):
            grid, row, minsize, occupies = self._row_places[key]
            if bool(occupies[0].grid_info()) == bool(on):
                return
            # grid_remove rather than grid_forget: it remembers the placement,
            # so the row comes back where it belongs instead of at the bottom
            # of the page.
            for widget in occupies:
                widget.grid() if on else widget.grid_remove()
            # And the row's floor with it. Every row is given one so a column
            # of switches, menus and sliders keeps one rhythm - but a floor
            # under an empty row is the gap the row used to fill, which is
            # exactly what taking it away was meant to close.
            grid.rowconfigure(row, minsize=minsize if on else 0)
            return
        # Nothing to do when the row already looks like that, which is almost
        # every time: one moved control asks this of every row that hangs off
        # anything, and hardly any of them hang off the one that moved. Over
        # a slider drag, measured: eleven hundred of these in fifty steps, and
        # not one of them a change.
        #
        # Read back off the widget rather than remembered here. _set_busy
        # wakes every button in the window without coming through this, so an
        # answer kept on the side would be stale exactly when it matters -
        # which is the Apply that left a greyed colour ungreyed.
        if controls and ("disabled" not in controls[0].state()) == bool(on):
            return
        for label in labels:
            # Labels take a disabled state but clam draws them the same, so
            # the muted style does the greying that people actually see.
            label.configure(style="TLabel" if on else "Muted.TLabel")
        for control in controls:
            control.state(["!disabled"] if on else ["disabled"])
        # A greyed field is painted in a shade of its own, so a swatch baked
        # against the ordinary one now stands on it as a box. Drawn again
        # rather than left, and after the state is set, because that is what
        # it is read from.
        if key in self._widgets:
            self._show_swatch(key)

    def _note(self, parent, text, page=False, **kwargs):
        """A line of explanation that wraps at the window's width, not at 580.

        A fixed wraplength breaks mid-sentence on a wide window and leaves the
        right half of it empty, which is what made this page look ragged.

        `page` is for the ones that stand under the cards rather than inside
        one, which need the ground behind them to match.
        """
        label = ttk.Label(parent, text=text, justify="left",
                          style="Page.Muted.TLabel" if page
                          else "Muted.TLabel", wraplength=560, **kwargs)
        self._wrapped.append(label)
        return label

    def _rewrap(self, event):
        """Follow the width of the page - only when it actually changed.

        Bound to the notebook rather than to the window, and for two reasons.
        The page is narrower than the window by the whole rail, so wrapping to
        the window's width laid the text out wider than the page it sits in and
        it was cut off at the right edge rather than wrapped. And asking the
        notebook how wide it is while handling the *window's* Configure gives
        the width it had before the resize - measured, the wrapping stayed one
        resize behind, so making the window smaller clipped the text until it
        was resized again. The notebook's own Configure carries the width it is
        about to have.

        A toplevel is in the bindtags of every widget under it, so the same
        binding on the window ran for each child's Configure too, with that
        child's width: measured, it once saw 14 px from a scrollbar, wrapped
        every explanation into a column, changed the layout and was called
        again - a window flickering between two sizes until it was killed. A
        widget is not in its children's bindtags, so binding here cannot see
        anyone else's size; the guard stays as a statement of that.

        Setting wraplength can also bring a Configure straight back, which is
        what comparing the width first ends.
        """
        # Either notebook: a section that is one page of its own is as much a
        # page with explanations on it as one of the strip's, and left out of
        # this its text was laid out on one line - which a toplevel takes as a
        # request, so the window opened two and a half thousand pixels wide.
        if event.widget not in (self.notebook, self.sections):
            return
        # Less the scrollbar, whether this page has one or not.
        #
        # A page long enough to scroll gives its bar fourteen pixels off the
        # side, and the notebook's width does not know that - so text on a
        # scrolling page was laid out that much wider than the room it had,
        # and a label wider than its slot is not wrapped, it is cut off. It
        # showed up as exactly one pixel over, because a wrap only fails when
        # a word happens to straddle the edge; the error was fourteen all
        # along and this was the first page long enough to reveal it.
        #
        # Reserved on every page rather than only where a bar is showing:
        # whether one is depends on the window height, so wrapping would
        # otherwise change when the window is made shorter.
        width = max(320, min(event.width, CONTENT_MAX)
                    - 3 * SIDE_MARGIN - SCROLLBAR_ROOM)
        if width == self._wrap_width:
            return
        self._wrap_width = width
        for label in self._wrapped:
            label.configure(wraplength=max(
                160, width - self._wrap_insets.get(str(label), 0)))

    def _build_apply(self, parent):
        """Apply and Reload, once, below the tabs that have settings.

        They were in each settings tab before, with a line explaining that
        Apply writes the other tab too. One row under all of them says the
        same thing by standing where it does - but only under the tabs it
        belongs to: on Status & repair it sat right below the firmware box
        and read like "apply the firmware".

        The buttons go away on the tabs that have none; the row they stand in
        stays and keeps its height. Taking the row itself out of the layout
        moved everything below it by that height on every tab change, which
        is a whole window shifting under the pointer.
        """
        self.apply_row = ttk.Frame(parent, style="Page.TFrame")
        self.apply_row.pack(side="bottom", fill="x",
                            padx=SIDE_MARGIN + SIDE_MARGIN // 2,
                            pady=(GROUP_GAP, GROUP_GAP))
        # Two pairs, and the width between them says which is which: what to do
        # with the settings in this window on the left, what to do with a file
        # of settings on the right. Packed to the two edges rather than
        # huddled at one - the row is the width of the window and was using a
        # third of it.
        #
        # Profiles sit here rather than on a page of their own: this is already
        # the row for "what to do with these settings", and a profile is those
        # settings by another name.
        self._apply_buttons = [
            # Not "Apply and restart service" any longer. The System page's
            # settings restart nothing - they are the machine's, they take
            # effect at the next login - so a button promising a restart would
            # be describing what happens to only some of what it saves.
            ("left", ttk.Button(self.apply_row,
                                text="Apply changes",
                                style="Page.Filled.TButton",
                                command=self.apply_settings)),
            ("left", ttk.Button(self.apply_row, text="Reload from file",
                                style="Page.Tonal.TButton",
                                command=self.reload_settings)),
            # Right-hand ones in reverse: pack puts each new one to the left of
            # the last, so this is what reads Save, Load across the page.
            ("right", ttk.Button(self.apply_row, text="Load profile...",
                                 style="Page.Outlined.TButton",
                                 command=self.load_profile)),
            ("right", ttk.Button(self.apply_row, text="Save profile...",
                                 style="Page.Outlined.TButton",
                                 command=self.save_profile)),
        ]
        # What is in the window but not yet in the file. A settings window that
        # does not say whether it has been saved is asking you to remember, and
        # nobody does - so Apply goes dead when there is nothing to apply, and
        # this says how much there is when there is.
        self.unsaved = ttk.Label(self.apply_row,
                                 style="Page.Muted.TLabel")
        self._show_apply(True)
        self._refresh_unsaved()

    def _show_apply(self, show):
        self._apply_shown = show
        if show:
            self.apply_row.pack_propagate(True)
            for side, button in self._apply_buttons:
                button.pack(side=side, padx=(0, ROW_GAP) if side == "left"
                            else (ROW_GAP, 0))
            # In the gap the two pairs leave between them, which is where the
            # eye already goes to read the row.
            self.unsaved.pack(side="left", padx=GROUP_GAP)
            return
        # Hold the height the buttons had, then take them out: with the row
        # free to shrink, the rest of the window slides up to meet it.
        height = self.apply_row.winfo_height()
        if height > 1:
            self.apply_row.configure(height=height)
            self.apply_row.pack_propagate(False)
        for _side, button in self._apply_buttons:
            button.pack_forget()
        self.unsaved.pack_forget()

    def _tab_changed(self, _event=None):
        """Only show Apply where there is something to apply.

        Two levels to ask now. A section that is one table of settings always
        has something; the LED strip has something only on four of its seven
        pages; and the two unbuilt sections and About never do.
        """
        # The rail follows the notebook rather than the other way round, so a
        # page selected in code - or by a keyboard shortcut - is still the one
        # the rail says is open.
        self._rail_choice.set(self.notebook.select())
        show = self._has_settings()
        if show != self._apply_shown:
            self._show_apply(show)
        # The preview only runs while it can be seen.
        if self._preview_visible() and self._preview_job is None:
            self._preview_started = time.monotonic()
            self._preview_tick()

    def _open_page(self):
        """The scrolling page actually on screen, of either notebook.

        Two levels means two answers, and the wheel needs the one in front of
        you: asked of the inner notebook alone it scrolled the LED strip's
        page while you were looking at a different section entirely.
        """
        if getattr(self, "section", None) == "strip":
            return self.notebook.select()
        return self._section_pages.get(getattr(self, "section", None))

    def _has_settings(self):
        """Whether what is on screen right now is settings to be applied."""
        if getattr(self, "section", None) is None:
            return False
        if self.section in SECTION_SETTINGS:
            # Unless everything on it takes effect the moment it is picked,
            # which is the App Settings page. An Apply row under a page whose
            # only setting has already applied itself is a button that says
            # there is something outstanding when there is not.
            table, _note = SECTION_SETTINGS[self.section]
            return any(row[0] not in APP_KEYS
                       for _title, rows in table for row in rows)
        if self.section != "strip":
            return False
        return self.notebook.select() in self._settings_tabs

    def _field(self, parent, key, variable, choices, current, width=None):
        """A drop-down of (label, value) pairs, showing labels.

        A field of our own rather than a combobox, for two reasons. A combobox
        drops down a Tk listbox: a listbox holds text and nothing else, so a
        list of colours cannot show the colours - and picking "Hot Pink" out of
        a column of words was the one place in a window about light where you
        could not see what you were choosing. And Tk posts that listbox under a
        grab it does not let go of, so it went on floating over whatever was
        raised next. See Popup for both.

        Returned unplaced: the settings grid and the rows on Status & repair
        lay themselves out differently, and where it goes is not this
        helper's business. `key` names it among the drop-downs - a setting's
        own name for a setting, a lower-case word for the rest, which cannot
        collide because config names are upper case.
        """
        self._menus[key] = list(choices)
        button = ttk.Button(parent, textvariable=variable,
                            style="Field.TButton", compound="left",
                            command=lambda: self._open_menu(key))
        if width is not None:
            button.configure(width=width)
        self._widgets[key] = button
        self._menu_parts[key] = variable
        # The button carries the swatch of whatever is chosen, so the colour is
        # readable without opening anything.
        variable.trace_add("write", lambda *_a: self._show_swatch(key))
        variable.set(self._label_for(key, current))
        self._show_swatch(key)
        return button

    def _menu(self, grid, row, key, variable, choices, current, width,
              lead=0):
        """One of those in a settings row, beside the name of the setting."""
        self._field(grid, key, variable, choices, current, width).grid(
            row=row, column=CONTROL_COLUMN, columnspan=CONTROL_SPAN,
            sticky="w", pady=(lead, ROW_PAD))

    def _open_menu(self, key):
        """Drop this one down, having taken down whatever else was open.

        Pressing the field a second time closes the list rather than opening
        it again: the press already took it down - see _panel_click - and this
        is the release that follows.
        """
        showing = self._popup.key if self._popup is not None else None
        self._dismiss_menus()
        if showing == key:
            return
        self._popup = Popup(self._widgets[key], key, self.roles,
                            self._menus[key], self._menu_parts[key],
                            self._swatch, self._menu_closed)

    def _swatch(self, value, ground, keep=True):
        """A square of colour for a menu entry, or None if this is not one.

        Told by the value rather than by a list of which settings are colours:
        anything the config file holds as #rrggbb is one, and a colour setting
        added later gets its swatch without anything here being told.

        `ground` is a role name or a colour outright, because the shade behind
        a swatch is not always one of the named ones - see _ground_under.
        """
        if not _COLOUR.match(str(value)):
            return None
        shade = self.roles.get(ground, ground)
        square = roundrect.rows(
            SWATCH_SIZE, SWATCH_SIZE, material.SHAPE_EXTRA_SMALL, value,
            shade, border=self.roles["outline"], border_width=1)
        # Wider than it is tall: a menu entry has no padding to give, so the
        # gap between the colour and its name is part of the picture.
        blank = [shade] * SWATCH_GAP
        return _photo([row + blank for row in square], keep=keep)

    # -- swatches on widgets that change shade under them ------------------
    #
    # A swatch has no alpha. It carries its ground in its rounded corners and
    # in the gap beside it - forty-four of a swatch's one hundred and ninety
    # six pixels are a blend of the colour and whatever is behind it - so one
    # baked against the wrong shade appears as a box behind the colour. In the
    # light theme the shades are near enough that nothing shows; in the dark
    # one it is plainly a dark rectangle, which is how this was reported.
    #
    # Which shade is right is not decided once. A field greys its fill when it
    # is disabled and a button blends its own under the pointer, so the ground
    # is a question to be asked again whenever the answer can have moved. The
    # two tables below mirror the pictures in apply_theme: a field's fill only
    # moves when it is disabled, an ordinary button's moves for hover and
    # press as well.
    FIELD_STATES = ()
    BUTTON_STATES = (("pressed", material.STATE_PRESSED),
                     ("active", material.STATE_HOVER))

    def _ground_under(self, widget, base="surface", states=FIELD_STATES):
        """The colour actually behind a swatch on this widget, right now."""
        showing = widget.state()
        if "disabled" in showing:
            return material.disabled_container(self.roles)
        shade = self.roles[base]
        for name, weight in states:
            if name in showing:
                return material.blend(shade, self.roles["on_surface"], weight)
        return shade

    def _dress(self, widget, value, base="surface", states=FIELD_STATES):
        """Draw the swatch this widget should be wearing at this moment.

        Held by the widget rather than by the window: it is drawn again every
        time the shade moves, and a list of every image ever made would grow
        for as long as somebody kept the pointer moving.
        """
        image = self._swatch(value, self._ground_under(widget, base, states),
                             keep=False)
        widget.configure(image=image or "")
        widget._swatch_image = image                        # keeps it alive

    def _follow_shade(self, widget, value, base="surface",
                      states=BUTTON_STATES):
        """Dress a widget now, and again whenever the pointer changes it.

        For the buttons that blend their own fill. A field does not need this
        - its fill only moves when it is disabled, and _set_enabled says so.
        """
        self._dress(widget, value, base, states)
        for when in ("<Enter>", "<Leave>", "<ButtonPress-1>",
                     "<ButtonRelease-1>"):
            # after_idle, because the state is set by the binding ttk installs
            # and ours can run first - reading it here would report the state
            # the widget is leaving.
            widget.bind(when, lambda _e, w=widget, v=value, b=base, s=states:
                        w.after_idle(self._dress, w, v, b, s), add="+")

    def _panel_click(self, event):
        """A click anywhere in the panel takes an open drop-down down.

        What the grab used to do, done where it can be done without one. A
        click inside the list itself does not come here: a toplevel is in the
        bindtags of its own children only, and the list is a toplevel of its
        own.
        """
        if self._popup is None or event.widget is self._popup.owner:
            return                              # the field toggles itself
        self._dismiss_menus()

    def _menu_closed(self):
        self._popup = None

    def _dismiss_menus(self, _event=None):
        """Take down the drop-down, if one is standing open."""
        if self._popup is not None:
            self._popup.close()

    def _show_swatch(self, key):
        """Put the chosen colour on the button, where it can be seen."""
        button = self._widgets[key]
        self._dress(button, self._value_for(key, button.cget("text")))

    def _label_for(self, key, value):
        """The entry for a configured value, added to the menu if it is new.

        Editing the file by hand and pressing Reload is how these settings are
        meant to be used from a terminal, so a value the menu does not offer
        has to become an entry rather than be silently replaced.
        """
        choices = self._menus[key]
        label = ledpanel.menu_label(choices, value)
        if label is not None:
            return label
        choices.append((value, value))
        return value

    def _value_for(self, key, label):
        """Back from the menu entry to what the config file wants."""
        return ledpanel.menu_value(self._menus[key], label)

    def _scale(self, grid, row, variable, low, high, step, lead=0):
        # Across the three control columns: a slider in the first of them
        # would be as narrow as a switch, and its readout would land under
        # somebody's colour menu.
        holder = ttk.Frame(grid)
        holder.grid(row=row, column=CONTROL_COLUMN, columnspan=CONTROL_SPAN,
                    sticky="ew", pady=(lead, ROW_PAD))
        holder.columnconfigure(0, weight=1)
        readout = ttk.Label(holder, width=6)
        pattern = "%%.%df" % _decimals(step)

        def show(*_args):
            value = variable.get()
            # Snap to the step, so the knob rests where the readout says: a
            # slider showing 2.4 while holding 2.4372 lies. Rounding to the
            # step's decimals also keeps 2.4000000000000004 out of the file.
            snapped = round(round(value / step) * step, _decimals(step))
            snapped = min(max(snapped, low), high)
            # The readout first, and unconditionally. Measured: a ttk.Scale
            # does not call its command again for a value the command itself
            # set, so anything after that set is skipped - and while dragging,
            # every value arrives off the step, so the number beside the
            # slider never moved.
            readout.configure(text=pattern % snapped)
            if abs(value - snapped) > 1e-9:
                variable.set(snapped)

        scale = ttk.Scale(holder, from_=low, to=high, variable=variable,
                          command=show)
        scale.grid(row=0, column=0, sticky="ew")
        readout.grid(row=0, column=1, padx=(6, 0))
        show()
        # The holder too: it is what the outer grid actually holds, so it
        # is what has to go when the row is taken away.
        return scale, readout, holder

    def _collect(self):
        """The service's settings out of the widgets, validated.

        System settings are not in here - see _collect_system. They are a
        different file with a different validator, and putting one of them
        through config_module.validate would be asking the LED service to
        approve a keyboard layout.
        """
        values = {}
        for key, (variable, kind) in self.vars.items():
            if key in SYSTEM_KEYS or key in POWER_KEYS or key in APP_KEYS:
                continue
            raw = variable.get()
            values[key] = (bool(raw) if kind == "bool"
                           else int(round(raw)) if kind == "int"
                           else float(raw) if kind == "float"
                           else self._value_for(key, raw)
                           if kind in ("sensor", "named", "power", "theme")
                           else str(raw))
        # The idle rate cannot exceed the active one, which two independent
        # sliders cannot express. Pulling FPS below IDLE_FPS is an obvious
        # intention, so follow it rather than refuse the adjustment.
        if values["IDLE_FPS"] > values["FPS"]:
            values["IDLE_FPS"] = values["FPS"]
            self.vars["IDLE_FPS"][0].set(float(values["FPS"]))
            self._write("Idle frame rate lowered to %d to stay under the "
                        "active rate.\n" % values["FPS"])

        merged = dict(self.config)
        merged.update(values)
        config_module.validate(merged)      # raises ConfigError
        return values

    def _load_power(self):
        """What the CPU settings file holds. Readable without any rights."""
        return ledpanel.read_power_config()

    def _collect_system(self):
        """The machine's own settings out of the widgets, validated."""
        values = {key: self._value_for(key, self.vars[key][0].get())
                  for key in SYSTEM_KEYS if key in self.vars}
        syssettings.validate(values)        # raises SettingError
        return values

    def _collect_power(self):
        """The CPU settings out of the widgets, checked against the machine.

        Against the machine rather than against a list, and here rather than
        only in the helper: a value this hardware does not offer should be
        refused while the window still has somewhere to show the reason.
        """
        # Started from what the file holds, so a row this machine has no
        # hardware for - the preference, on a driver without one - keeps its
        # stored value instead of vanishing from the config every Apply.
        values = dict(self.power)
        values.update({key: self._value_for(key, self.vars[key][0].get())
                       for key in POWER_KEYS if key in self.vars})
        power.validate(values)              # raises ValueError
        return values

    def apply_settings(self):
        """Put the window into the files, one prompt at most.

        The machine's settings first, because they are the half that needs no
        rights: written here and now, by us, as you. Only the service's half
        goes through pkexec, and only when it has actually changed - a
        keyboard layout should not be asking for a password, and it should not
        be restarting the LED service either.
        """
        try:
            values = self._collect()
        except config_module.ConfigError as exc:
            self._say("Not a usable setting", str(exc))
            return

        try:
            system = self._collect_system()
        except syssettings.SettingError as exc:
            self._say("Not a usable setting", str(exc))
            return
        if system != self.system:
            try:
                syssettings.write(system)
            except OSError as exc:
                self._say("System settings",
                          "Could not write %s:\n%s"
                          % (syssettings.directory(), exc))
                return
            self.system = system
            self._refresh_unsaved()
            self._write("Saved the machine's settings. They take effect at "
                        "the next login.\n\n")

        try:
            cpu = self._collect_power()
        except ValueError as exc:
            self._say("Not a usable setting", str(exc))
            return
        if cpu != self.power:
            # Its own prompt, and only when it changed. Two prompts in a row
            # is not lovely, but they are two different files installed by two
            # different helpers - and the alternative is one helper that does
            # everything, which is the shape this project deliberately does
            # not have. See scripts/apply-power.sh.
            staged = tempfile.NamedTemporaryFile(
                "w", suffix=".conf", prefix="steamos-led-power-", delete=False)
            with staged:
                staged.write(ledpanel.power_config_text(cpu))
            os.chmod(staged.name, 0o644)

            def cpu_done(code, path=staged.name, wanted=dict(cpu)):
                os.unlink(path)
                if code == 0:
                    self.power = wanted
                    self._refresh_unsaved()

            self.runner.start(
                ledpanel.apply_power_command(SOURCE_DIR, staged.name),
                cpu_done)

        if values == {key: self.config.get(key, config_module.DEFAULTS[key])
                      for key in values}:
            # Nothing of the service's changed, so there is nothing to install
            # and nothing to restart. Without this, changing only a system
            # setting would still ask for a password and bounce the bar.
            return

        try:
            with open(config_module.DEFAULT_CONFIG_PATH) as handle:
                text = handle.read()
        except OSError:
            # No config yet: start from the one shipped in the repository so
            # its comments come along.
            shipped = os.path.join(SOURCE_DIR, "server",
                                   "steamos-led-serial.conf")
            try:
                with open(shipped) as handle:
                    text = handle.read()
            except OSError as exc:
                self._say("Configuration", str(exc))
                return

        staged = tempfile.NamedTemporaryFile(
            "w", suffix=".conf", prefix="steamos-led-", delete=False)
        with staged:
            staged.write(config_module.update_text(text, values))
        os.chmod(staged.name, 0o644)

        def finished(code):
            os.unlink(staged.name)
            if code != 0:
                self.refresh_status()
                return
            self.config.update(values)
            self._refresh_unsaved()
            # The helper restarted the service, but the two watchers read the
            # same file and are user units, out of its reach - without this a
            # changed flash setting waits for the next game to end, and
            # switching the phone flashes on or off does not take at all.
            self.runner.start(ledpanel.restart_watchers_command(),
                              lambda _code: self.refresh_status())

        self.runner.start(
            ledpanel.apply_config_command(SOURCE_DIR, staged.name), finished)

    def _show_values(self, values):
        """Put these settings into the controls. Keys we do not show are
        ignored, and anything missing falls back to the shipped default."""
        shown = 0
        for key, (variable, kind) in self.vars.items():
            if key not in values:
                continue
            value = values[key]
            variable.set(bool(value) if kind == "bool"
                         else self._label_for(key, str(value))
                         if kind in ("sensor", "named", "power", "theme")
                         else str(value) if kind == "choice"
                         else float(value))
            shown += 1
        self._catch_up()                # now: the caller reports what it did
        return shown

    def reload_settings(self):
        """Both files back into the window, throwing away what is unsaved.

        Both, because the button says "Reload from file" and the window is
        showing two of them. Reloading only the service's would leave the
        System page showing an edit that Reload appeared to have discarded.
        """
        self.config = self._load_config()
        self.system = syssettings.read()
        merged = dict(config_module.DEFAULTS)
        merged.update(self.config)
        merged.update(self.system)
        self._show_values(merged)
        # Said here rather than at the end of load_profile, where it used to
        # be: that one reports what it loaded and then claimed to have
        # reloaded /etc as well, which it had not, while this - the thing that
        # does reload it - said nothing at all.
        self._write("Reloaded %s and %s\n\n"
                    % (config_module.DEFAULT_CONFIG_PATH,
                       syssettings.directory()))

    # -- profiles ---------------------------------------------------------

    def save_profile(self):
        """Write the settings in this window to a file of their own."""
        try:
            values = self._collect()
        except config_module.ConfigError as exc:
            self._say("Not a usable setting", str(exc))
            return

        directory = ledpanel.profiles_dir(SOURCE_DIR)
        try:
            os.makedirs(directory, exist_ok=True)
        except OSError as exc:
            self._say("Profiles", str(exc))
            return

        path = ProfileDialog(self.root, directory, self.roles,
                             saving=True).chosen
        if not path:
            return
        try:
            with open(path, "w") as handle:
                handle.write(ledpanel.profile_text(values))
        except OSError as exc:
            self._say("Profiles", str(exc))
            return
        self._write("Saved %d settings to %s\n\n" % (len(values), path))

    def load_profile(self):
        """Read a profile into the controls - and no further.

        Deliberately not applied: it lands in the window the same way Reload
        does, so you see what arrived before anything is written to /etc.
        """
        directory = ledpanel.profiles_dir(SOURCE_DIR)
        path = ProfileDialog(self.root, directory, self.roles,
                             saving=False).chosen
        if not path:
            return
        try:
            values = ledpanel.read_profile(path)
        except (config_module.ConfigError, OSError) as exc:
            self._say("Profile", str(exc))
            return

        shown = self._show_values(values)
        self._write("Loaded %d settings from %s\n" % (shown, path))
        skipped = len(values) - shown
        if skipped:
            # Options the service has but this window does not - the serial
            # port and its like. Saying so beats letting someone believe they
            # were applied and lost.
            self._write("%d setting(s) in the file are not shown here and "
                        "were left alone.\n" % skipped)
        self._write("Nothing is written yet - press Apply to keep it.\n\n")

    # -- tests ------------------------------------------------------------

    # -- the preview tab ---------------------------------------------------
    #
    # Only the effects this project added. Steam's own can be seen by picking
    # them in Steam, and the standby and startup breaths are states the
    # machine puts itself into rather than anything chosen here.

    # How many buttons fit across the window at its narrowest, which is what a
    # row of them wraps at.
    BUTTONS_ACROSS = 4

    PREVIEW_FPS = 25
    # The stage takes whatever room the page has left and the strip is laid
    # out to fit it, rather than being drawn at one fixed size in the corner.
    # It is the thing this page is for, so it should be the thing on it.
    PREVIEW_CELL_MAX = 56       # a wide window must not give absurd LEDs
    PREVIEW_BAR_MAX = 84
    PREVIEW_BAR_MIN = 22
    PREVIEW_MARGIN = 16
    PREVIEW_MIN_HEIGHT = 150

    def _build_preview(self, parent):
        """A simulated strip, so an effect can be looked at before it is set."""
        outer = ttk.Frame(parent, style="Page.TFrame")

        # The stage keeps its own dark backdrop whatever the desktop is set to
        # - a strip is judged against a dim room, not against the theme - so it
        # is a raised panel rather than part of the page. It expands: the page
        # is shorter than the tallest one and the slack has to go somewhere,
        # and a dim room with a strip in the middle of it is a better use of
        # that room than blank window.
        stage = ttk.Frame(outer, style="Card.TFrame", padding=10)
        stage.pack(fill="both", expand=True, padx=SIDE_MARGIN,
                   pady=(GROUP_GAP, ROW_GAP))
        self.preview_canvas = tk.Canvas(
            stage, height=self.PREVIEW_MIN_HEIGHT, highlightthickness=0,
            background=preview_module.BACKDROP)
        self.preview_canvas.pack(fill="both", expand=True)
        self.preview_canvas.bind("<Configure>", self._preview_layout)

        # Built once per strip length and only moved and recoloured
        # afterwards: creating four items per LED twenty-five times a second is
        # how a canvas gets slow. The coordinates are put in by
        # _preview_layout, which is the only place that knows how much room
        # there is.
        self._preview_items = []
        self._preview_leds(shim.LOGICAL_LEDS)

        # Page.Muted, not Muted: this line stands under the stage rather than
        # on it, so the card's ground behind it was a band of the wrong shade
        # the width of the words.
        self.preview_blurb = ttk.Label(outer, style="Page.Muted.TLabel")
        self.preview_blurb.pack(anchor="center", pady=(0, 8))

        picker = ttk.Frame(outer)
        picker.pack(fill="x", padx=SIDE_MARGIN)
        picker.columnconfigure(0, weight=1)
        picker.columnconfigure(1, weight=1)

        self.preview_choice = tk.StringVar(value="slot:" + render.SHOWS_FIRE)
        self.preview_choice.trace_add("write",
                                      lambda *_a: self._preview_chosen())

        # Not "in the rainbow slot" any more: the slot is where these four go
        # in Game Mode, and on the desktop each of them is a scene of its own.
        # Naming one of the two places would send whoever is looking at the
        # other one hunting for a heading that is not there.
        groups = (("Our effects", "slot"),
                  ("Notification shapes", "shape"))
        for column, (title, wanted) in enumerate(groups):
            box = ttk.Frame(picker)
            box.grid(row=0, column=column, sticky="nsew",
                     padx=(0, GROUP_GAP) if column == 0 else (GROUP_GAP, 0))
            ttk.Label(box, text=title, style="Section.TLabel").pack(
                anchor="w", pady=(0, 4))
            for label, kind, name, _blurb in preview_module.entries():
                if kind != wanted:
                    continue
                ttk.Radiobutton(box, text=label, value=kind + ":" + name,
                                variable=self.preview_choice).pack(anchor="w")

        # page=True: this one stands under the cards, not in one.
        self._note(
            outer,
            "Drawn by the same code that drives the strip, and on the strip "
            "you have: the length, the mapping, the direction and the "
            "brightness ceiling are the ones currently in this window, so "
            "moving any of them changes what you see here. Nothing is applied "
            "and the strip itself is not touched.",
            page=True).pack(anchor="w", padx=SIDE_MARGIN,
                            pady=(GROUP_GAP, GROUP_GAP))

        # This page is shorter than the tallest one, and the slack has to land
        # somewhere. Halved between the stage and here, so the room the strip
        # stands in grows with the window without swallowing the lot - all of
        # it left the strip adrift in the middle of a very large dark box.
        ttk.Frame(outer).pack(fill="both", expand=True)

        self._preview = preview_module.Preview()
        self._preview_job = None
        self._preview_started = None
        # The animation has a frame booked at all times while the page is up.
        # Closing the window would leave that one to fire at a callback that
        # no longer exists, which Tk reports as an invalid command name.
        self.root.bind("<Destroy>", self._stop_timers, add="+")
        self._preview_chosen()
        return outer

    def _stop_timers(self, event=None):
        """Drop what is booked, so nothing fires at a window that has gone.

        All three have something pending most of the time - the preview while
        its page is up, the resize between a fold and the layout pass that
        follows it, and the idle catch-up - and Tk reports a callback that
        outlives its window as an invalid command name.
        """
        if event is not None and event.widget is not self.root:
            return                              # a child of ours, not the window
        for job in (self._preview_job, self._refit_job, self._catching_up,
                    getattr(self, "_cec_first", None)):
            if job is not None:
                self.root.after_cancel(job)
        self._preview_job = self._refit_job = self._catching_up = None
        self._cec_first = None

    def _preview_chosen(self):
        """Restart the clock, so a shape is seen from its beginning."""
        for label, kind, name, blurb in preview_module.entries():
            if kind + ":" + name == self.preview_choice.get():
                self.preview_blurb.configure(text=blurb)
                break
        self._preview_started = time.monotonic()
        self._preview = preview_module.Preview()
        if self._preview_job is None and self._preview_visible():
            self._preview_tick()

    def _preview_leds(self, count):
        """Lay out this many LEDs, rebuilding the canvas if the number changed.

        The strip length is a setting, and the point of this page is now that
        it shows the strip you have - so dragging that slider has to be
        followed, not assumed away.
        """
        if count == len(self._preview_items):
            return
        self.preview_canvas.delete("all")
        self._preview_items = []
        for _index in range(count):
            halo = self.preview_canvas.create_rectangle(0, 0, 1, 1, width=0)
            body = self.preview_canvas.create_rectangle(0, 0, 1, 1, width=0)
            spill = [self.preview_canvas.create_rectangle(0, 0, 1, 1, width=0)
                     for _step in range(2)]
            self._preview_items.append((halo, body, spill))
        self._preview_layout()

    def _preview_layout(self, _event=None):
        """Lay the strip out for the room the canvas actually has.

        Sized from the width - seventeen LEDs across it, whatever it is - and
        centred in the height, so the strip sits in the middle of its dim room
        however tall the page leaves that room.
        """
        width = self.preview_canvas.winfo_width()
        height = self.preview_canvas.winfo_height()
        if width < 80 or height < 40:
            return                              # not laid out yet
        leds = len(self._preview_items)
        gap = max(4, width // 150)
        cell = min(self.PREVIEW_CELL_MAX,
                   (width - 2 * self.PREVIEW_MARGIN - (leds - 1) * gap) // leds)
        cell = max(4, cell)
        bar = min(self.PREVIEW_BAR_MAX, int(cell * 1.4))
        # The glow below the strip is what a real one throws onto the shelf it
        # stands on, so it is a share of the strip rather than a fixed depth.
        spill = max(5, bar // 4)
        span = leds * cell + (leds - 1) * gap
        first = (width - span) // 2
        top = max(6, (height - bar - spill * 2) // 2)

        # The halo grows with the LED rather than with the gap: it is the
        # bloom around a bright thing, so a bigger thing blooms further.
        edge = max(3, cell // 7)
        for index, (halo, body, spill_items) in enumerate(self._preview_items):
            left = first + index * (cell + gap)
            self.preview_canvas.coords(halo, left - edge, top - edge,
                                       left + cell + edge, top + bar + edge)
            self.preview_canvas.coords(body, left, top, left + cell, top + bar)
            for step, item in enumerate(spill_items):
                below = top + bar + 2 + step * spill
                self.preview_canvas.coords(item, left - edge, below,
                                           left + cell + edge, below + spill)

    def _preview_visible(self):
        return (getattr(self, "preview_tab", None) is not None
                and self.notebook.select() == str(self.preview_tab))

    def _preview_tick(self):
        """One frame, then book the next - but only while the tab is up.

        A window on another tab must not be drawing seventeen rectangles
        twenty-five times a second for nobody.
        """
        self._preview_job = None
        if not self._preview_visible():
            return

        self._preview.settings = self._preview_settings()
        elapsed = time.monotonic() - self._preview_started
        kind, _, name = self.preview_choice.get().partition(":")
        if kind == "slot":
            pixels = self._preview.slot_frame(name, elapsed)
        else:
            pixels = self._preview.shape_frame(
                name, ledpanel.SHAPE_TEST_COLOUR, elapsed)

        self._preview_leds(len(pixels))
        for (halo, body, spill), pixel in zip(self._preview_items, pixels):
            self.preview_canvas.itemconfigure(
                body, fill=preview_module.hex_colour(pixel))
            self.preview_canvas.itemconfigure(
                halo, fill=preview_module.toward(pixel, 0.28))
            self.preview_canvas.itemconfigure(
                spill[0], fill=preview_module.toward(pixel, 0.22))
            self.preview_canvas.itemconfigure(
                spill[1], fill=preview_module.toward(pixel, 0.10))

        self._preview_job = self.root.after(1000 // self.PREVIEW_FPS,
                                            self._preview_tick)

    def _preview_settings(self):
        """The window's values as they stand, as far as they can be read.

        Deliberately not _collect(): that validates and puts a dialog up when
        it does not like something, and a preview redrawing twenty-five times
        a second is no place to find that out. Anything unreadable is simply
        left out, and Preview falls back to the shipped default.
        """
        values = {}
        for key, (variable, kind) in self.vars.items():
            try:
                raw = variable.get()
                values[key] = (bool(raw) if kind == "bool"
                               else int(round(raw)) if kind == "int"
                               else float(raw) if kind == "float"
                               else self._value_for(key, raw)
                               if kind in ("sensor", "named", "power", "theme")
                               else str(raw))
            except (ValueError, TypeError, KeyError, tk.TclError):
                continue
        return values

    def _buttons(self, parent, entries, style="Tonal.TButton"):
        """A row of buttons that wraps rather than running off the window.

        Six shape buttons in a row are wider than the window is at its
        smallest, and a row packed left simply loses the last of them - so they
        are gridded and the columns are counted, not packed and hoped for.
        """
        row = ttk.Frame(parent)
        row.pack(fill="x")
        for column in range(self.BUTTONS_ACROSS):
            row.columnconfigure(column, weight=1, uniform="buttons")
        for index, (label, command) in enumerate(entries):
            ttk.Button(row, text=label, style=style, command=command).grid(
                row=index // self.BUTTONS_ACROSS,
                column=index % self.BUTTONS_ACROSS, sticky="ew",
                padx=(0, ROW_GAP), pady=(0, ROW_GAP))
        return row

    def _build_tests(self, parent):
        outer = ttk.Frame(parent)

        flashes = self._section(outer, "Flash the bar", first=True)
        self._note(flashes,
                   "Needs no privileges - the trigger pipe is open to anyone."
                   ).pack(anchor="w", pady=(0, ROW_GAP))
        # No colour in the labels: three of the four are a setting now, so
        # naming one here would be a promise the button cannot keep. It
        # flashes whatever the trigger is set to, which is the point.
        self._buttons(flashes, [
            (label, lambda k=kind: self.runner.start(
                ledpanel.notify_command(k)))
            for kind, label in (("achievement", "Achievement"),
                                ("message", "Friend message"),
                                ("friend", "Friend online"),
                                ("warning", "Warning"))
        ] + [("Pick a colour...", self.flash_colour)])

        # The shapes, all in one colour, so what differs between the buttons
        # is only the thing you are choosing between. Nothing is saved: this
        # asks the service for one flash in that shape, which is what makes it
        # useful for choosing at all.
        shapes = self._section(outer, "Try a flash shape")
        self._note(shapes,
                   "Shown in Steam blue and not saved anywhere - pick one "
                   "here, then set it on the Notifications tab."
                   ).pack(anchor="w", pady=(0, ROW_GAP))
        self._buttons(shapes, [
            (label, lambda s=shape: self.runner.start(
                ledpanel.shape_test_command(s)))
            for label, shape in STYLE_CHOICES])

        strip = self._section(outer, "Strip and Steam")
        self._note(strip,
                   "Steam check and the message probe need a game running."
                   ).pack(anchor="w", pady=(0, ROW_GAP))
        # Whether the GPU half of the load gauge works at all is a driver
        # question, so it is worth being able to ask before wondering why the
        # bar came out symmetric.
        self._buttons(strip, (
            ("Self-test", lambda: self.runner.start(
                ledpanel.self_test_command(SOURCE_DIR))),
            ("Steam check", lambda: self.runner.start(
                ledpanel.steam_check_command())),
            ("Message probe", lambda: self.runner.start(
                ledpanel.probe_messages_command())),
            ("Temperature sensors", lambda: self.runner.start(
                ledpanel.temperature_command())),
            ("Load counters", lambda: self.runner.start(
                ledpanel.load_command()))))
        self._note(strip, "The self-test stops the service briefly."
                   ).pack(anchor="w", pady=(0, GROUP_GAP))
        # Flashing the board, which used to be the third block of Status &
        # repair. It belongs where the rest of "poke the hardware and see" is:
        # the self-test above says whether the board answers, and when it does
        # not this is the next thing you reach for.
        self._build_firmware(outer)
        return outer

    def flash_colour(self):
        chosen = ColourDialog(self.root, self._follow_shade).chosen
        if chosen:
            self.runner.start(ledpanel.notify_command(chosen))

    # -- HDMI CEC ----------------------------------------------------------

    def _build_cec(self, parent):
        """Talking to the television, if the toolkit for it is installed.

        Two pages in one frame, and which of them you see is the machine's
        answer rather than a mode this window is in: an offer to install, or
        the switches. Both are built now and one is packed - see _show_cec -
        because installing is a thing that happens while the window is open,
        and a page that could only tell the truth at construction would need
        the window rebuilt around it to catch up.

        Nothing here queues behind Apply. The toolkit's installer leaves a
        sudoers rule granting exactly the helpers its own switches use, so
        every switch on this page is an ordinary command that runs as you
        click - see server/steamos_led/cec.py. Apply exists on the settings
        pages because writing /etc needs a password and a service restart;
        here the machine does not ask, and inventing the ceremony anyway would
        be this window being formal about nothing.
        """
        outer = ttk.Frame(parent, style="Page.TFrame")
        self._cec = None                    # the last status read, or None
        self._cec_asked = False             # whether we have looked yet
        self._cec_vars = {}
        self._cec_rows = {}
        self._cec_entries = {}
        # Set while the switches are being put back in line with a status
        # read. Without it, writing a variable fires the same handler a click
        # does, and a refresh after a toggle would toggle everything again.
        self._cec_settling = False

        self.cec_missing = self._build_cec_offer(outer)
        self.cec_present = self._build_cec_switches(outer)
        self._show_cec()
        return outer

    def _build_cec_offer(self, parent):
        """What is there before any of it is installed.

        It says what the feature is and what the machine is missing for it,
        rather than only offering the button. Every requirement here is
        somebody else's package, and "install failed" three minutes later is a
        worse way to find out that v4l-utils is not on the machine.
        """
        holder = ttk.Frame(parent, style="Page.TFrame")
        card = ttk.Frame(holder, style="Card.TFrame")
        card.pack(fill="x", padx=SIDE_MARGIN, pady=(ROW_GAP, 0))
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)

        ttk.Label(inner, text="Not installed yet", style="Section.TLabel").pack(anchor="w")
        for text in (
                "Lets this machine talk to the television over the HDMI "
                "cable: wake the screen and switch the input to it, turn it "
                "off when the machine sleeps, and put the television's own "
                "volume on Game Mode's volume buttons.",
                "This installs the SteamOS CEC Toolkit, which is somebody "
                "else's work kept in this repository under vendor/. Nothing "
                "is switched on by installing it - each feature gets a "
                "switch here afterwards."):
            said = ttk.Label(inner, text=text, style="Muted.TLabel", justify="left",
                             wraplength=CARD_WRAP)
            said.pack(anchor="w", pady=(ROW_GAP, 0))
            self._wrapped.append(said)

        # What the machine has not got, asked of the machine. A list written
        # down here would be a list that is wrong on the next SteamOS.
        self.cec_needs = ttk.Label(inner, style="Bad.TLabel", justify="left",
                                   wraplength=CARD_WRAP)
        self._wrapped.append(self.cec_needs)

        row = ttk.Frame(inner, style="OnCard.TFrame")
        row.pack(anchor="w", pady=(GROUP_GAP, 0))
        ttk.Button(row, text="Install HDMI CEC", style="Filled.TButton",
                   command=self._install_cec).pack(side="left")
        ttk.Button(row, text="Check again", style="Text.TButton",
                   command=self._reread_cec).pack(side="left",
                                                  padx=(ROW_GAP, 0))
        return holder

    def _build_cec_switches(self, parent):
        """The page once it is installed: what works, what is on, and a try."""
        holder = ttk.Frame(parent, style="Page.TFrame")

        # The adapter first. Every switch below is worthless without it, and
        # when nothing is happening this is the line that says why.
        card = ttk.Frame(holder, style="Card.TFrame")
        card.pack(fill="x", padx=SIDE_MARGIN, pady=(ROW_GAP, 0))
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="The adapter", style="Section.TLabel").pack(anchor="w")
        self.cec_adapter = ttk.Label(inner, justify="left",
                                     wraplength=CARD_WRAP)
        self.cec_adapter.pack(anchor="w", pady=(ROW_GAP, 0))
        self._wrapped.append(self.cec_adapter)
        row = ttk.Frame(inner, style="OnCard.TFrame")
        row.pack(anchor="w", pady=(GROUP_GAP, 0))
        ttk.Button(row, text="Check again", style="Tonal.TButton",
                   command=self._reread_cec).pack(side="left")
        ttk.Button(row, text="Remove HDMI CEC", style="Text.TButton",
                   command=self._remove_cec).pack(side="left",
                                                  padx=(ROW_GAP, 0))

        self._build_cec_features(holder)
        self._build_cec_actions(holder)
        self._build_cec_config(holder)
        return holder

    def _build_cec_features(self, parent):
        """One switch per feature, each with the sentence that explains it.

        Explained rather than only named, and at more length than the settings
        pages bother with, because these are switches whose effect is on the
        television and on whether the machine goes to sleep. "TV standby
        suspend" is a label somebody can only find out the meaning of by
        turning it on and losing their session.
        """
        card = ttk.Frame(parent, style="Card.TFrame")
        card.pack(fill="x", padx=SIDE_MARGIN, pady=(GROUP_GAP, 0))
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="Features", style="Section.TLabel").pack(anchor="w", pady=(0, ROW_GAP))

        for index, (name, _kind, label, said) in enumerate(cec.FEATURES):
            block = ttk.Frame(inner, style="OnCard.TFrame")
            block.pack(fill="x", pady=(0 if index == 0 else GROUP_GAP, 0))
            block.columnconfigure(1, weight=1)
            variable = tk.BooleanVar(value=False)
            # The name is a label of its own rather than the switch's text.
            # ttk leaves no gap between the switch picture and its own label -
            # measured, the two touched - and that gap is not the switch's to
            # set: every other switch in this window has its name in the
            # column beside it, which is what this matches.
            switch = ttk.Checkbutton(
                block, variable=variable,
                command=lambda n=name: self._cec_toggled(n))
            switch.grid(row=0, column=0, sticky="w")
            named = ttk.Label(block, text=label)
            named.grid(row=0, column=1, sticky="w", padx=(ROW_GAP, 0))
            # Under the name and not beside it: at this length beside it would
            # set the column of switches against a ragged wall of text, and
            # the page would stop reading as a list of switches.
            explain = ttk.Label(block, text=said, style="Muted.TLabel",
                                justify="left",
                                wraplength=CARD_WRAP - CEC_INDENT)
            explain.grid(row=1, column=1, sticky="w", padx=(ROW_GAP, 0),
                         pady=(2, 0))
            self._wrapped.append(explain)
            self._wrap_insets[str(explain)] = CEC_INDENT
            self._cec_vars[name] = variable
            self._cec_rows[name] = (switch, named, explain)

    def _build_cec_actions(self, parent):
        """Four things that happen once and leave nothing behind.

        Which is what makes them the way to find out whether any of this
        reaches the television, before switching on a feature and rebooting
        into it to see.
        """
        card = ttk.Frame(parent, style="Card.TFrame")
        card.pack(fill="x", padx=SIDE_MARGIN, pady=(GROUP_GAP, 0))
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="Try it", style="Section.TLabel").pack(
                      anchor="w", pady=(0, ROW_GAP))
        self._buttons(inner, [
            (label, lambda k=key: self._cec_action(k))
            for key, label, _tail in cec.ACTIONS])

    def _build_cec_config(self, parent):
        """The three settings whose wrong value stops all of it working.

        Three of about forty. The rest are timings and report bytes for
        particular televisions and controllers, and they belong in the file
        with the paragraph of explanation each of them has - copied onto a
        page here they would be forty rows nobody can judge.
        """
        card = ttk.Frame(parent, style="Card.TFrame")
        card.pack(fill="x", padx=SIDE_MARGIN, pady=(GROUP_GAP, GROUP_GAP))
        inner = ttk.Frame(card, style="OnCard.TFrame")
        inner.pack(fill="x", padx=GROUP_GAP, pady=GROUP_GAP)
        ttk.Label(inner, text="Configuration", style="Section.TLabel").pack(anchor="w", pady=(0, ROW_GAP))

        grid = ttk.Frame(inner, style="OnCard.TFrame")
        grid.pack(fill="x")
        grid.columnconfigure(1, weight=1)
        for row, (key, label, said) in enumerate(cec.SHOWN):
            ttk.Label(grid, text=label).grid(
                row=row * 2, column=0, sticky="w",
                padx=(0, GROUP_GAP), pady=(0 if row == 0 else ROW_GAP, 0))
            entry = ttk.Entry(grid, style="Material.TEntry")
            entry.grid(row=row * 2, column=1, sticky="ew",
                       pady=(0 if row == 0 else ROW_GAP, 0))
            self._cec_entries[key] = entry
            explain = ttk.Label(grid, text=said, style="Muted.TLabel", justify="left",
                                wraplength=CARD_WRAP - CEC_INDENT)
            explain.grid(row=row * 2 + 1, column=1, sticky="w", pady=(2, 0))
            self._wrapped.append(explain)
            self._wrap_insets[str(explain)] = CEC_INDENT

        ttk.Button(inner, text="Save these", style="Tonal.TButton",
                   command=self._save_cec_config).pack(anchor="w",
                                                       pady=(GROUP_GAP, 0))
        said = self._note(
            inner,
            "Discovery asks the bus and the sound server what is actually "
            "there and fills these in, which is easier than reading them off "
            "the television.")
        said.pack(anchor="w", pady=(GROUP_GAP, ROW_GAP))
        self._buttons(inner, [
            (label, lambda k=key: self._cec_action(k))
            for key, label, _said in cec.DISCOVERIES])

    # -- what the CEC page does -------------------------------------------

    def _show_cec(self):
        """Pack whichever half the last status read justifies."""
        there = self._cec is not None
        for half, wanted in ((self.cec_present, there),
                             (self.cec_missing, not there)):
            if wanted:
                half.pack(fill="both", expand=True)
            else:
                half.pack_forget()
        if there:
            self._say_cec_adapter()
            self._settle_cec_switches()
        else:
            self._say_cec_needs()
        # The foot of the window reports the same adapter from every page, so
        # it is redrawn by whatever redrew this one.
        self._say_cec_link()

    def _say_cec_needs(self):
        """Name what the machine has not got, or say nothing when it has."""
        absent = cec.missing()
        if not absent:
            self.cec_needs.pack_forget()
            return
        self.cec_needs.configure(text="Missing on this machine: " + "; ".join(
            "%s (%s)" % (name, why) for name, why in absent))
        self.cec_needs.pack(anchor="w", pady=(ROW_GAP, 0))

    def _say_cec_adapter(self):
        """One line about the adapter, in the colour the news deserves.

        Three states rather than two, because "there but not writable" is a
        different problem with a different fix: the toolkit ships a helper and
        a udev rule for exactly that, and it is what a suspend or a SteamOS
        update leaves behind.
        """
        found = cec.device(self._cec)
        where = found.get("device") or "no adapter configured"
        if cec.usable(self._cec):
            said, style = "Ready on %s." % where, "Good.TLabel"
        elif found.get("exists"):
            said = ("%s is there but this user cannot write to it, so nothing "
                    "can be sent. Reinstalling puts the permissions helper "
                    "and its udev rule back." % where)
            style = "Bad.TLabel"
        else:
            said = ("%s is not there. HDMI CEC needs an adapter the kernel "
                    "exposes as a /dev/cec device - the machine's own HDMI or "
                    "DisplayPort output usually is not one." % where)
            style = "Bad.TLabel"
        self.cec_adapter.configure(
            text=said, style=style)

    def _settle_cec_switches(self):
        """Put every switch and box where the machine says it should be.

        Set from the status rather than left where the click put them. A
        toggle can be refused - a helper that is not there, a unit that will
        not start - and a switch that stayed where it was clicked would be
        this window's opinion rather than the machine's.
        """
        self._cec_settling = True
        try:
            for name, variable in self._cec_vars.items():
                variable.set(cec.feature_on(self._cec, name))
        finally:
            self._cec_settling = False
        values = cec.config(self._cec)
        for key, entry in self._cec_entries.items():
            entry.delete(0, "end")
            entry.insert(0, values.get(key, ""))

    def _reread_cec(self, then=None):
        """Ask the toolkit about itself again, and redraw from the answer."""
        try:
            self._cec = ledpanel.cec_status()
        except cec.CecError as exc:
            self._cec = None
            self._write("The CEC toolkit could not be read: %s\n\n" % exc)
        self._cec_asked = True
        self._show_cec()
        if then is not None:
            then()

    def _catch_up_cec(self):
        """Read the status the first time the section is opened, not before.

        Every section's page is built when the window is, so reading here at
        construction would put a subprocess on the path of every window open
        and every theme change - for a page most people never visit.
        """
        if not self._cec_asked:
            self._reread_cec()

    def _cec_toggled(self, name):
        """A switch was clicked. Run it, then believe the machine, not the click."""
        if self._cec_settling:
            return                          # we are the ones who set it
        wanted = bool(self._cec_vars[name].get())
        label = cec.BY_NAME[name][1]
        self._write("%s %s...\n" % ("Turning on" if wanted else "Turning off",
                                    label))
        started = self.runner.start(cec.toggle_command(name, wanted),
                                    lambda _code: self._reread_cec())
        if not started:
            # Refused because something else is running. The switch has
            # already moved under the pointer, and nothing is going to happen
            # to justify it - so put it back rather than leave the page
            # claiming a state nobody applied.
            self._settle_cec_switches()

    def _cec_action(self, key):
        if not self.runner.start(cec.action_command(key),
                                 lambda _code: self._reread_cec()):
            return

    def _save_cec_config(self):
        """Write the three boxes back, through the toolkit's own writer.

        Which writes a *user* config that shadows /etc - so this needs no
        password either, and a value set here survives the toolkit being
        installed over the top.
        """
        values = {key: entry.get().strip()
                  for key, entry in self._cec_entries.items()}
        self.runner.start(cec.set_config_command(values),
                          lambda _code: self._reread_cec())

    def _install_cec(self):
        if not self._ask("HDMI CEC",
                         "This installs the SteamOS CEC Toolkit from vendor/ "
                         "and asks for your password once.\n\nNothing is "
                         "switched on by installing it.",
                         confirm="Install"):
            return
        self.runner.start(ledpanel.install_cec_command(SOURCE_DIR),
                          lambda _code: self._reread_cec())

    def _remove_cec(self):
        if not self._ask("HDMI CEC",
                         "This removes the CEC toolkit and everything it "
                         "installed, and asks for your password once.\n\nThe "
                         "television is left however it is now.",
                         confirm="Remove"):
            return
        self.runner.start(ledpanel.install_cec_command(SOURCE_DIR, remove=True),
                          lambda _code: self._reread_cec())

    # -- status and repair ------------------------------------------------

    def _build_status(self, parent):
        """Two things you might do here: check the installation, or update it.

        The checklist used to be nine lines of "yes" whenever nothing was
        wrong, which is nearly always. It folds away instead, and unfolds
        itself the moment something is not in order.

        Flashing the ESP used to be the third block and is on the Test page
        now. This section is about the installation, which is every part of
        the toolbox; the board on the end of the USB cable is the one thing
        here that was only ever about the strip - and "the self test failed,
        reflash it" is a sentence that should not span two sections.
        """
        outer = ttk.Frame(parent)

        holder = self._section(outer, "This installation", first=True)
        buttons = ttk.Frame(holder)
        buttons.pack(fill="x")
        # The one thing on this tab that changes the machine is filled; the two
        # that only look at it are not. A row of buttons that all shout is a
        # row that says nothing about which one you want.
        self.details = ttk.Button(buttons, text="Details \u25be",
                                  style="Text.TButton",
                                  command=self.toggle_details)
        self.details.pack(side="left", padx=(0, ROW_GAP))
        ttk.Button(buttons, text="Check again", style="Outlined.TButton",
                   command=self.refresh_status).pack(side="left",
                                                     padx=(0, ROW_GAP))
        ttk.Button(buttons, text="Rebuild and reinstall",
                   style="Filled.TButton",
                   command=self.reinstall).pack(side="left")
        self._note(holder, "Keeps your settings, never touches the ESP."
                   ).pack(anchor="w", pady=(ROW_GAP, 0))

        # Packed straight into the page, not into a slot of its own. Measured:
        # Tk does not reset a frame's requested size when its *last* child is
        # unpacked, so a list living alone in a slot left that slot - and the
        # window - at the height it had needed. Among siblings it shrinks
        # properly, and "before" is what keeps its place in the order.
        self.checklist = ttk.Frame(outer)
        self._details_open = False

        self.update_box = self._build_update(outer)
        return outer

    def toggle_details(self):
        self._show_details(not self._details_open)

    def _show_details(self, show):
        self._details_open = show
        # The height and the content change in one go, and in the order that
        # never asks for more room than the window has: grow first, then fill
        # it; empty it first, then shrink. Measured the other way round, a
        # fold drew three states, one of them with the output pane hanging off
        # the bottom edge - which is the jerk this is here to avoid.
        width = self.root.winfo_width()
        height = self.root.winfo_height() + self._details_change(show)
        if show:
            self.root.geometry("%dx%d" % (width, height))
            self.checklist.pack(fill="x", padx=SIDE_MARGIN,
                                pady=(0, DETAILS_GAP),
                                before=self.update_box)
        else:
            self.checklist.pack_forget()
            # Let the page settle into its shorter self before the window
            # follows: without this the two reflows overlap and one of them
            # is drawn with the checklist below the bottom edge.
            self.root.update_idletasks()
            self.root.geometry("%dx%d" % (width, height))
        self.details.configure(text="Details \u25b4" if show
                               else "Details \u25be")
        # Arithmetic gets it right to the pixel or it does not; this settles
        # the difference afterwards, and shows nothing when there is none.
        self._fit_window()

    def _details_change(self, show):
        """How much taller or shorter the window has to be for the checklist.

        Worked out rather than tried: asking Tk means packing the list, doing
        a layout pass and reading the answer, and that pass is drawn - which
        is the squeezed intermediate this is here to avoid. A notebook asks
        for the tallest of its panes plus its own trim, so what the window
        gains is what this pane would gain, less the slack the tallest pane
        already provides. If the arithmetic is ever off, _fit_window puts it
        right afterwards; it is only the smoothness that depends on this.
        """
        # Against the notebook the checklist actually lives in, which is the
        # outer one now: asked of the strip's pages the answer would be the
        # slack in a stack this page is not in, and the window would jump by
        # whatever that happened to be.
        book = self.sections
        gain = self.checklist.winfo_reqheight() + DETAILS_GAP
        tabs = [self.root.nametowidget(name) for name in book.tabs()]
        heights = [tab.winfo_reqheight() for tab in tabs]
        others = max(height for tab, height in zip(tabs, heights)
                     if tab is not self.status_tab)
        wanted = self.status_tab.winfo_reqheight() + (gain if show else -gain)
        trim = book.winfo_reqheight() - max(heights)
        return max(others, wanted) + trim - book.winfo_reqheight()

    def _fit_window(self):
        """Give the window the height its content needs, and no more.

        after_idle, because the new height is only known once the layout has
        been redone. One booking at a time: a fold that asks twice in the same
        pass has no more to say the second time.
        """
        if self._refit_job is None:
            self._refit_job = self.root.after_idle(self._refit)

    def _refit(self):
        """Set the height outright; asking nicely does not work.

        Tk grows a toplevel to fit its content, but once the window manager
        has sized the window that size stays. Clearing the geometry is
        documented to cancel a *user-specified* size, and measured here it
        changed nothing, because this one came from the window manager. The
        width is left alone: that one is genuinely the user's.
        """
        # Cleared as it runs: what was booked has now fired, and cancelling it
        # afterwards would be cancelling somebody else's booking.
        self._refit_job = None
        try:
            self.root.update_idletasks()
            width = self.root.winfo_width()
            if width <= 1:                      # not on screen yet
                width = self.root.winfo_reqwidth()
            # Never taller than the screen. A window that opens past the bottom
            # edge cannot be resized back on some window managers, and the page
            # inside it scrolls now, so there is nothing to lose by capping.
            room = self.root.winfo_screenheight() - SCREEN_ALLOWANCE
            height = min(self.root.winfo_reqheight(), room)
            self.root.geometry("%dx%d" % (width, height))
        except tk.TclError:                                 # pragma: no cover
            pass

    def _build_firmware(self, parent):
        """The last thing that still needed a terminal after installing."""
        frame = self._section(parent, "ESP firmware")

        row = ttk.Frame(frame)
        row.pack(fill="x")
        self.firmware = tk.StringVar()
        # Grows with the window: at a fixed width the longest build name was
        # cut off mid-word, and which pin it drives is the whole point.
        self._field(row, "firmware", self.firmware, ledpanel.FIRMWARE_ENVS,
                    ledpanel.FIRMWARE_ENVS[0][1]).pack(
                        side="left", fill="x", expand=True,
                        padx=(0, GROUP_GAP))
        ttk.Button(row, text="Flash firmware", style="Tonal.TButton",
                   command=self.flash_firmware).pack(side="left")
        self._note(frame,
                   "Takes a minute; the strip is dark and the service stops "
                   "while it runs.").pack(anchor="w", pady=(ROW_GAP, 0))

    def flash_firmware(self):
        environment = self._value_for("firmware", self.firmware.get())
        if not self._ask(
                "Flash firmware",
                "This writes the '%s' firmware to the ESP over USB.\n\n"
                "The bar goes dark and the service stops until it is done. "
                "If the flash fails, the board keeps the firmware it has."
                % environment, confirm="Flash"):
            return
        self.runner.start(
            ledpanel.flash_firmware_command(SOURCE_DIR, environment),
            lambda _code: self.refresh_status())

    def _build_update(self, parent):
        """Fetch a branch and install it: the two halves of "get the new one"."""
        frame = self._section(parent, "Update")

        if not ledpanel.is_git_clone(SOURCE_DIR):
            self._note(
                frame,
                "%s is not a git clone, so there is nothing to update from - "
                "this is what downloading a zip leaves you with. Clone it "
                "with git to get updates here." % SOURCE_DIR,
            ).pack(anchor="w")
            return frame

        row = ttk.Frame(frame)
        row.pack(fill="x")
        ttk.Label(row, text="Branch").pack(side="left", padx=(0, ROW_GAP))
        self.branch = tk.StringVar()
        # Built with the branch that is checked out and nothing else, then
        # filled: _refresh_branches is the one place that knows how the list
        # is made, and it runs again after every fetch.
        self._field(row, "branch", self.branch, [],
                    ledpanel.current_branch(SOURCE_DIR),
                    width=BRANCH_WIDTH).pack(side="left", padx=(0, GROUP_GAP))
        self._refresh_branches()
        ttk.Button(row, text="Check for updates", style="Outlined.TButton",
                   command=self.check_for_updates).pack(side="left",
                                                        padx=(0, ROW_GAP))
        self.update_button = ttk.Button(row, text="Update and install",
                                        style="Filled.TButton",
                                        command=self.update_now)
        self.update_button.pack(side="left")
        # What the last check found, where it can be read without unfolding
        # the log - which is folded nearly always now, and was the only place
        # the answer ever appeared.
        self.update_state = ttk.Label(frame)
        self.update_state.pack(anchor="w", pady=(ROW_GAP, 0))
        self._note(frame,
                   "Fetches into the clone and installs it. Local changes or "
                   "commits of your own stop it, with a message.").pack(
                       anchor="w", pady=(ROW_GAP, 0))
        self._say_update(ledpanel.UPDATE_UNKNOWN, "")
        # A different branch is a different question, and the old answer is
        # not one about it.
        self.branch.trace_add("write", lambda *_a: self._say_update(
            ledpanel.UPDATE_UNKNOWN, ""))
        return frame

    def _say_update(self, state, sentence):
        """Show what the last check found, and gate the install button on it."""
        self._update_state = state
        self.update_state.configure(
            text=sentence,
            style="Good.TLabel" if state == ledpanel.UPDATE_CURRENT
            else "Section.TLabel" if state == ledpanel.UPDATE_AVAILABLE
            else "Muted.TLabel")
        self._refresh_update()

    def _refresh_update(self):
        """Nothing to install is a button that says so by not being pressable.

        Only after a check has actually said there is nothing: never having
        asked is not the same answer, and a button dead before anyone has
        looked would be the window refusing to do something it can do.
        """
        if getattr(self, "update_button", None) is None:
            return                              # not a clone; there is no row
        self.update_button.state(
            ["disabled"] if self._update_state == ledpanel.UPDATE_CURRENT
            else ["!disabled"])

    def _refresh_branches(self):
        """Fill the list from what the clone knows, keeping the selection."""
        branches = ledpanel.known_branches(SOURCE_DIR)
        current = self.branch.get()
        # A branch the clone does not list - the detached head a fetch can
        # leave, say - stays on rather than vanishing from under the
        # selection.
        if current and current not in branches:
            branches = sorted(branches + [current])
        self._menus["branch"] = [(name, name) for name in branches]

    def check_for_updates(self):
        def checked(code):
            self._refresh_branches()
            self._say_update(*ledpanel.update_verdict(
                "".join(self.runner.transcript), code))

        self.runner.start(
            ledpanel.update_command(SOURCE_DIR, self.branch.get(), check=True),
            checked)

    def update_now(self):
        wanted = self.branch.get()
        if wanted != ledpanel.current_branch(SOURCE_DIR) and not self._ask(
                "Switch branch",
                "This will switch from %s to %s and install that instead."
                % (ledpanel.current_branch(SOURCE_DIR) or "?", wanted),
                confirm="Switch"):
            return

        before = ledpanel.head_commit(SOURCE_DIR)

        def updated(code):
            self._refresh_branches()
            if code != 0:
                return                      # the script said why
            self._say_update(*ledpanel.update_verdict(
                "".join(self.runner.transcript), code))
            if ledpanel.head_commit(SOURCE_DIR) == before:
                self._write("Nothing new, so nothing to install.\n\n")
                return
            # Only force a module rebuild when its source actually moved: the
            # installer skips a module that is loaded and working, which is
            # right after a repair and wrong after an update that changed it.
            self.runner.start(
                ledpanel.reinstall_command(
                    SOURCE_DIR,
                    rebuild_module=ledpanel.module_changed(SOURCE_DIR, before)),
                self._installed)

        self.runner.start(ledpanel.update_command(SOURCE_DIR, wanted), updated)

    def _installed(self, code):
        self.refresh_status()
        if code != 0:
            self._write("The install did not finish, so the panel is still "
                        "running the old files.\n\n")
            return
        if self._ask(
                "Update",
                "Installed.\n\nThe panel itself is still running the files it "
                "started with.", confirm="Restart the panel", deny="Later"):
            self._restart()
        else:
            self._write("Restart the panel when it suits you; until then it "
                        "is the old one you are looking at.\n\n")

    def _restart(self):
        """Replace this process with a fresh copy of the panel.

        execv rather than starting a second one and quitting: same process,
        same place in the task bar, and never two panels open at once. It does
        not return, so everything after it is the failure case.
        """
        self._write("Restarting the panel...\n")
        self.root.update_idletasks()
        try:
            self.root.destroy()
        except tk.TclError:                                 # pragma: no cover
            pass
        try:
            os.execv(sys.executable,
                     [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])
        except OSError as exc:                              # pragma: no cover
            sys.exit("The panel could not restart itself (%s).\n"
                     "Start it again from the application menu." % exc)

    def refresh_status(self):
        for child in self.checklist.winfo_children():
            child.destroy()
        checks = ledpanel.run_checks(config=self.config)
        broken = ledpanel.broken(checks)
        # One place says how it is, under the title, where every tab can see
        # it - the same sentence at the top of this tab as well was saying it
        # twice to someone already looking at it.
        self.headline.configure(
            text=ledpanel.repair_summary(checks),
            style="Page.Bad.TLabel" if broken else "Page.Good.TLabel")
        # And the foot of the window, which asks the narrower question - see
        # ledpanel.bar_is_live.
        self._say_link(ledpanel.bar_is_live(checks))
        if broken:
            self._show_details(True)
        for row, check in enumerate(checks):
            ttk.Label(self.checklist, text="\u2713" if check.ok else "\u2717",
                      width=3, style="Good.TLabel" if check.ok
                      else "Bad.TLabel").grid(row=row, column=0, sticky="nw",
                                              pady=2)
            ttk.Label(self.checklist, text=check.name,
                      style="TLabel" if check.ok else "Bad.TLabel").grid(
                          row=row, column=1, sticky="w", pady=2,
                          padx=(0, GROUP_GAP))
            if not check.ok:
                ttk.Label(self.checklist, text=check.detail, wraplength=460,
                          justify="left", style="Muted.TLabel").grid(
                              row=row, column=2, sticky="w", pady=2)

    def reinstall(self):
        if not os.path.exists(os.path.join(SOURCE_DIR, "install.sh")):
            self._say("Repair",
                      "install.sh is not next to this panel (%s).\nRepairing "
                      "needs the cloned repository." % SOURCE_DIR)
            return
        if not self._ask(
                "Repair", "Your configuration is kept and the ESP is not "
                          "touched. This asks for your password.",
                confirm="Re-run the installer"):
            return
        self.runner.start(ledpanel.reinstall_command(SOURCE_DIR),
                          lambda _code: self.refresh_status())


def main():
    # Without a class of its own the window says WM_CLASS "Tk", which matches
    # no menu entry, so the task bar falls back to reading "python3". It has
    # to be passed at creation, and must stay equal to StartupWMClass in the
    # .desktop file - that is how the desktop ties the window to its icon.
    root = tk.Tk(className=WM_CLASS)
    try:
        ttk.Style().theme_use("clam")
    except tk.TclError:                                     # pragma: no cover
        pass
    Panel(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
