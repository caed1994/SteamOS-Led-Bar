#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${STEAMOS_CEC_CONFIG:-/etc/steamos-cec-toolkit.conf}"
if [[ -r "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

if [[ "${1:-}" == "post" ]]; then
  exit 0
fi

STEAMOS_CEC_USER="${STEAMOS_CEC_USER:-deck}"
STEAMOS_CEC_UID="$(id -u "$STEAMOS_CEC_USER")"
USER_CONFIG="/home/$STEAMOS_CEC_USER/.config/steamos-cec-toolkit/config.conf"
if [[ -r "$USER_CONFIG" ]]; then
  # shellcheck disable=SC1090
  source "$USER_CONFIG"
fi

CEC_DEVICE="${CEC_DEVICE:-/dev/cec0}"
TV_LOGICAL_ADDRESS="${TV_LOGICAL_ADDRESS:-0}"
CEC_PLAYBACK_LOGICAL_ADDRESS="${CEC_PLAYBACK_LOGICAL_ADDRESS:-4}"
CEC_PHYSICAL_ADDRESS="${CEC_PHYSICAL_ADDRESS:-}"
CEC_SLEEP_TV_ACTION="${CEC_SLEEP_TV_ACTION:-standby}"
# The wait after the last message, before the machine suspends or stops.
#
# cec-ctl returns when the adapter sent the message, so this is the time that
# the television needs to act on it before the HDMI link goes away. A CEC
# message is acknowledged in some milliseconds, and the default of 2 seconds
# was on each suspend and each shutdown. Raise it in the configuration file
# for a set that needs longer.
TV_STANDBY_SETTLE_SECONDS="${TV_STANDBY_SETTLE_SECONDS:-0.5}"
# How long to wait for the television to say whether it is off.
#
# A set that answers does it in some tens of milliseconds; one measured
# television took 23. The limit is for the set that never answers: cec-ctl
# waits about a second for a reply that is not coming, and this is on each
# suspend and each shutdown. See television_is_off.
#
# 0 turns the question off. A television that never answers costs that half
# second on each suspend and gains nothing, and this is the way to say so.
POWER_STATUS_TIMEOUT="${POWER_STATUS_TIMEOUT:-0.5}"
INPUT_INACTIVE_SUSPEND_MARKER="/run/user/$STEAMOS_CEC_UID/steamos-cec-input-inactive-suspend"

case "$CEC_SLEEP_TV_ACTION" in
  standby|inactive-source) ;;
  *)
    echo "steamos-cec: unknown CEC_SLEEP_TV_ACTION '$CEC_SLEEP_TV_ACTION'; using standby"
    CEC_SLEEP_TV_ACTION=standby
    ;;
esac

touch /run/steamos-cec-local-suspend

run_as_user_bus() {
  runuser -u "$STEAMOS_CEC_USER" -- env \
    XDG_RUNTIME_DIR="/run/user/$STEAMOS_CEC_UID" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$STEAMOS_CEC_UID/bus" \
    "$@"
}

# busctl waits 25 seconds for a method call by default, and the two calls below
# go to the cecd of Steam. A daemon that is not there fails at once. A daemon
# that stopped answering held the suspend for 50 seconds, and the calls are an
# attempt and not a requirement: the cec-ctl messages below do the same work.
#
# Half a second, and not the two it was. A daemon that is there answers in
# milliseconds, so this costs a working machine nothing. A daemon that does
# not answer is a daemon this script does not need, and every tenth of a
# second here is on each suspend and each shutdown.
BUSCTL_TIMEOUT=0.5

current_playback_logical_address() {
  local logical
  logical="$(
    /usr/bin/cec-ctl -d "$CEC_DEVICE" -S 2>/dev/null |
      awk '/^[[:space:]]+Logical Address[[:space:]]+:/ {print $4; exit}'
  )"
  if [[ "$logical" =~ ^[0-9]+$ && "$logical" -ge 0 && "$logical" -le 14 ]]; then
    printf '%s\n' "$logical"
  elif [[ "$CEC_PLAYBACK_LOGICAL_ADDRESS" =~ ^[0-9]+$ && "$CEC_PLAYBACK_LOGICAL_ADDRESS" -ge 0 && "$CEC_PLAYBACK_LOGICAL_ADDRESS" -le 14 ]]; then
    printf '%s\n' "$CEC_PLAYBACK_LOGICAL_ADDRESS"
  else
    printf '4\n'
  fi
}

send_native_standby() {
  /usr/bin/cec-ctl -d "$CEC_DEVICE" -s --to "$1" --standby || true
}

send_raw_standby() {
  local source="$1"
  local target="$2"
  /usr/bin/cec-ctl -d "$CEC_DEVICE" -s --raw-msg \
    -f "$source" -t "$target" \
    --custom-command cmd=0x36 || true
}

physical_address_payload() {
  local physical="${CEC_PHYSICAL_ADDRESS:-}"
  local a b c d
  IFS=. read -r a b c d <<< "$physical"
  if [[ ! "$a" =~ ^[0-9a-fA-F]$ || ! "$b" =~ ^[0-9a-fA-F]$ || ! "$c" =~ ^[0-9a-fA-F]$ || ! "$d" =~ ^[0-9a-fA-F]$ ]]; then
    return 1
  fi
  printf '0x%02x:0x%02x\n' "$((16#$a * 16 + 16#$b))" "$((16#$c * 16 + 16#$d))"
}

# What the television says about its own power, as an exit code:
#
#     0  off          1  still on        2  it said nothing
#     3  on its way off
#
# This is the question the ladder below exists to answer, and the ladder had
# no way to ask it. It sends standby six times over about three seconds
# because different sets listen to different ones of the six, and it sends
# all six whatever the set does, on each suspend and each shutdown.
#
# The hex code and not the words: cec-ctl prints "pwr-state: standby (0x01)"
# and "in transition on to standby (0x03)", and a code does not change with
# the wording of a release.
#
# The third answer is the one that matters for a set that does not do this.
# Such a set gets asked one time and then the full ladder, so it is one
# timeout slower and no more. A set that answers "on" is asked again after
# each step, which costs milliseconds.
television_is_off() {
  local said
  [[ "$POWER_STATUS_TIMEOUT" != "0" ]] || return 2
  said="$(timeout "$POWER_STATUS_TIMEOUT" /usr/bin/cec-ctl -d "$CEC_DEVICE" -s \
            --to "$TV_LOGICAL_ADDRESS" --give-device-power-status 2>/dev/null)" \
    || return 2
  [[ "$said" == *"pwr-state:"* ]] || return 2
  [[ "$said" != *"(0x01)"* ]] || return 0
  [[ "$said" != *"(0x03)"* ]] || return 3
  return 1
}

send_inactive_source() {
  local source="$1"
  local payload

  if [[ -z "$CEC_PHYSICAL_ADDRESS" ]]; then
    echo "steamos-cec: CEC_PHYSICAL_ADDRESS is not configured; skipping inactive source"
    return 0
  fi

  /usr/bin/cec-ctl -d "$CEC_DEVICE" -s --to "$TV_LOGICAL_ADDRESS" \
    --inactive-source phys-addr="$CEC_PHYSICAL_ADDRESS" || true

  if payload="$(physical_address_payload)"; then
    sleep 0.5
    /usr/bin/cec-ctl -d "$CEC_DEVICE" -s --raw-msg \
      -f "$source" -t "$TV_LOGICAL_ADDRESS" \
      --custom-command "cmd=0x9d,payload=$payload" || true
  fi
}

input_inactive_suspend_in_progress() {
  [[ -e "$INPUT_INACTIVE_SUSPEND_MARKER" ]] || return 1

  local marker_mtime now age
  marker_mtime="$(stat -c %Y "$INPUT_INACTIVE_SUSPEND_MARKER" 2>/dev/null || printf 0)"
  now="$(date +%s)"
  age=$((now - marker_mtime))
  [[ "$age" -ge 0 && "$age" -lt 180 ]]
}

if input_inactive_suspend_in_progress; then
  echo "steamos-cec: input-inactive suspend detected; skipping TV/AVR standby"
  rm -f "$INPUT_INACTIVE_SUSPEND_MARKER"
  exit 0
fi

echo "steamos-cec: running sleep/shutdown CEC action '$CEC_SLEEP_TV_ACTION'"

# The session bus of that user, which the two calls below need. On a shutdown
# the session is often gone already, and then each call is a runuser and a
# busctl that start, find nothing and stop. That is a tenth of a second for an
# answer this file can read from one path.
session_bus_is_there() {
  [[ -S "/run/user/$STEAMOS_CEC_UID/bus" ]]
}

if [[ "$CEC_SLEEP_TV_ACTION" == "standby" ]] && session_bus_is_there; then
  run_as_user_bus busctl --user --timeout="$BUSCTL_TIMEOUT" call \
    com.steampowered.CecDaemon1 \
    /com/steampowered/CecDaemon1/Daemon \
    com.steampowered.CecDaemon1.Daemon1 \
    Standby b true \
    || true

  run_as_user_bus busctl --user --timeout="$BUSCTL_TIMEOUT" call \
    com.steampowered.CecDaemon1 \
    /com/steampowered/CecDaemon1/Devices/Cec0 \
    com.steampowered.CecDaemon1.CecDevice1 \
    Standby y "$TV_LOGICAL_ADDRESS" \
    || true
fi

if [[ -e "$CEC_DEVICE" ]]; then
  playback_logical_address="$(current_playback_logical_address)"
  echo "steamos-cec: CEC sleep action '$CEC_SLEEP_TV_ACTION' from logical address $playback_logical_address"

  if [[ "$CEC_SLEEP_TV_ACTION" == "inactive-source" ]]; then
    send_inactive_source "$playback_logical_address"
    sleep "$TV_STANDBY_SETTLE_SECONDS"
    exit 0
  fi

  # The set and then the bus. The broadcast is what an AV receiver listens
  # to, so it goes out before anything below can decide that the work is
  # done: a television that is off is not a receiver that is off.
  send_native_standby "$TV_LOGICAL_ADDRESS"
  sleep 0.25
  send_native_standby 15

  # Ask the set, and send no more once it says it is off. `asking` goes to 0
  # for a set that says nothing, so such a set is asked one time and no more.
  #
  # `|| said=$?` and not a bare call: this file runs under `set -e`, where a
  # command that returns non-zero on a line of its own ends the script. A
  # television that answers "on" would then stop the suspend.
  asking=1
  answer=1
  said=0
  television_is_off || said=$?
  [[ "$said" != "2" ]] || asking=0
  answer="$said"

  if [[ "$answer" != "0" ]]; then
    for delay in 0.5 1.0; do
      sleep "$delay"
      send_raw_standby "$playback_logical_address" "$TV_LOGICAL_ADDRESS"
      sleep 0.25
      send_raw_standby "$playback_logical_address" 15
      [[ "$asking" == "1" ]] || continue
      said=0
      television_is_off || said=$?
      [[ "$said" != "2" ]] || { asking=0; continue; }
      answer="$said"
      [[ "$answer" != "0" ]] || break
    done
  fi

  # The settle time is for a set with no way to say that it is ready. One
  # that reports standby has said so, and a wait after that is a wait for
  # nothing. A set on its way there is not there, and keeps the wait.
  if [[ "$answer" == "0" ]]; then
    echo "steamos-cec: the television reports standby"
    exit 0
  fi
fi

sleep "$TV_STANDBY_SETTLE_SECONDS"
