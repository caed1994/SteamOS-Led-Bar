#!/usr/bin/env python3
"""Puts the CEC adapter on the bus, before anything here sends CEC.

This is the step that the rest of this toolkit assumed was already complete.

Each path that sends a CEC message asks the adapter for its logical address.
The three paths are the boot wake, the Steam button and the resume wake.

When the answer is none, each path sends from an address that the adapter does
not own. A television has no reason to act on such a message. On a machine
where nothing registered the adapter, all of this thus does nothing and reports
nothing.

The known repair is to disconnect the adapter and connect it again. At the
second connection the device appears while each program that uses it already
runs.

This program runs one time at the session start, before the other units, and
again at the end of an installation.

It is deliberately careful. It does not touch an adapter that already holds an
address. If Steam's own cecd holds it, that is the correct result and nothing
here must interfere. It also does not touch an adapter whose cec-ctl report
this program cannot read.

To do nothing is always a safe answer. To take the bus from cecd is not.
"""

from __future__ import annotations

import argparse
import glob
import json
import logging
import os
import subprocess
import time
from pathlib import Path

CEC_CTL = "cec-ctl"

# Each adapter on the machine, and not the configured adapter. To register an
# adapter that nobody holds cannot disturb anything. On a machine with two
# adapters, the configured one is the more probable mistake.
ADAPTERS = "/dev/cec*"

# The name of the source that the television shows. To register as a playback
# device claims logical address 4, and each wake path here expects that
# address.
REGISTERED_NAME = "SteamOS"

# What an adapter reports when it has no picture: no link, or a link whose EDID
# the adapter did not read. To claim an address then puts this machine on the
# bus at an address with no meaning.
NO_PHYSICAL_ADDRESS = "f.f.f.f"

PERMISSIONS_HELPER = "/var/lib/steamos-cec-toolkit/steamos-cec-permissions-apply"

# Steam's own CEC daemon. It is a user service, because it belongs to the
# session that has the television.
DAEMON_UNIT = "cecd.service"

# The program beside this one that owns the configuration file. It is in
# ~/.local/bin after an installation, and in bin/ in a checkout.
TOOLKITCTL = Path(__file__).resolve().parent / "steamos-cec-toolkitctl"

DEFAULT_CONFIG = "/etc/steamos-cec-toolkit.conf"

# The time to wait for a picture before this program stops.
#
# It is deliberately short. This program holds the wake service behind it, and
# a machine with no picture usually has a television that is *off*. That is the
# condition that the wake repairs. To wait there delays the repair and then
# stops anyway.
#
# It is the full budget and not one of three. The arrival of the adapter, the
# second attempt of the daemon, and the picture all come out of it.
#
# It is fifteen seconds and not ten because of the second item. On the machine
# of the measurement, the device arrived at twelve seconds. To restart a daemon
# and read the answer needs two seconds more.
DEFAULT_WAIT_SECONDS = 15.0
POLL_SECONDS = 1.0

PHYSICAL_ADDRESS = "CEC_PHYSICAL_ADDRESS"

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
LOG = logging.getLogger("steamos-cec-register")


def read_config(path: str) -> dict[str, str]:
    config: dict[str, str] = {}
    try:
        with open(path, encoding="utf-8") as file:
            for raw_line in file:
                line = raw_line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return config


SYSTEM_CONFIG = read_config(os.environ.get("STEAMOS_CEC_CONFIG", DEFAULT_CONFIG))
STEAMOS_CEC_USER = SYSTEM_CONFIG.get("STEAMOS_CEC_USER", "deck")
USER_CONFIG_FILE = f"/home/{STEAMOS_CEC_USER}/.config/steamos-cec-toolkit/config.conf"
CONFIG = {**SYSTEM_CONFIG, **read_config(USER_CONFIG_FILE)}
CEC_DEVICE = CONFIG.get("CEC_DEVICE", "/dev/cec0")


def run(command: list[str], timeout: int = 15) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return subprocess.CompletedProcess(command, 1, str(error), "")


def field(text: str, name: str) -> str:
    """Returns one "Name : value" line of the cec-ctl report, or ""."""
    for line in (text or "").splitlines():
        left, separator, right = line.partition(":")
        if separator and left.strip().lower() == name.lower():
            return right.strip()
    return ""


def registered(text: str) -> bool | None:
    """Returns whether this adapter holds a logical address, or None.

    Two fields give the answer and either one is sufficient. The mask is the
    correct field. The count is there for a cec-ctl with different words.

    It returns None and not False when neither field is present. "The answer
    was not in a form that this program reads" and "the adapter is not on the
    bus" need opposite actions. The first is a reason to change nothing.
    """
    for name in ("Logical Address Mask", "Logical Addresses"):
        found = field(text, name)
        if found:
            try:
                return int(found, 0) != 0
            except ValueError:
                continue
    return None


def physical_address(text: str) -> str:
    """Returns the position of this adapter on the television, or ""."""
    found = field(text, "Physical Address")
    if not found or found.lower() == NO_PHYSICAL_ADDRESS:
        return ""
    return found


def writable(path: str) -> bool:
    """Returns whether this user can open the device for a conversation."""
    return os.access(path, os.R_OK | os.W_OK)


def wait_for_adapters(deadline, now, sleep) -> list[str]:
    """Returns the device nodes. It waits for them and does not look once.

    A session start and the enumeration of the adapter occur together. To lose
    that race with no message is how a machine gets an adapter that nothing
    registers.

    To wait here is correct. An adapter that is on the way will arrive. A
    picture will not: it needs a person to switch the television on.
    """
    while True:
        found = sorted(glob.glob(ADAPTERS))
        if found or now() >= deadline:
            return found
        sleep(POLL_SECONDS)


def tell_the_toolkit_where_it_is(device: str, address: str, run) -> bool:
    """Writes the physical address into the configuration, if it has none.

    The address is what lets the wake paths broadcast <Active Source>. That is
    the message that changes the input of the television. Each path skips the
    message when the setting is empty. Each path writes that to the log and
    continues.

    The setting is empty in a new installation. Only `discover-cec` writes it,
    and the installer did not run that command.

    This function already has the address. It read the address to decide
    whether the adapter needed a registration. It thus uses set-config, which
    needs no root and writes the user file that has priority over /etc. That
    is the same file that the Discover button writes.

    It writes only for the configured adapter, and only when that setting is
    empty. A machine with two adapters must not receive the address of the
    other adapter. A value that a person selected is that person's value.
    """
    if device != CEC_DEVICE:
        return False
    if CONFIG.get(PHYSICAL_ADDRESS, "").strip():
        return False
    if not os.access(TOOLKITCTL, os.X_OK):
        return False
    answer = run([str(TOOLKITCTL), "set-config",
                  json.dumps({PHYSICAL_ADDRESS: address})])
    if answer.returncode != 0:
        LOG.warning("Could not record that this machine is at %s: %s",
                    address, (answer.stdout or "").strip())
        return False
    LOG.info("Recorded that this machine is at %s, so waking can switch the "
             "input over as well.", address)
    return True


def nudge_the_daemon(device: str, restarted: set[str], run, writable) -> bool:
    """Repairs the adapter permissions and gives cecd a second attempt.

    This is what a disconnection and a connection do, with no walk to the
    television. This log shows the reason:

      [10.0] Starting Repair SteamOS CEC device permissions...
      [10.1] Finished Repair SteamOS CEC device permissions.
      [12.4] kernel: Registered IR keymap rc-cec        <- the device, at last
      [12.5] cecd: Could not add device /dev/cec0: EACCES: Permission denied

    The permissions unit is ordered after udev and runs one time. On a machine
    where the adapter needs twelve seconds, it thus repaired nothing.

    The udev rule must also repair the permissions. It runs when the device
    appears, and cecd waits for that same moment. cecd opens the device before
    the rule's program finishes, receives a refusal, and makes no second
    attempt. It reads the device one time, and a refusal stays until something
    restarts it.

    This function runs only when nothing holds a logical address, so it
    interrupts nothing. A daemon that has the adapter keeps it: an earlier
    branch returns.

    Both steps are attempts and neither must succeed. The claim of the address
    by this program is still after them.

    The permissions are for one adapter and the daemon is not. `restarted` is
    how a machine with two adapters restarts one service one time and not two
    times.
    """
    did = False
    if not writable(device):
        answer = run(["sudo", "-n", PERMISSIONS_HELPER])
        if answer.returncode == 0:
            LOG.info("%s: could not be written; repaired its permissions.",
                     device)
            did = True
        else:
            LOG.warning("%s: cannot be written and repairing it failed: %s",
                        device, (answer.stdout or "").strip())
    if restarted:
        return did
    restarted.add(DAEMON_UNIT)
    answer = run(["systemctl", "--user", "restart", DAEMON_UNIT])
    if answer.returncode == 0:
        LOG.info("Nothing held a CEC address, so cecd was given another go "
                 "at it.")
        did = True
    return did


def register(wait: float, devices=None, run=run, sleep=time.sleep,
             now=time.monotonic, writable=writable) -> int:
    """Claims a logical address for each CEC adapter that has none.

    `wait` is the full budget. The arrival of the adapter and the arrival of
    its picture share it. Nothing after this unit thus waits longer than that,
    whatever occurs at the session start.

    Each value that this function takes from outside is a keyword argument
    with a real default. The machine that this was written on has no CEC
    adapter, no television and no cec-ctl. The purpose of this function is
    also what it does *not* do on a machine where another program holds the
    bus, and a test must be able to prove that.
    """
    deadline = now() + wait
    if devices is None:
        devices = wait_for_adapters(deadline, now, sleep)
    if not devices:
        LOG.warning(
            "No CEC adapter appeared in %s within %gs, so there is nothing "
            "to register. If it is only slow, try a longer wait by hand: "
            "steamos-cec-register --wait 60", ADAPTERS, wait)
        return 0

    waiting = list(devices)
    nudged: set[str] = set()
    restarted: set[str] = set()
    told = False
    done = 0
    while waiting:
        for device in list(waiting):
            answer = run([CEC_CTL, "-d", device])
            text = answer.stdout or ""
            if answer.returncode != 0:
                LOG.warning("%s: cec-ctl would not report on it: %s",
                            device, text.strip())
                waiting.remove(device)
                continue
            state = registered(text)
            if state is None:
                LOG.warning("%s: cannot tell whether it is on the bus, so "
                            "leaving it alone.", device)
                waiting.remove(device)
                continue
            address = physical_address(text)
            if address and not told:
                told = tell_the_toolkit_where_it_is(device, address, run)
            if state:
                LOG.info("%s: already on the bus; leaving it alone.", device)
                waiting.remove(device)
                continue
            # Nothing holds an address. Before this program claims one, do
            # what a reconnection does: repair the permissions and give the
            # device back to cecd, whose work this is. One time for each
            # adapter, and only from here. If the daemon had the device, an
            # earlier branch returned and changed nothing.
            if device not in nudged:
                nudged.add(device)
                if nudge_the_daemon(device, restarted, run, writable):
                    done += 1           # something was put right
                    continue            # give it a moment, then read again
            if not address:
                continue                # no picture yet - come back to it
            waiting.remove(device)
            result = run([CEC_CTL, "-d", device, "--playback",
                          "--osd-name", REGISTERED_NAME])
            if result.returncode != 0:
                LOG.warning("%s: could not claim a logical address: %s",
                            device, (result.stdout or "").strip())
                continue
            done += 1
            LOG.info("%s: registered at %s as a playback device.",
                     device, address)
        if waiting and now() >= deadline:
            for device in waiting:
                LOG.warning("%s: no picture after %gs, so there is nothing "
                            "to register against.", device, wait)
            break
        if waiting:
            sleep(POLL_SECONDS)

    if not done and not told:
        # done counts each repair, and the second attempt of the daemon is
        # one of them. To report "nothing needed registering" after a restart
        # of a service is a log that contradicts its own actions.
        #
        # This is not a failure. An adapter that another program holds is the
        # good result. A non-zero exit for it would mark the session as failed
        # for a correct action.
        LOG.info("Nothing needed registering.")
    return 0


def configured_wait() -> float:
    """Returns the budget from the configuration, or the built-in budget.

    A wrong value is not an error here. A spelling mistake in a configuration
    file must not stop the registration of the adapter, because each other
    part of CEC depends on that registration.
    """
    try:
        return float(CONFIG.get("CEC_REGISTER_WAIT_SECONDS",
                                DEFAULT_WAIT_SECONDS))
    except (TypeError, ValueError):
        LOG.warning("CEC_REGISTER_WAIT_SECONDS is not a number; using %gs",
                    DEFAULT_WAIT_SECONDS)
        return DEFAULT_WAIT_SECONDS


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Put the CEC adapter on the bus.")
    parser.add_argument(
        "--wait", type=float, default=configured_wait(), metavar="SECONDS",
        help="how long to wait for the adapter and its picture, in total")
    return register(parser.parse_args().wait)


if __name__ == "__main__":
    raise SystemExit(main())
