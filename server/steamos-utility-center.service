[Unit]
Description=SteamOS Utility Center: LED bar bridge to an ESP over USB serial
Documentation=https://github.com/caed1994/SteamOS-Utility-Center
After=multi-user.target

[Service]
Type=simple
# Holds the notification FIFO; systemd creates and cleans it up.
RuntimeDirectory=steamos-utility-center
RuntimeDirectoryMode=0755
ExecStart=@INSTALL_DIR@/steamos-utility-center
Restart=always
RestartSec=3
# Exit 2 is a configuration the service will not accept, and no amount of
# restarting rewrites a file. Left to retry it fills the journal every three
# seconds and buries the one line that says which option is wrong - so stop,
# and let "systemctl status" show the reason. See CONFIG_REFUSED_EXIT.
RestartPreventExitStatus=2
# The strip is blanked on SIGTERM before the process exits.
KillSignal=SIGTERM
TimeoutStopSec=10

# The bridge only talks to two character devices: no network, no home, no
# writable filesystem of its own.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
