[Unit]
Description=SteamOS LED bar bridge to an ESP over USB serial
Documentation=https://github.com/caed1994/SteamOS-Led-Bar
After=multi-user.target

[Service]
Type=simple
# Holds the notification FIFO; systemd creates and cleans it up.
RuntimeDirectory=steamos-led-serial
RuntimeDirectoryMode=0755
ExecStart=@INSTALL_DIR@/steamos-led-serial
Restart=always
RestartSec=3
# The strip is blanked on SIGTERM before the process exits.
KillSignal=SIGTERM
TimeoutStopSec=10

# The bridge only talks to two character devices: no network, no home, no
# writable filesystem of its own.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
